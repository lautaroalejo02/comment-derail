+export function toMinor(amount: number, currency: CurrencyCode): number {
+  return Math.round(amount * 10 ** CURRENCIES[currency].minorUnits);
+}
+
+export function fromMinor(minor: number, currency: CurrencyCode): number {
+  return minor / 10 ** CURRENCIES[currency].minorUnits;
+}
+
+export function applyRate(minor: number, rate: number): number {
+  const basisPoints = Math.round(rate * 10000);
+  const scaled = minor * basisPoints;
+  const sign = scaled < 0 ? -1 : 1;
+  return sign * Math.floor((Math.abs(scaled) + 5000) / 10000);
+}
