diff --git a/tests/test_service.py b/tests/test_service.py
index 2b2f3c2..5d6ef22 100644
--- a/tests/test_service.py
+++ b/tests/test_service.py
@@ -125,3 +125,82 @@ def test_total_paid_is_cached(svc):
     q = svc.db.queries
     svc.get_total_paid("acme", "c-1")
     assert svc.db.queries == q
+
+
+class FakeClock:
+    def __init__(self):
+        self.now = 1_000.0
+
+    def __call__(self):
+        return self.now
+
+
+@pytest.fixture
+def clock():
+    return FakeClock()
+
+
+@pytest.fixture
+def ttl_svc(clock):
+    db = FakeDB()
+    s = BillingService(db, ttl_seconds=60, clock=clock)
+    s.upsert_customer("acme", {"id": "c-1", "name": "Acme Buyer"})
+    s.create_invoice("acme", "inv-1", "c-1", "2024-05", 10_000)
+    return s
+
+
+def test_default_ttl_is_300_seconds():
+    assert BillingService(FakeDB()).ttl_seconds == 300
+
+
+def test_negative_ttl_rejected():
+    with pytest.raises(ValueError):
+        BillingService(FakeDB(), ttl_seconds=-1)
+
+
+def test_cached_read_served_within_ttl(ttl_svc, clock):
+    ttl_svc.get_customer("acme", "c-1")
+    q = ttl_svc.db.queries
+    clock.now += 59.9
+    ttl_svc.get_customer("acme", "c-1")
+    assert ttl_svc.db.queries == q
+
+
+def test_cached_read_expires_after_ttl(ttl_svc, clock):
+    # BILL-2324: back-office edits bypass the service; the TTL bounds staleness.
+    assert ttl_svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    ttl_svc.db.upsert_customer("acme", {"id": "c-1", "name": "Renamed"})
+    clock.now += 30
+    assert ttl_svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    clock.now += 30
+    q = ttl_svc.db.queries
+    assert ttl_svc.get_customer("acme", "c-1")["name"] == "Renamed"
+    assert ttl_svc.db.queries == q + 1
+
+
+def test_expired_read_is_recached_with_fresh_ttl(ttl_svc, clock):
+    ttl_svc.get_total_paid("acme", "c-1")
+    clock.now += 61
+    ttl_svc.get_total_paid("acme", "c-1")  # reload, restarts the TTL
+    q = ttl_svc.db.queries
+    clock.now += 59
+    ttl_svc.get_total_paid("acme", "c-1")
+    assert ttl_svc.db.queries == q
+    clock.now += 1
+    ttl_svc.get_total_paid("acme", "c-1")
+    assert ttl_svc.db.queries == q + 1
+
+
+def test_summary_picks_up_direct_db_edit_after_ttl(ttl_svc, clock):
+    assert ttl_svc.get_invoice_summary("acme", "2024-05")["paid_cents"] == 0
+    ttl_svc.db.set_invoice_status("acme", "inv-1", "paid")
+    clock.now += 60
+    assert ttl_svc.get_invoice_summary("acme", "2024-05")["paid_cents"] == 10_000
+
+
+def test_zero_ttl_disables_caching(clock):
+    s = BillingService(FakeDB(), ttl_seconds=0, clock=clock)
+    s.get_customer("acme", "c-1")
+    q = s.db.queries
+    s.get_customer("acme", "c-1")
+    assert s.db.queries == q + 1
