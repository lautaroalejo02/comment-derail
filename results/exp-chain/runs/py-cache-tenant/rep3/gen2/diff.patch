+    def get_total_paid(self, tenant_id, customer_id):
+        def load():
+            rows = self.db.fetch_invoices(tenant_id, customer_id=customer_id, status="paid")
+            return sum(r["amount_cents"] for r in rows)
+
+        return self._read(tenant_id, "get_total_paid", customer_id, load)
