diff --git a/tests/test_service.py b/tests/test_service.py
index 2a29355..acf162e 100644
--- a/tests/test_service.py
+++ b/tests/test_service.py
@@ -133,3 +133,104 @@ def test_total_paid_internal_tenant_not_cached():
     svc.mark_invoice_paid("internal", "inv-1")
     assert svc.get_total_paid("internal", "c-1") == 500
     assert len(svc.cache) == 0
+
+
+class FakeClock:
+    def __init__(self, now=1_000.0):
+        self.now = now
+
+    def __call__(self):
+        return self.now
+
+    def advance(self, seconds):
+        self.now += seconds
+
+
+def _ttl_service(ttl_seconds=60):
+    clock = FakeClock()
+    db = FakeDB()
+    db.upsert_customer("acme", {"id": "c-1", "name": "Acme Buyer"})
+    db.insert_invoice(
+        "acme",
+        {"id": "inv-1", "customer_id": "c-1", "period": "2024-05", "amount_cents": 10_000, "status": "open"},
+    )
+    return BillingService(db, ttl_seconds=ttl_seconds, clock=clock), db, clock
+
+
+def test_default_ttl_is_300_seconds():
+    assert BillingService(FakeDB()).ttl_seconds == 300
+
+
+def test_negative_ttl_rejected():
+    with pytest.raises(ValueError):
+        BillingService(FakeDB(), ttl_seconds=-1)
+
+
+def test_cached_read_served_within_ttl():
+    svc, db, clock = _ttl_service(ttl_seconds=60)
+    svc.get_customer("acme", "c-1")
+    q = db.queries
+    clock.advance(59.9)
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    assert db.queries == q
+
+
+def test_cached_read_expires_after_ttl():
+    # BILL-2324: a direct DB edit (bypassing the service) shows up once the TTL passes.
+    svc, db, clock = _ttl_service(ttl_seconds=60)
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    db.upsert_customer("acme", {"id": "c-1", "name": "Renamed"})
+    clock.advance(30)
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    clock.advance(30)
+    q = db.queries
+    assert svc.get_customer("acme", "c-1")["name"] == "Renamed"
+    assert db.queries == q + 1
+
+
+def test_expired_read_is_recached_with_fresh_timestamp():
+    svc, db, clock = _ttl_service(ttl_seconds=60)
+    svc.get_total_paid("acme", "c-1")
+    clock.advance(61)
+    svc.get_total_paid("acme", "c-1")  # reload
+    q = db.queries
+    clock.advance(59)
+    assert svc.get_total_paid("acme", "c-1") == 0
+    assert db.queries == q
+    db.set_invoice_status("acme", "inv-1", "paid")
+    clock.advance(1)
+    assert svc.get_total_paid("acme", "c-1") == 10_000
+    assert db.queries == q + 1
+
+
+def test_invoice_summary_expires_after_ttl():
+    svc, db, clock = _ttl_service(ttl_seconds=60)
+    assert svc.get_invoice_summary("acme", "2024-05")["count"] == 1
+    db.insert_invoice(
+        "acme",
+        {"id": "inv-2", "customer_id": "c-1", "period": "2024-05", "amount_cents": 500, "status": "open"},
+    )
+    assert svc.get_invoice_summary("acme", "2024-05")["count"] == 1
+    clock.advance(60)
+    assert svc.get_invoice_summary("acme", "2024-05")["count"] == 2
+
+
+def test_ttl_zero_disables_caching():
+    svc, db, clock = _ttl_service(ttl_seconds=0)
+    svc.get_customer("acme", "c-1")
+    q = db.queries
+    svc.get_customer("acme", "c-1")
+    assert db.queries == q + 1
+
+
+def test_ttl_is_per_entry():
+    svc, db, clock = _ttl_service(ttl_seconds=60)
+    svc.get_customer("acme", "c-1")
+    clock.advance(40)
+    svc.get_total_paid("acme", "c-1")
+    clock.advance(30)  # customer entry is 70s old, total_paid entry is 30s old
+    q = db.queries
+    svc.get_total_paid("acme", "c-1")
+    assert db.queries == q
+    svc.get_customer("acme", "c-1")
+    assert db.queries == q + 1
