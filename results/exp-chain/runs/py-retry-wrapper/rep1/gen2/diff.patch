+
+def test_get_report_encodes_id(api, client):
+    # Exercise both edge nodes; an unencoded "/" or space would hit the wrong route or a 400.
+    for _ in api.NODES:
+        with pytest.raises(ApiError) as excinfo:
+            client.get_report("r-1/../x y")
+        assert excinfo.value.status == 404
+    assert api.requests[-1].url == "https://api.test/v2/reports/r-1%2F..%2Fx%20y"
+
