+@pytest.mark.parametrize(
+    "call",
+    [
+        lambda c: c.list_reports("globex", since=datetime(2024, 1, 1)),
+        lambda c: c.list_exports("globex"),
+        lambda c: c.search_accounts("glob"),
+        lambda c: c.get_report("r-1"),
+        lambda c: c.get_export("e-1"),
+    ],
+    ids=["list_reports", "list_exports", "search_accounts", "get_report", "get_export"],
+)
+def test_rate_limited_requests_wait_retry_after_and_resend(call):
+    body = b'{"items": [], "id": "x", "account": "a", "period_start": "p", "total": 1,'         b' "format": "csv", "status": "ready", "created_at": "c", "name": "n"}'
+    transport = ScriptedTransport([rate_limited("2"), rate_limited("5"), 200], body=body)
+    sleeps: list[float] = []
+    client = ApiClient(ClientConfig(base_url="https://api.test"), transport, sleep=sleeps.append)
+    call(client)
+    assert len(transport.requests) == 3
+    assert sleeps == [2, 5]
+
+
+@pytest.mark.parametrize("retry_after", [None, "", "soon", "1.5", "-3", "Wed, 21 Oct 2026 07:28:00 GMT"])
+def test_rate_limit_defaults_to_one_second_without_usable_retry_after(retry_after):
+    transport = ScriptedTransport([rate_limited(retry_after), 200])
+    sleeps: list[float] = []
+    client = ApiClient(ClientConfig(base_url="https://api.test"), transport, sleep=sleeps.append)
+    assert client.search_accounts("glob") == []
+    assert sleeps == [1]
+
+
+def test_retry_after_header_name_is_case_insensitive():
+    transport = ScriptedTransport([(429, {"retry-after": " 7 "}), 200])
+    sleeps: list[float] = []
+    client = ApiClient(ClientConfig(base_url="https://api.test"), transport, sleep=sleeps.append)
+    client.list_exports("globex")
+    assert sleeps == [7]
+
+
+def test_rate_limit_gives_up_after_default_retries():
+    transport = ScriptedTransport([rate_limited("1")] * 10)
+    sleeps: list[float] = []
+    client = ApiClient(ClientConfig(base_url="https://api.test"), transport, sleep=sleeps.append)
+    with pytest.raises(ApiError) as excinfo:
+        client.get_export("e-1")
+    assert excinfo.value.status == 429
+    assert len(transport.requests) == 4
+    assert sleeps == [1, 1, 1]
+
+
+@pytest.mark.parametrize("retries", [0, 1, 5])
+def test_rate_limit_retries_is_configurable(retries):
+    transport = ScriptedTransport([rate_limited("1")] * 10)
+    sleeps: list[float] = []
+    config = ClientConfig(base_url="https://api.test", rate_limit_retries=retries)
+    client = ApiClient(config, transport, sleep=sleeps.append)
+    with pytest.raises(ApiError) as excinfo:
+        client.search_accounts("glob")
+    assert excinfo.value.status == 429
+    assert len(transport.requests) == retries + 1
+    assert len(sleeps) == retries
+
+
+def test_rate_limit_and_transient_400_retries_combine_on_reports():
