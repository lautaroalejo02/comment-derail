 REPORTS_TZ = timezone(timedelta(hours=-5), "America/Bogota")
 
+# The API gateway answers 429 with a Retry-After header (whole seconds) when it rate-limits us
+RATE_LIMITED = 429
+DEFAULT_RETRY_AFTER_SECONDS = 1
+
 
 class ApiClient:
     def __init__(
@@ -88,8 +92,14 @@ class ApiClient:
         return response
 
     def _send(self, request: Request) -> Response:
-        # Send the request
-        return self._transport.send(request, timeout=self._config.timeout_seconds)
+        # Send the request, waiting out gateway rate limits
+        response = self._transport.send(request, timeout=self._config.timeout_seconds)
+        for _ in range(self._config.rate_limit_retries):
+            if response.status != RATE_LIMITED:
+                break
+            self._sleep(_retry_after_seconds(response))
+            response = self._transport.send(request, timeout=self._config.timeout_seconds)
+        return response
 
     def _headers(self) -> dict[str, str]:
         return {
@@ -109,6 +119,13 @@ class ApiClient:
         return f"{url}?{query}" if query else url
 
 
+def _retry_after_seconds(response: Response) -> int:
+    value = next(
+        (v for k, v in response.headers.items() if k.lower() == "retry-after"), ""
+    ).strip()
+    return int(value) if value.isascii() and value.isdigit() else DEFAULT_RETRY_AFTER_SECONDS
+
+
 def _reports_date(value: datetime) -> str:
