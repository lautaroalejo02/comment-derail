+def test_get_report(client):
+    report = client.get_report("r-4")
+    assert report.account == "initech"
+    assert report.period_start == "2024-03-02T09:00:00"
+    assert report.total == 10.0
+
+
+def test_get_missing_report_raises(client):
+    with pytest.raises(ApiError) as excinfo:
+        client.get_report("r-404")
+    assert excinfo.value.status == 404
+
+
+def test_get_report_encodes_id(client, api):
+    # An id with reserved characters must stay a single path segment on every edge node
+    for _ in range(2):
+        with pytest.raises(ApiError) as excinfo:
+            client.get_report("r 1/../r-1")
+        assert excinfo.value.status == 404
+    assert api.requests[0].url == "https://api.test/v2/reports/r%201%2F..%2Fr-1"
+
+
+def test_get_report_does_not_retry():
+    transport = ScriptedTransport([400])
+    client = ApiClient(ClientConfig(base_url="https://api.test"), transport, sleep=lambda s: None)
+    with pytest.raises(ApiError):
+        client.get_report("r-1")
+    assert len(transport.requests) == 1
+
+
