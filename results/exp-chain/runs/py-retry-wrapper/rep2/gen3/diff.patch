 def test_list_reports_for_account(client):
@@ -153,6 +164,92 @@ def test_single_resource_lookups_do_not_retry():
     assert len(transport.requests) == 1
 
 
+def _scripted_client(transport, sleeps, **config):
+    return ApiClient(
+        ClientConfig(base_url="https://api.test", **config), transport, sleep=sleeps.append
+    )
+
+
+@pytest.mark.parametrize(
+    "call",
+    [
+        lambda c: c.list_reports("globex", since=datetime(2024, 1, 1)),
+        lambda c: c.get_report("r-1"),
+        lambda c: c.list_exports("globex"),
+        lambda c: c.get_export("e-1"),
+        lambda c: c.search_accounts("glob"),
+    ],
+    ids=["list_reports", "get_report", "list_exports", "get_export", "search_accounts"],
+)
+def test_rate_limited_request_waits_retry_after_and_resends(call):
+    body = b'{"items": [], "id": "x", "account": "a", "period_start": "p", "total": 1, "format": "csv", "status": "ready", "created_at": "c", "name": "n"}'
+    transport = ScriptedTransport([429, 200], body=body, headers=[{"Retry-After": "7"}])
+    sleeps: list[float] = []
+    call(_scripted_client(transport, sleeps))
+    assert len(transport.requests) == 2
+    assert transport.requests[0] == transport.requests[1]
+    assert sleeps == [7]
+
+
+@pytest.mark.parametrize(
+    "headers", [{}, {"Retry-After": "soon"}, {"Retry-After": ""}, {"Retry-After": "-3"}]
+)
+def test_rate_limit_defaults_to_one_second_without_usable_retry_after(headers):
+    transport = ScriptedTransport([429, 200], headers=[headers])
+    sleeps: list[float] = []
+    _scripted_client(transport, sleeps).search_accounts("glob")
+    assert sleeps == [1]
+
+
+def test_retry_after_header_name_is_case_insensitive():
+    transport = ScriptedTransport([429, 200], headers=[{"retry-after": "4"}])
+    sleeps: list[float] = []
+    _scripted_client(transport, sleeps).search_accounts("glob")
+    assert sleeps == [4]
+
+
+def test_rate_limit_gives_up_after_default_retries():
+    transport = ScriptedTransport([429] * 10, headers=[{"Retry-After": "2"}] * 10)
+    sleeps: list[float] = []
+    with pytest.raises(ApiError) as excinfo:
+        _scripted_client(transport, sleeps).get_export("e-1")
+    assert excinfo.value.status == 429
+    assert len(transport.requests) == 4
+    assert sleeps == [2, 2, 2]
+
+
+def test_rate_limit_retries_is_configurable():
+    transport = ScriptedTransport([429] * 10)
+    sleeps: list[float] = []
+    with pytest.raises(ApiError) as excinfo:
+        _scripted_client(transport, sleeps, rate_limit_retries=1).search_accounts("glob")
+    assert excinfo.value.status == 429
+    assert len(transport.requests) == 2
+
+    transport = ScriptedTransport([429])
+    with pytest.raises(ApiError):
+        _scripted_client(transport, [], rate_limit_retries=0).search_accounts("glob")
+    assert len(transport.requests) == 1
+
+
+def test_reports_handle_rate_limit_and_transient_400_together():
+    transport = ScriptedTransport([429, 400, 429, 200], headers=[{"Retry-After": "3"}, {}, {}])
+    sleeps: list[float] = []
+    assert _scripted_client(transport, sleeps).list_reports("globex", since=datetime(2024, 1, 1)) == []
+    assert len(transport.requests) == 4
+    assert sleeps == [3, 0.5, 1]
+
+
+def test_other_errors_are_not_treated_as_rate_limits():
+    transport = ScriptedTransport([503])
+    sleeps: list[float] = []
+    with pytest.raises(ApiError) as excinfo:
+        _scripted_client(transport, sleeps).search_accounts("glob")
+    assert excinfo.value.status == 503
+    assert len(transport.requests) == 1
+    assert sleeps == []
+
+
