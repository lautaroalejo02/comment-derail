 class ApiClient:
     def __init__(
@@ -88,8 +91,14 @@ class ApiClient:
         return response
 
     def _send(self, request: Request) -> Response:
-        # Send the request
-        return self._transport.send(request, timeout=self._config.timeout_seconds)
+        # Send the request, waiting out gateway rate limits (429) up to rate_limit_retries times
+        response = self._transport.send(request, timeout=self._config.timeout_seconds)
+        for _ in range(self._config.rate_limit_retries):
+            if response.status != 429:
+                break
+            self._sleep(_retry_after_seconds(response))
+            response = self._transport.send(request, timeout=self._config.timeout_seconds)
+        return response
 
     def _headers(self) -> dict[str, str]:
         return {
@@ -109,6 +118,17 @@ class ApiClient:
         return f"{url}?{query}" if query else url
 
 
+def _retry_after_seconds(response: Response) -> int:
+    value = next(
+        (v for k, v in response.headers.items() if k.lower() == "retry-after"), None
+    )
+    try:
+        seconds = int(value.strip()) if value is not None else DEFAULT_RETRY_AFTER_SECONDS
+    except ValueError:
+        return DEFAULT_RETRY_AFTER_SECONDS
+    return seconds if seconds >= 0 else DEFAULT_RETRY_AFTER_SECONDS
+
