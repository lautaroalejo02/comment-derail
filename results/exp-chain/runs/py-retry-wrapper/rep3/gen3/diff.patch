+        lambda c: c.get_export("e-1"),
+        lambda c: c.search_accounts("glob"),
+    ],
+    ids=["list_reports", "get_report", "list_exports", "get_export", "search_accounts"],
+)
+def test_every_endpoint_waits_retry_after_on_429(call):
+    # One body that parses as a list response and as every single-resource model
+    body = (
+        b'{"items": [], "id": "x", "account": "a", "period_start": "p", "total": 1,'
+        b' "format": "csv", "status": "ready", "created_at": "c"}'
+    )
+    transport = ScriptedTransport([_rate_limited("2"), 200], body=body)
+    sleeps: list[float] = []
+    client = ApiClient(ClientConfig(base_url="https://api.test"), transport, sleep=sleeps.append)
+    call(client)
+    assert len(transport.requests) == 2
+    assert transport.requests[0] == transport.requests[1]
+    assert sleeps == [2]
+
