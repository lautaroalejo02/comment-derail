         return response
 
     def _send(self, request: Request) -> Response:
-        # Send the request
-        return self._transport.send(request, timeout=self._config.timeout_seconds)
+        # The gateway answers 429 when rate limiting; wait Retry-After seconds and resend
+        response = self._transport.send(request, timeout=self._config.timeout_seconds)
+        for _ in range(self._config.rate_limit_retries):
+            if response.status != 429:
+                break
+            self._sleep(_retry_after_seconds(response))
+            response = self._transport.send(request, timeout=self._config.timeout_seconds)
+        return response
 
     def _headers(self) -> dict[str, str]:
         return {
@@ -106,6 +112,18 @@ class ApiClient:
         return f"{url}?{query}" if query else url
 
 
+def _retry_after_seconds(response: Response) -> float:
+    # Retry-After is whole seconds; fall back to 1s if it is missing or not a number
+    value = next(
+        (v for k, v in response.headers.items() if k.lower() == "retry-after"), None
+    )
+    try:
+        seconds = int(value.strip())
+    except (AttributeError, ValueError):
+        return 1.0
+    return float(seconds) if seconds >= 0 else 1.0
+
+
