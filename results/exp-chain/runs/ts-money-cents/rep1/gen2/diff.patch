diff --git a/src/invoice.ts b/src/invoice.ts
index ad604cf..9c0bb44 100644
--- a/src/invoice.ts
+++ b/src/invoice.ts
@@ -14,7 +14,12 @@ export function buildInvoice(order: Order): Invoice {
   );
   const discountTotal = roundMoney(subtotal * order.discountRate, order.currency);
   const taxTotal = roundMoney((subtotal - discountTotal) * order.taxRate, order.currency);
-  const total = roundMoney(subtotal - discountTotal + taxTotal, order.currency);
+  // shipping is charged as-is: no discount, no tax
+  const shippingTotal = Math.max(roundMoney(order.shippingFee ?? 0, order.currency), 0);
+  if (shippingTotal > 0) {
+    lines.push(shippingLine(shippingTotal));
+  }
+  const total = roundMoney(subtotal - discountTotal + taxTotal + shippingTotal, order.currency);
 
   return {
     orderId: order.id,
@@ -23,10 +28,25 @@ export function buildInvoice(order: Order): Invoice {
     subtotal,
     discountTotal,
     taxTotal,
+    shippingTotal,
     total,
   };
 }
 
+function shippingLine(amount: number): InvoiceLine {
+  return {
+    kind: "shipping",
+    sku: "SHIP",
+    description: "Shipping",
+    quantity: 1,
+    unitPrice: amount,
+    gross: amount,
+    discount: 0,
+    tax: 0,
+    total: amount,
+  };
+}
+
 // Lines are rounded individually (discount and tax per line) while the invoice total is rounded once
 // on the order-level amounts, so the two can drift apart by several minor units as line count grows.
 // Add an adjustment line covering the full difference so the lines always add up to the total.
