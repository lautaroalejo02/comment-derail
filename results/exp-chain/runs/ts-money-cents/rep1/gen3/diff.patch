+test("item-level discountRate overrides the order rate for that item only", () => {
+  const order: Order = {
+    id: "ORD-4001",
+    currency: "USD",
+    discountRate: 0.1,
+    taxRate: 0.05,
+    items: [
+      { sku: "A", description: "Item A", quantity: 1, unitPrice: 20 },
+      { sku: "B", description: "Item B", quantity: 1, unitPrice: 20, discountRate: 0.5 },
+    ],
+  };
+  const invoice = buildInvoice(order);
+  assert.equal(invoice.subtotal, 40);
+  assert.equal(invoice.discountTotal, 12);
+  assert.equal(invoice.taxTotal, 1.4);
+  assert.equal(invoice.total, 29.4);
+  assert.deepEqual(
+    invoice.lines.map((line) => [line.sku, line.discount, line.tax, line.total]),
+    [
+      ["A", 2, 0.9, 18.9],
+      ["B", 10, 0.5, 10.5],
+    ],
+  );
+  assert.deepEqual(invoiceSummary(invoice).slice(-1), ["TOTAL\t\t$29.40"]);
+});
+
+test("an item-level discountRate of 0 exempts the item from the order discount", () => {
+  const invoice = buildInvoice({
+    id: "ORD-4002",
+    currency: "USD",
+    discountRate: 0.25,
+    taxRate: 0,
+    items: [
+      { sku: "A", description: "Item A", quantity: 2, unitPrice: 10 },
+      { sku: "B", description: "Item B", quantity: 1, unitPrice: 30, discountRate: 0 },
+    ],
+  });
+  assert.equal(invoice.discountTotal, 5);
+  assert.equal(invoice.total, 45);
+  assert.deepEqual(
+    invoice.lines.map((line) => line.discount),
+    [5, 0],
+  );
+});
+
