+        { sku: "HOOD-3", description: "Hoodie", quantity: 1, unitPrice: 29.99 },
+        { sku: "BOOT-4", description: "Boots", quantity: 2, unitPrice: 49.99, discountRate: 0.2 },
+      ],
+    },
+    {
+      id: "ORD-4004",
+      currency: "JPY",
+      discountRate: 0.1,
+      taxRate: 0.1,
+      items: [
+        { sku: "CUP-1", description: "Cup", quantity: 3, unitPrice: 999, discountRate: 0.35 },
+        { sku: "BOWL-2", description: "Bowl", quantity: 1, unitPrice: 2999 },
+      ],
+    },
+  ];
+  for (const order of orders) {
