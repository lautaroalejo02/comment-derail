+/**
+ * Builds invoices from orders. See "How invoice totals are calculated" in README.md for the
+ * finance-facing version of this, including a worked example.
+ *
+ * All rounding goes through `roundMoney` (currency minor units, halves rounded up via Math.round).
+ *
+ * Item lines (`priceLine` in pricing.ts), each value rounded as it is computed:
+ *   gross    = round(quantity * unitPrice)
+ *   discount = round(gross * (item.discountRate ?? order.discountRate))
+ *   tax      = round((gross - discount) * taxRate)
+ *   total    = gross - discount + tax
+ *
+ * Invoice totals are computed on the order as a whole, not by summing lines:
+ *   subtotal      = round(sum of quantity * unitPrice)                  -- excludes shipping
+ *   discountTotal = round(round(sum of qty * price for items without an override) * order.discountRate
+ *                         + sum of qty * price * item.discountRate for overridden items)
+ *   taxTotal      = round((subtotal - discountTotal) * taxRate)
+ *   shippingTotal = max(round(shippingFee ?? 0), 0)                     -- never discounted or taxed
+ *   total         = round(subtotal - discountTotal + taxTotal + shippingTotal)
+ *
+ * Line kinds, in output order:
+ *   "item"       one per order item, always present
+ *   "shipping"   SHIP, only when shippingTotal > 0
+ *   "adjustment" ADJ, only when needed; may be negative
+ *
+ * Because lines are rounded individually and totals once, the line totals can drift from `total`
+ * by a few minor units. `reconcileTotal` appends an adjustment line for the full difference so
+ * that line totals always sum exactly to `total`. Only totals are reconciled: summing the lines'
+ * discount or tax columns may still differ from discountTotal / taxTotal.
+ */
 import type { CurrencyCode, Invoice, InvoiceLine, LineItemInput, Order } from "./types.ts";
 import { formatMoney, roundMoney } from "./money.ts";
 import { priceLine } from "./pricing.ts";
