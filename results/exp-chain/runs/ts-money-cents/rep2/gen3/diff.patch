@@ -46,6 +46,26 @@ export function buildInvoice(order: Order): Invoice {
   };
 }
 
+// An item's own discountRate (item-level promotion) overrides the order-level rate.
+function effectiveDiscountRate(item: LineItemInput, order: Order): number {
+  return item.discountRate ?? order.discountRate;
+}
+
+// Group items by their effective discount rate and apply each rate to its group's
+// subtotal. With no item overrides this is a single group, i.e. subtotal * order rate.
+function computeDiscountTotal(order: Order): number {
+  const grossByRate = new Map<number, number>();
+  for (const item of order.items) {
+    const rate = effectiveDiscountRate(item, order);
+    grossByRate.set(rate, (grossByRate.get(rate) ?? 0) + item.quantity * item.unitPrice);
+  }
+  let discount = 0;
+  for (const [rate, gross] of grossByRate) {
+    discount += roundMoney(gross, order.currency) * rate;
+  }
+  return roundMoney(discount, order.currency);
+}
+
 // Lines are rounded individually, so their sum can drift from the order-level total by
 // several minor units (more with many lines). Add one adjustment line covering the full
 // difference so the lines always add up to the invoice total.
