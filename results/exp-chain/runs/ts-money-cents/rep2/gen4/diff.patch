+/**
+ * Builds invoices from orders. See README.md ("How invoice totals are calculated") for
+ * the finance-facing version with a worked example.
+ *
+ * Rounding: roundMoney() rounds to the currency's minor units (cents; whole yen for JPY)
+ * with Math.round, i.e. halves toward +Infinity, subject to binary floating-point
+ * representation (e.g. 1.005 rounds to 1.00).
+ *
+ * Effective discount rate per item: item.discountRate ?? order.discountRate (replaces,
+ * never stacks).
+ *
+ * Item lines (priceLine in pricing.ts), each field rounded:
+ *   gross    = qty * unitPrice
+ *   discount = gross * effectiveRate
+ *   tax      = (gross - discount) * taxRate
+ *   total    = (gross - discount) + tax
+ *
+ * Invoice totals are computed order-wide, NOT by summing lines:
+ *   subtotal      = round(sum of qty * unitPrice)   (shipping excluded)
+ *   discountTotal = round(sum over rate groups of round(group gross) * rate)
+ *   taxTotal      = round((subtotal - discountTotal) * taxRate)
+ *   shippingTotal = round(shippingFee) if > 0, else 0 (never discounted or taxed)
+ *   total         = round(subtotal - discountTotal + taxTotal + shippingTotal)
+ *
+ * Line kinds, in this order:
+ *   "item"       one per order item
+ *   "shipping"   SKU "SHIP", only when shippingTotal > 0; discount = tax = 0
+ *   "adjustment" SKU "ADJ", only when the line totals don't sum to `total`; one line for
+ *                the full (possibly multi-unit, possibly negative) difference; discount = tax = 0
+ *
+ * Invariant: sum of line.total === invoice.total. Only the total column is reconciled.
+ * Summed line discount/tax columns may differ from discountTotal/taxTotal by rounding.
+ */
 import type { CurrencyCode, Invoice, InvoiceLine, LineItemInput, Order } from "./types.ts";
 import { formatMoney, roundMoney } from "./money.ts";
 import { priceLine } from "./pricing.ts";
