+// Shipping is charged as-is: no discount and no tax.
+function shippingLine(amount: number): InvoiceLine {
+  return {
+    kind: "shipping",
+    sku: "SHIP",
+    description: "Shipping",
+    quantity: 1,
+    unitPrice: amount,
+    gross: amount,
+    discount: 0,
+    tax: 0,
+    total: amount,
+  };
+}
