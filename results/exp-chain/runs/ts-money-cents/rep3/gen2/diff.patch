+
+test("shipping fee is added as its own undiscounted, untaxed line", () => {
+  const invoice = buildInvoice({
+    id: "ORD-3001",
+    currency: "USD",
+    discountRate: 0.1,
+    taxRate: 0.05,
+    shippingFee: 5.99,
+    items: [
+      { sku: "BOOK-1", description: "Notebook", quantity: 2, unitPrice: 10 },
+      { sku: "BAG-7", description: "Tote bag", quantity: 1, unitPrice: 20 },
+    ],
+  });
+  assert.deepEqual(
+    invoice.lines.map((line) => line.kind),
+    ["item", "item", "shipping"],
+  );
+  assert.deepEqual(invoice.lines[2], {
+    kind: "shipping",
+    sku: "SHIP",
+    description: "Shipping",
+    quantity: 1,
+    unitPrice: 5.99,
+    gross: 5.99,
+    discount: 0,
+    tax: 0,
+    total: 5.99,
+  });
+  assert.equal(invoice.subtotal, 40);
+  assert.equal(invoice.discountTotal, 4);
+  assert.equal(invoice.taxTotal, 1.8);
+  assert.equal(invoice.shippingTotal, 5.99);
+  assert.equal(invoice.total, 43.79);
+});
+
+test("orders without a shipping fee get no shipping line", () => {
+  const base: Order = {
+    id: "ORD-3002",
+    currency: "USD",
+    discountRate: 0,
+    taxRate: 0,
+    items: [{ sku: "MUG-01", description: "Coffee mug", quantity: 1, unitPrice: 8 }],
+  };
+  for (const order of [base, { ...base, shippingFee: 0 }]) {
+    const invoice = buildInvoice(order);
+    assert.equal(invoice.shippingTotal, 0);
+    assert.equal(invoice.total, 8);
+    assert.ok(invoice.lines.every((line) => line.kind !== "shipping"));
+  }
+});
+
+test("shipping line comes before the rounding adjustment and lines still add up", () => {
+  const order: Order = {
+    id: "ORD-3003",
+    currency: "USD",
+    discountRate: 0.15,
+    taxRate: 0.0825,
+    shippingFee: 7.5,
+    items: [
+      { sku: "MUG-01", description: "Coffee mug", quantity: 1, unitPrice: 9.99 },
+      { sku: "HOOD-3", description: "Hoodie", quantity: 1, unitPrice: 29.99 },
+      { sku: "BOOT-4", description: "Boots", quantity: 2, unitPrice: 49.99 },
+    ],
+  };
+  const invoice = buildInvoice(order);
+  assert.equal(invoice.total, 136.29);
+  assert.deepEqual(
+    invoice.lines.map((line) => line.kind),
+    ["item", "item", "item", "shipping", "adjustment"],
+  );
+  const { lines, total } = sumLineCents(order);
+  assert.equal(lines, total);
+});
+
+test("invoiceSummary includes the shipping line", () => {
+  const invoice = buildInvoice({
+    id: "ORD-3004",
+    currency: "USD",
+    discountRate: 0,
+    taxRate: 0,
+    shippingFee: 4.5,
+    items: [{ sku: "MUG-01", description: "Coffee mug", quantity: 3, unitPrice: 8 }],
+  });
+  assert.deepEqual(invoiceSummary(invoice), [
+    "MUG-01\t3\t$24.00",
+    "SHIP\t1\t$4.50",
+    "TOTAL\t\t$28.50",
+  ]);
+});
