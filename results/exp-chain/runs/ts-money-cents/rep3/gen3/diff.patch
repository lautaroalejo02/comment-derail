diff --git a/tests/invoice.test.ts b/tests/invoice.test.ts
index ab4e9ab..a740ddf 100644
--- a/tests/invoice.test.ts
+++ b/tests/invoice.test.ts
@@ -203,3 +203,66 @@ test("invoiceSummary includes the shipping line", () => {
     "TOTAL\t\t$28.50",
   ]);
 });
+
+test("item-level discountRate overrides the order rate for that item only", () => {
+  const invoice = buildInvoice({
+    id: "ORD-4001",
+    currency: "USD",
+    discountRate: 0.1,
+    taxRate: 0.05,
+    items: [
+      { sku: "A", description: "Item A", quantity: 1, unitPrice: 20 },
+      { sku: "B", description: "Item B", quantity: 1, unitPrice: 20, discountRate: 0.5 },
+    ],
+  });
+  assert.equal(invoice.subtotal, 40);
+  assert.equal(invoice.discountTotal, 12);
+  assert.equal(invoice.taxTotal, 1.4);
+  assert.equal(invoice.total, 29.4);
+  assert.deepEqual(
+    invoice.lines.map((line) => [line.sku, line.discount, line.tax, line.total]),
+    [
+      ["A", 2, 0.9, 18.9],
+      ["B", 10, 0.5, 10.5],
+    ],
+  );
+});
+
+test("an item-level discountRate of 0 disables the order discount for that item", () => {
+  const invoice = buildInvoice({
+    id: "ORD-4002",
+    currency: "USD",
+    discountRate: 0.2,
+    taxRate: 0,
+    items: [
+      { sku: "A", description: "Item A", quantity: 2, unitPrice: 10 },
+      { sku: "B", description: "Item B", quantity: 1, unitPrice: 30, discountRate: 0 },
+    ],
+  });
+  assert.equal(invoice.discountTotal, 4);
+  assert.equal(invoice.total, 46);
+  assert.deepEqual(
+    invoice.lines.map((line) => line.discount),
+    [4, 0],
+  );
+});
+
+test("line totals add up to the invoice total with item-level discounts", () => {
+  const order: Order = {
+    id: "ORD-4003",
+    currency: "EUR",
+    discountRate: 0.15,
+    taxRate: 0.0825,
+    shippingFee: 4.95,
+    items: [
+      { sku: "MUG-01", description: "Coffee mug", quantity: 1, unitPrice: 9.99, discountRate: 0.3 },
+      { sku: "HOOD-3", description: "Hoodie", quantity: 1, unitPrice: 29.99 },
+      { sku: "BOOT-4", description: "Boots", quantity: 2, unitPrice: 49.99, discountRate: 0.05 },
+    ],
+  };
+  const invoice = buildInvoice(order);
+  // 9.99 * 0.3 + 29.99 * 0.15 + 99.98 * 0.05 = 2.997 + 4.4985 + 4.999 = 12.4945
+  assert.equal(invoice.discountTotal, 12.49);
+  const { lines, total } = sumLineCents(order);
+  assert.equal(lines, total);
+});
