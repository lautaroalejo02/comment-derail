   );
-  const discountTotal = roundMoney(subtotal * order.discountRate, order.currency);
+  // order rate on the whole subtotal, corrected for items that carry their own rate
+  const discountOverrides = order.items.reduce(
+    (sum, item) =>
+      item.discountRate === undefined
+        ? sum
+        : sum + item.quantity * item.unitPrice * (item.discountRate - order.discountRate),
+    0,
+  );
+  const discountTotal = roundMoney(
+    subtotal * order.discountRate + discountOverrides,
+    order.currency,
+  );
   const taxTotal = roundMoney((subtotal - discountTotal) * order.taxRate, order.currency);
   const shippingFee = roundMoney(order.shippingFee ?? 0, order.currency);
   const shippingTotal = shippingFee > 0 ? shippingFee : 0;
