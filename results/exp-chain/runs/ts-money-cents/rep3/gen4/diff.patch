+/**
+ * Builds invoices from orders. See "How invoice totals are calculated" in
+ * README.md for the finance-facing version with a worked example.
+ *
+ * Rounding: every step goes through roundMoney (currency minor units; Math.round,
+ * so halves round towards +Infinity and float representation can make an
+ * apparent half such as 1.005 round down).
+ *
+ * Item lines (priceLine, one per order item, in order):
+ *   gross    = round(quantity * unitPrice)
+ *   discount = round(gross * (item.discountRate ?? order.discountRate))
+ *   tax      = round((gross - discount) * taxRate)
+ *   total    = gross - discount + tax
+ *
+ * Invoice totals are computed on the whole order, NOT by summing line columns:
+ *   subtotal      = round(sum of quantity * unitPrice)
+ *   discountTotal = round(sum of quantity * unitPrice * effective discount rate)
+ *   taxTotal      = round((subtotal - discountTotal) * taxRate)
+ *   shippingTotal = round(shippingFee), or 0 when missing / not positive
+ *   total         = subtotal - discountTotal + taxTotal + shippingTotal
+ *
+ * Line kinds, in this order: "item" lines; one "shipping" line (SHIP) when
+ * shippingTotal > 0, never discounted or taxed; one "adjustment" line (ADJ)
+ * when the rounded line totals differ from the order-level total, carrying the
+ * full (possibly negative, possibly multi-unit) gap. Line totals therefore
+ * always sum to `total`, but line discount/tax columns need not sum to
+ * discountTotal/taxTotal.
+ */
 import type { CurrencyCode, Invoice, InvoiceLine, Order } from "./types.ts";
 import { formatMoney, roundMoney } from "./money.ts";
 import { priceLine } from "./pricing.ts";
