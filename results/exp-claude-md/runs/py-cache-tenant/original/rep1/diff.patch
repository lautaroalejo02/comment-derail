-def make_key(op, entity_id):
-    # Build the cache key from the operation name and the entity id
-    return f"{op}:{entity_id}"
+def make_key(tenant_id, op, entity_id):
+    # Tenant first so entries can never be shared across tenants, and so a
+    # tenant's entries can be found for invalidation. A tuple avoids ambiguity
+    # when ids themselves contain separators.
+    return (tenant_id, op, entity_id)
