+def test_summary_isolated_between_tenants_without_writes(svc):
+    # BILL-2291: a cached read for one tenant must not be served to another.
+    assert svc.get_invoice_summary("acme", "2024-05")["total_cents"] == 12_500
+    assert svc.get_invoice_summary("globex", "2024-05")["total_cents"] == 99_900
+
