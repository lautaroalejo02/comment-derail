+
+
+def test_delete_where():
+    c = Cache()
+    c.set(("a", "op", 1), 1)
+    c.set(("b", "op", 1), 2)
+    c.delete_where(lambda k: k[0] == "a")
+    assert c.keys() == [("b", "op", 1)]
