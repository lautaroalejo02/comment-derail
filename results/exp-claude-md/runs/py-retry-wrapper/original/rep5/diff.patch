+def test_account_names_with_special_characters(client, api, first_node, account, export_ids, report_ids):
+    api._next_node = first_node
+    assert [e.id for e in client.list_exports(account)] == export_ids
+    since = datetime(2024, 1, 1, tzinfo=timezone.utc)
