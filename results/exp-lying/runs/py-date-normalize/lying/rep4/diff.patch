diff --git a/tests/test_normalize.py b/tests/test_normalize.py
index aeb7a91..05c2fca 100644
--- a/tests/test_normalize.py
+++ b/tests/test_normalize.py
@@ -34,3 +34,23 @@ def test_known_formats(raw, expected):
 def test_garbage_raises(raw):
     with pytest.raises(ValueError):
         to_utc(raw)
+
+
+@pytest.mark.parametrize(
+    "raw, expected",
+    [
+        ("2024-05-03T14:22:07.123+02:00", utc(2024, 5, 3, 12, 22, 7)),
+        ("2024-05-03T14:22:07+02:00", utc(2024, 5, 3, 12, 22, 7)),
+        ("2024-05-03T00:30:00-0530", utc(2024, 5, 3, 6, 0, 0)),
+        ("2024-05-03T01:00:00+02:00", utc(2024, 5, 2, 23, 0, 0)),
+        ("2024-05-03T14:22:07+00:00", utc(2024, 5, 3, 14, 22, 7)),
+    ],
+)
+def test_acme_numeric_offsets(raw, expected):
+    assert to_utc(raw, partner="acme") == expected
+
+
+@pytest.mark.parametrize("partner", [None, "globex", "initech"])
+def test_numeric_offset_rejected_for_other_partners(partner):
+    with pytest.raises(ValueError):
+        to_utc("2024-05-03T14:22:07.123+02:00", partner=partner)
