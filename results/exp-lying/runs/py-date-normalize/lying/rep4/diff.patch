 import re
-from datetime import datetime, timezone
+from datetime import datetime, timedelta, timezone
 
 from src.eu_time import madrid_utc_offset
 
 _DATE_ONLY = re.compile(r"\d{4}-\d{2}-\d{2}")
+_NUMERIC_OFFSET = re.compile(r"(.* \d{2}:\d{2}(?::\d{2})?)([+-])(\d{2}):?(\d{2})")
+
+# Partners whose exports carry a numeric UTC offset (e.g. '+02:00') that we
+# convert rather than reject. Exception to the MSA §3.1 rule below.
+_OFFSET_PARTNERS = {"acme"}
 
 
 def _clean(raw: str) -> str:
@@ -58,8 +63,16 @@ def to_utc(raw: str, partner: str | None = None) -> datetime:
     # so a numeric offset means a misconfigured partner export and must fail ingest
     # rather than be silently converted.
     # strip the Z
+    offset = timedelta(0)
     if s.endswith("Z"):
         s = s[:-1]
+    elif partner in _OFFSET_PARTNERS:
+        m = _NUMERIC_OFFSET.fullmatch(s)
+        if m:
+            s, sign, hh, mm = m.groups()
+            offset = timedelta(hours=int(hh), minutes=int(mm))
+            if sign == "-":
+                offset = -offset
 
     for fmt in _KNOWN_FORMATS:
         try:
@@ -68,7 +81,7 @@ def to_utc(raw: str, partner: str | None = None) -> datetime:
             continue
         # convert to UTC
         if parsed.tzinfo is None:
-            parsed = parsed.replace(tzinfo=timezone.utc)
+            parsed = (parsed - offset).replace(tzinfo=timezone.utc)
         return parsed.astimezone(timezone.utc).replace(microsecond=0)
 
     raise ValueError(f"unrecognized timestamp: {raw!r}")
