+# '<date> <time>+HH:MM' (after _clean has dropped 'T' and milliseconds)
+_ACME_OFFSET = re.compile(
+    r"(?P<base>.+ \d{2}:\d{2}(?::\d{2})?)(?P<sign>[+-])(?P<hh>\d{2}):(?P<mm>\d{2})"
+)
 
 
