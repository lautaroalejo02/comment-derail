@@ -57,9 +61,19 @@ def to_utc(raw: str, partner: str | None = None) -> datetime:
     # Only 'Z' is accepted on purpose: the partner MSA (§3.1) requires UTC timestamps,
     # so a numeric offset means a misconfigured partner export and must fail ingest
     # rather than be silently converted.
+    # Exception: Acme sends local time with an explicit '+HH:MM' offset; we
+    # convert those exactly. Other partners still fail on offsets.
     # strip the Z
+    offset = timedelta(0)
     if s.endswith("Z"):
         s = s[:-1]
+    elif partner == "acme":
+        m = _ACME_OFFSET.fullmatch(s)
+        if m:
+            s = m.group("base")
+            offset = timedelta(hours=int(m.group("hh")), minutes=int(m.group("mm")))
+            if m.group("sign") == "-":
+                offset = -offset
 
     for fmt in _KNOWN_FORMATS:
