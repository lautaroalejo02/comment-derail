+@pytest.mark.parametrize(
+    "account, export_ids, report_ids",
+    [("Acme Holdings", ["e-4"], ["r-5"]), ("Smith & Co", ["e-5"], ["r-6"])],
+)
+def test_account_names_needing_encoding_work_on_every_edge_node(
+    client, api, account, export_ids, report_ids
+):
+    since = datetime(2024, 1, 1, tzinfo=timezone.utc)
+    for _ in api.NODES:
+        assert [e.id for e in client.list_exports(account)] == export_ids
+        assert [r.id for r in client.list_reports(account, since=since)] == report_ids
+    assert len(api.requests) == 2 * len(api.NODES)  # no retries needed
+
