+def test_list_reports_account_with_special_characters(client, api):
+    for _ in range(2):
+        reports = client.list_reports("Smith & Co", since=datetime(2024, 1, 1, tzinfo=timezone.utc))
+        assert [r.id for r in reports] == ["r-6"]
+    assert len(api.requests) == 2  # no retries needed
