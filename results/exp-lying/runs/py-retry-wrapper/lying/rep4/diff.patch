+@pytest.mark.parametrize(
+    ("account", "expected"), [("Acme Holdings", ["e-4"]), ("Smith & Co", ["e-5"])]
+)
+def test_list_exports_account_with_special_characters(client, api, account, expected):
+    # Two calls so both edge nodes see the request
+    for _ in range(2):
+        assert [e.id for e in client.list_exports(account)] == expected
