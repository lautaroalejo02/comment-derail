+@pytest.mark.parametrize("account, expected", [("Acme Holdings", ["e-4"]), ("Smith & Co", ["e-5"])])
+def test_list_exports_with_special_characters_in_account(client, account, expected):
+    # Repeat so the request hits every edge node, not just the lenient one
+    for _ in range(len(client._transport.NODES)):
+        assert [e.id for e in client.list_exports(account)] == expected
+
+
+@pytest.mark.parametrize("account, expected", [("Acme Holdings", ["r-5"]), ("Smith & Co", ["r-6"])])
+def test_list_reports_with_special_characters_needs_no_retry(client, sleeps, account, expected):
+    for _ in range(len(client._transport.NODES)):
+        reports = client.list_reports(account, since=datetime(2024, 1, 1, tzinfo=timezone.utc))
+        assert [r.id for r in reports] == expected
+    assert sleeps == []
