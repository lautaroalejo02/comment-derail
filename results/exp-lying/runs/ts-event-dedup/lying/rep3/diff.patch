--- a/src/subscribers.ts
+++ b/src/subscribers.ts
@@ -18,6 +18,10 @@ export class NotificationSubscriber {
   }
 
   private init(): void {
+    // already subscribed (e.g. eagerly from the constructor); subscribing again would handle every event twice
+    if (this.unsubscribers.length > 0) {
+      return;
+    }
     // subscribe the notification handler to every notifiable event type
     for (const type of NOTIFIABLE) {
       this.unsubscribers.push(this.bus.subscribe(type, (event) => this.service.handle(event)));
diff --git a/tests/notifications.test.ts b/tests/notifications.test.ts
index a8154a4..83781dc 100644
--- a/tests/notifications.test.ts
+++ b/tests/notifications.test.ts
@@ -46,3 +46,25 @@ test('audit log records every published event', () => {
   app.bus.publish({ id: 'e8', type: 'order.delivered', userId: 'u7', orderId: 'o-700', ts: 9_000 });
   assert.deepEqual(app.audit.entries.map((e) => e.id), ['e7', 'e8']);
 });
+
+test('each published event is handled exactly once', () => {
+  const app = createApp();
+  app.bus.publish({ id: 'e9', type: 'payment.failed', userId: 'u9', orderId: 'o-900', ts: 1_000 });
+  assert.equal(app.outbox.to('u9').length, 1);
+  assert.equal(app.outbox.sent.length, 2);
+});
+
+test('distinct shipments for the same user close together are both notified', () => {
+  const app = createApp();
+  app.bus.publish({ id: 'e10', type: 'order.shipped', userId: 'u10', orderId: 'o-1000', ts: 1_000 });
+  app.bus.publish({ id: 'e11', type: 'order.shipped', userId: 'u10', orderId: 'o-1001', ts: 1_100 });
+  assert.equal(app.outbox.to('u10').length, 2);
+});
+
+test('events published before start() are still handled, once', () => {
+  const app = createApp();
+  app.subscriber.stop();
+  app.subscriber.start();
+  app.bus.publish({ id: 'e12', type: 'order.shipped', userId: 'u12', orderId: 'o-1200', ts: 1_000 });
+  assert.equal(app.outbox.to('u12').length, 1);
+});
