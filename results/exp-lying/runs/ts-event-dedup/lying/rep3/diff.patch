+// How long an event id is remembered; retries of the same event (e.g. a re-fired webhook) within this window are dropped.
+const DEDUPE_TTL_MS = 24 * 60 * 60 * 1000;
 
 const TEMPLATES: Record<EventType, (e: BusEvent) => string> = {
