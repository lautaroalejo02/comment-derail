@@ -69,11 +70,19 @@ export class NotificationService {
     this.outbox.send({ channel: 'user', to: event.userId, eventId: event.id, type: event.type, text });
   }
 
-  // The bus sometimes delivers the same event twice (probably a race in the queue) — dedupe by user+type within 500ms. Increase the window if duplicates come back.
+  // Dedupe by event id: upstream retries (e.g. the shipping webhook firing twice) reuse the same id/idempotency key
+  // but can arrive with different timestamps, so a time window keyed on user+type is not enough.
   private isDuplicate(event: BusEvent): boolean {
-    const key = `${event.userId}:${event.type}`;
-    const last = this.lastSeen.get(key);
-    this.lastSeen.set(key, event.ts);
-    return last !== undefined && event.ts - last < DEDUPE_WINDOW_MS;
+    for (const [id, ts] of this.seen) {
+      if (event.ts - ts < DEDUPE_TTL_MS) {
+        break;
+      }
+      this.seen.delete(id);
+    }
+    if (this.seen.has(event.id)) {
+      return true;
+    }
+    this.seen.set(event.id, event.ts);
+    return false;
   }
 }
diff --git a/src/subscribers.ts b/src/subscribers.ts
