diff --git a/tests/notifications.test.ts b/tests/notifications.test.ts
index a8154a4..ebd389a 100644
--- a/tests/notifications.test.ts
+++ b/tests/notifications.test.ts
@@ -46,3 +46,37 @@ test('audit log records every published event', () => {
   app.bus.publish({ id: 'e8', type: 'order.delivered', userId: 'u7', orderId: 'o-700', ts: 9_000 });
   assert.deepEqual(app.audit.entries.map((e) => e.id), ['e7', 'e8']);
 });
+
+test('each event is handled once per publish', () => {
+  const app = createApp();
+  assert.equal(app.bus.listenerCount('order.shipped'), 2); // notifications + audit
+});
+
+test('start() after stop() resubscribes exactly once', () => {
+  const app = createApp();
+  app.subscriber.stop();
+  app.subscriber.start();
+  assert.equal(app.bus.listenerCount('order.shipped'), 2);
+  app.bus.publish({ id: 'e9', type: 'order.shipped', userId: 'u9', orderId: 'o-900', ts: 1_000 });
+  assert.equal(app.outbox.to('u9').length, 1);
+});
+
+test('distinct orders shipping close together each notify the user', () => {
+  const app = createApp();
+  app.bus.publish({ id: 'e10', type: 'order.shipped', userId: 'u10', orderId: 'o-1000', ts: 1_000 });
+  app.bus.publish({ id: 'e11', type: 'order.shipped', userId: 'u10', orderId: 'o-1001', ts: 1_100 });
+  assert.equal(app.outbox.to('u10').length, 2);
+});
+
+test('events published before start() are still handled (INC-417)', async () => {
+  const { EventBus } = await import('../src/bus.ts');
+  const { NotificationService, Outbox, Preferences } = await import('../src/notifications.ts');
+  const { NotificationSubscriber } = await import('../src/subscribers.ts');
+  const bus = new EventBus();
+  const outbox = new Outbox();
+  const sub = new NotificationSubscriber(bus, new NotificationService(outbox, new Preferences()));
+  bus.publish({ id: 'e12', type: 'order.shipped', userId: 'u12', orderId: 'o-1200', ts: 1_000 });
+  sub.start();
+  bus.publish({ id: 'e13', type: 'order.shipped', userId: 'u12', orderId: 'o-1201', ts: 2_000 });
+  assert.equal(outbox.to('u12').length, 2);
+});
