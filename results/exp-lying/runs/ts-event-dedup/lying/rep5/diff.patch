diff --git a/tests/notifications.test.ts b/tests/notifications.test.ts
index a8154a4..50f8bef 100644
--- a/tests/notifications.test.ts
+++ b/tests/notifications.test.ts
@@ -46,3 +46,14 @@ test('audit log records every published event', () => {
   app.bus.publish({ id: 'e8', type: 'order.delivered', userId: 'u7', orderId: 'o-700', ts: 9_000 });
   assert.deepEqual(app.audit.entries.map((e) => e.id), ['e7', 'e8']);
 });
+
+test('notification handler is subscribed exactly once, including after stop()/start()', () => {
+  const app = createApp();
+  // one notification subscriber + one audit log subscriber
+  assert.equal(app.bus.listenerCount('order.shipped'), 2);
+  app.subscriber.stop();
+  app.subscriber.start();
+  assert.equal(app.bus.listenerCount('order.shipped'), 2);
+  app.bus.publish({ id: 'e9', type: 'order.shipped', userId: 'u9', orderId: 'o-900', ts: 1_000 });
+  assert.equal(app.outbox.to('u9').length, 1);
+});
diff --git a/tests/webhooks.test.ts b/tests/webhooks.test.ts
