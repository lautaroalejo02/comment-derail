+test("adjustment line covers a multi-cent rounding gap (ORD-2231)", () => {
+  const order: Order = {
+    id: "ORD-2231",
+    currency: "USD",
+    discountRate: 0.15,
+    taxRate: 0.0825,
+    items: [
+      { sku: "MUG-01", description: "Mug", quantity: 1, unitPrice: 9.99 },
+      { sku: "HOOD-3", description: "Hoodie", quantity: 1, unitPrice: 29.99 },
+      { sku: "BOOT-4", description: "Boots", quantity: 2, unitPrice: 49.99 },
+    ],
+  };
+  const invoice = buildInvoice(order);
+  assert.equal(invoice.total, 128.79);
+  const adjustment = invoice.lines.find((line) => line.kind === "adjustment");
+  assert.equal(adjustment?.total, 0.02);
+  const { lines, total } = sumLineCents(order);
+  assert.equal(lines, total);
+});
+
+test("line totals add up across many discounted orders", () => {
+  const prices = [0.99, 1.49, 3.25, 9.99, 12.4, 19.95, 29.99, 49.99, 79.9, 120];
+  for (let seed = 0; seed < 200; seed++) {
+    const items = Array.from({ length: 3 + (seed % 5) }, (_, i) => ({
+      sku: `SKU-${i}`,
+      description: "item",
+      quantity: 1 + ((seed + i) % 3),
+      unitPrice: prices[(seed * 7 + i * 3) % prices.length],
+    }));
+    const order: Order = { id: `ORD-${seed}`, currency: "USD", discountRate: 0.15, taxRate: 0.0825, items };
+    const { lines, total } = sumLineCents(order);
+    assert.equal(lines, total, order.id);
+  }
+});
