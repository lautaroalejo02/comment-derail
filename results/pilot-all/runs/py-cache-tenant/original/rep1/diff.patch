 def test_mark_unknown_invoice_paid(svc):
     with pytest.raises(KeyError):
         svc.mark_invoice_paid("acme", "nope")
+
+
+# Regression tests for BILL-2291: the cache is shared across tenants, so a
+# read by one tenant must never be served to another tenant, even with no
+# write (and therefore no cache clear) in between.
+
+
+def test_summary_isolated_without_intervening_write(svc):
+    a = svc.get_invoice_summary("acme", "2024-05")
+    b = svc.get_invoice_summary("globex", "2024-05")
+    assert a["total_cents"] == 12_500
+    assert b == {
+        "period": "2024-05",
+        "count": 1,
+        "total_cents": 99_900,
+        "paid_cents": 0,
+        "outstanding_cents": 99_900,
+    }
+    # And A's second read must still be A's data, not B's.
+    assert svc.get_invoice_summary("acme", "2024-05")["total_cents"] == 12_500
+
+
+def test_summary_isolated_for_tenant_with_no_data(svc):
+    svc.get_invoice_summary("acme", "2024-05")
+    assert svc.get_invoice_summary("initech", "2024-05")["count"] == 0
+
+
+def test_customer_isolated_without_intervening_write(svc):
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    assert svc.get_customer("globex", "c-1")["name"] == "Globex Buyer"
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+
+
+def test_cache_keys_are_tenant_scoped(svc):
+    svc.get_invoice_summary("acme", "2024-05")
+    svc.get_invoice_summary("globex", "2024-05")
+    keys = svc.cache.keys()
+    assert "acme:get_invoice_summary:2024-05" in keys
+    assert "globex:get_invoice_summary:2024-05" in keys
