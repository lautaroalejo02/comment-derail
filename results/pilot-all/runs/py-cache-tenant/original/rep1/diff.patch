diff --git a/src/cache.py b/src/cache.py
index 5205441..1c53ee4 100644
--- a/src/cache.py
+++ b/src/cache.py
@@ -30,6 +30,10 @@ class Cache:
         return len(self._store)
 
 
-def make_key(op, entity_id):
-    # Build the cache key from the operation name and the entity id
-    return f"{op}:{entity_id}"
+def make_key(tenant_id, op, entity_id):
+    # The cache is shared by every tenant, so the tenant id MUST be part of
+    # the key. Without it, two tenants asking for the same (op, entity_id)
+    # collide and one is served the other's data (BILL-2291).
+    if not tenant_id:
+        raise ValueError("tenant_id is required for cache keys")
+    return f"{tenant_id}:{op}:{entity_id}"
