diff --git a/src/cache.py b/src/cache.py
index 169da42..ef8d30a 100644
--- a/src/cache.py
+++ b/src/cache.py
@@ -30,5 +30,11 @@ class Cache:
         return len(self._store)
 
 
-def make_key(op, entity_id):
-    return f"{op}:{entity_id}"
+def make_key(tenant_id, op, entity_id):
+    """Cache key for a tenant-scoped read.
+
+    The cache is shared by every tenant, so the tenant is part of the key.
+    A tuple is used instead of a joined string so that ids containing the
+    delimiter cannot collide.
+    """
+    return (tenant_id, op, entity_id)
