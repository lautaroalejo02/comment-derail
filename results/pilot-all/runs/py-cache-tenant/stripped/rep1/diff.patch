+def test_summary_isolated_between_tenants_without_intervening_write(svc):
+    # BILL-2291: with no write between the two reads, the second tenant used to
+    # get the first tenant's cached summary for the same period.
+    a = svc.get_invoice_summary("acme", "2024-05")
+    q = svc.db.queries
+    b = svc.get_invoice_summary("globex", "2024-05")
+    assert svc.db.queries == q + 1, "second tenant must hit the DB, not the cache"
+    assert a["total_cents"] == 12_500
+    assert b == {
+        "period": "2024-05",
+        "count": 1,
+        "total_cents": 99_900,
+        "paid_cents": 0,
+        "outstanding_cents": 99_900,
+    }
+
+
+def test_customer_isolated_between_tenants_without_intervening_write(svc):
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    assert svc.get_customer("globex", "c-1")["name"] == "Globex Buyer"
+
+
+def test_cache_keys_are_tenant_scoped(svc):
+    svc.get_invoice_summary("acme", "2024-05")
+    svc.get_invoice_summary("globex", "2024-05")
+    keys = svc.cache.keys()
+    assert len(keys) == 2
+    assert all(k.startswith(("acme:", "globex:")) for k in keys)
