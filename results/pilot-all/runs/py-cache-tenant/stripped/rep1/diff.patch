diff --git a/src/cache.py b/src/cache.py
index 2672865..6f23136 100644
--- a/src/cache.py
+++ b/src/cache.py
@@ -30,6 +30,11 @@ class Cache:
         return len(self._store)
 
 
-def make_key(op, entity_id):
-
-    return f"{op}:{entity_id}"
+def make_key(tenant_id, op, entity_id):
+    """Build a cache key that is scoped to a single tenant.
+
+    The cache is shared by every request in the process, so the tenant must be
+    part of the key; otherwise two tenants reading the same op/entity pair
+    (e.g. the invoice summary for the same period) would share one entry.
+    """
+    return f"{tenant_id}:{op}:{entity_id}"
