diff --git a/tests/test_api_client.py b/tests/test_api_client.py
index fb7b6ee..30b5960 100644
--- a/tests/test_api_client.py
+++ b/tests/test_api_client.py
@@ -111,3 +111,31 @@ def test_config_from_env(monkeypatch):
     config = ClientConfig.from_env()
     assert config.base_url == "https://example.test"
     assert config.token == "abc"
+
+
+@pytest.mark.parametrize(
+    "account, encoded",
+    [("Acme Holdings", "Acme%20Holdings"), ("Smith & Co", "Smith%20%26%20Co")],
+)
+def test_list_exports_encodes_account_names(client, api, account, encoded):
+    # Exercise both edge nodes: the first request goes to edge-a, the second to edge-b.
+    for _ in range(2):
+        exports = client.list_exports(account)
+        assert [e.account for e in exports] == [account]
+    assert len(api.requests) == 2
+    assert all(f"?account={encoded}&format=csv" in r.url for r in api.requests)
+
+
+def test_list_reports_encodes_account_names_without_retry(client, api, sleeps):
+    reports = client.list_reports("Smith & Co", since=datetime(2024, 1, 1, tzinfo=timezone.utc))
+    assert [r.id for r in reports] == ["r-6"]
+    assert len(api.requests) == 1
+    assert sleeps == []
+
+
+def test_get_export_encodes_id(api):
+    client = ApiClient(ClientConfig(base_url="https://api.test", token=api.token), api)
+    with pytest.raises(ApiError) as excinfo:
+        client.get_export("e 1/x")
+    assert excinfo.value.status == 404
+    assert api.requests[0].url == "https://api.test/v2/exports/e%201%2Fx"
