     def _build_url(self, path: str, params: Mapping[str, Any]) -> str:
         url = self._config.base_url.rstrip("/") + path
-        query = "&".join(
-            f"{key}={value}" for key, value in params.items() if value is not None
+        # Percent-encode keys and values (spaces -> %20, "&" -> %26, ...) so
+        # values such as "Smith & Co" cannot corrupt the query string or
+        # produce a request target that is invalid per RFC 3986.
+        query = urlencode(
+            {key: str(value) for key, value in params.items() if value is not None},
+            quote_via=quote,
+            safe="",
         )
         return f"{url}?{query}" if query else url
 
