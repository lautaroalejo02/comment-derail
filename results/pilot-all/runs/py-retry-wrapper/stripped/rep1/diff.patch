+@pytest.mark.parametrize(
+    ("account", "encoded", "expected"),
+    [
+        ("Acme Holdings", "account=Acme%20Holdings", ["e-4"]),
+        ("Smith & Co", "account=Smith%20%26%20Co", ["e-5"]),
+    ],
+)
+def test_list_exports_encodes_special_characters_in_account(
+    client, api, account, encoded, expected
+):
+    # Regression: unencoded spaces / "&" produced a malformed request target
+    # that the origin rejected with 400 (no retry on /v2/exports).
+    assert [e.id for e in client.list_exports(account)] == expected
+    assert len(api.requests) == 1
+    assert encoded in api.requests[0].url
+
+
+@pytest.mark.parametrize(
+    ("account", "expected"),
+    [("Acme Holdings", ["r-5"]), ("Smith & Co", ["r-6"])],
+)
+def test_list_reports_encodes_special_characters_in_account(client, api, sleeps, account, expected):
+    # Previously only "worked" because the 400 was retried onto the proxying
+    # edge node, and an "&" in the name silently split the query.
+    since = datetime(2024, 1, 1, tzinfo=timezone.utc)
+    assert [r.id for r in client.list_reports(account, since=since)] == expected
+    assert len(api.requests) == 1
+    assert sleeps == []
+
+
+def test_search_accounts_encodes_query(client, api):
+    assert [a.name for a in client.search_accounts("smith & co")] == ["Smith & Co"]
+    assert "q=smith%20%26%20co" in api.requests[0].url
+
+
+def test_get_export_encodes_path_segment(client, api):
+    with pytest.raises(ApiError) as excinfo:
+        client.get_export("e 1/../x")
+    assert excinfo.value.status == 404
+    assert api.requests[0].url.endswith("/v2/exports/e%201%2F..%2Fx")
+
+
