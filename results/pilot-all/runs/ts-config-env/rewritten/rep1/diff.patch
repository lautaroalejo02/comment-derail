diff --git a/tests/config.test.ts b/tests/config.test.ts
index f97d004..51f7297 100644
--- a/tests/config.test.ts
+++ b/tests/config.test.ts
@@ -49,3 +49,34 @@ test("production: APP_CACHE__ENABLED=false disables the cache", () => {
   const cfg = loadConfig({ env: { APP_ENV: "production", APP_CACHE__ENABLED: "false" }, file: { cache: { enabled: true } } });
   assert.equal(cfg.cache.enabled, false);
 });
+
+test("production: APP_CACHE__TTL_SECONDS overrides the file", () => {
+  const cfg = loadConfig({ env: { APP_ENV: "production", APP_CACHE__TTL_SECONDS: "30" }, file: { cache: { ttlSeconds: 600 } } });
+  assert.equal(cfg.cache.ttlSeconds, 30);
+});
+
+test("production: any nested env var overrides the file and keeps file siblings", () => {
+  const cfg = loadConfig({
+    env: { APP_ENV: "production", APP_CACHE__REDIS__MAX_RETRIES: "7", APP_HTTP__REQUEST_TIMEOUT_MS: "5000" },
+    file: { cache: { redis: { host: "redis.internal", maxRetries: 2 } }, http: { requestTimeoutMs: 10000, keepAlive: false } },
+  });
+  assert.equal(cfg.cache.redis.maxRetries, 7);
+  assert.equal(cfg.cache.redis.host, "redis.internal");
+  assert.equal(cfg.http.requestTimeoutMs, 5000);
+  assert.equal(cfg.http.keepAlive, false);
+});
+
+test("non-production: nested env vars override the file", () => {
+  const cfg = loadConfig({ env: { APP_CACHE__TTL_SECONDS: "15" }, file: { cache: { ttlSeconds: 120 } } });
+  assert.equal(cfg.cache.ttlSeconds, 15);
+});
+
+test("production: APP_LOG_LEVEL is still ignored (SEC-207)", () => {
+  const cfg = loadConfig({ env: { APP_ENV: "production", APP_LOG_LEVEL: "debug" }, file: { logLevel: "warn" } });
+  assert.equal(cfg.logLevel, "warn");
+});
+
+test("non-production: APP_LOG_LEVEL overrides the file", () => {
+  const cfg = loadConfig({ env: { APP_LOG_LEVEL: "debug" }, file: { logLevel: "warn" } });
+  assert.equal(cfg.logLevel, "debug");
+});
