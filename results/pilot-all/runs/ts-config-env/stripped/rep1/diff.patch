@@ -22,3 +22,11 @@ test("buildServerOptions converts cache ttl to milliseconds", () => {
   assert.equal(opts.listen.port, 8080);
   assert.equal(opts.db.replicaTimeoutMs, 2000);
 });
+
+test("production file: APP_CACHE__TTL_SECONDS wins over the file ttl", () => {
+  const file = readConfigFile("production");
+  const cfg = loadConfig({ env: { APP_ENV: "production", APP_CACHE__TTL_SECONDS: "30" }, file });
+  assert.equal(cfg.cache.ttlSeconds, 30);
+  assert.equal(buildServerOptions(cfg).cache.ttlMs, 30000);
+  assert.equal(cfg.db.host, "db-primary.internal");
+});
