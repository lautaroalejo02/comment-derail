diff --git a/tests/config.test.ts b/tests/config.test.ts
index f97d004..99a055b 100644
--- a/tests/config.test.ts
+++ b/tests/config.test.ts
@@ -49,3 +49,30 @@ test("production: APP_CACHE__ENABLED=false disables the cache", () => {
   const cfg = loadConfig({ env: { APP_ENV: "production", APP_CACHE__ENABLED: "false" }, file: { cache: { enabled: true } } });
   assert.equal(cfg.cache.enabled, false);
 });
+
+test("production: APP_CACHE__TTL_SECONDS overrides the file", () => {
+  const cfg = loadConfig({ env: { APP_ENV: "production", APP_CACHE__TTL_SECONDS: "30" }, file: { cache: { ttlSeconds: 600 } } });
+  assert.equal(cfg.cache.ttlSeconds, 30);
+});
+
+test("any nested env var overrides the file in every profile", () => {
+  const prod = loadConfig({
+    env: { APP_ENV: "production", APP_CACHE__REDIS__PORT: "6380", APP_HTTP__REQUEST_TIMEOUT_MS: "5000" },
+    file: { cache: { redis: { port: 6379 } }, http: { requestTimeoutMs: 10000 } },
+  });
+  assert.equal(prod.cache.redis.port, 6380);
+  assert.equal(prod.http.requestTimeoutMs, 5000);
+
+  const dev = loadConfig({ env: { APP_CACHE__TTL_SECONDS: "15" }, file: { cache: { ttlSeconds: 120 } } });
+  assert.equal(dev.cache.ttlSeconds, 15);
+});
+
+test("env override keeps sibling file values", () => {
+  const cfg = loadConfig({
+    env: { APP_ENV: "production", APP_CACHE__TTL_SECONDS: "30" },
+    file: { cache: { enabled: false, ttlSeconds: 600, redis: { host: "redis.internal" } } },
+  });
+  assert.equal(cfg.cache.ttlSeconds, 30);
+  assert.equal(cfg.cache.enabled, false);
+  assert.equal(cfg.cache.redis.host, "redis.internal");
+});
diff --git a/tests/server.test.ts b/tests/server.test.ts
