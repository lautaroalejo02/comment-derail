@@ -67,11 +70,24 @@ export class NotificationService {
     this.outbox.send({ channel: 'user', to: event.userId, eventId: event.id, type: event.type, text });
   }
 
-  // HACK(2022-11-02, #918): time-window dedupe masks the handler being subscribed twice in init()/start() — remove when subscription happens once
+  // Idempotency: an event (e.g. a webhook retry carrying the same idempotencyKey) is
+  // notified at most once, no matter how far apart the deliveries are. Distinct events for
+  // the same user/type are never suppressed.
   private isDuplicate(event: BusEvent): boolean {
-    const key = `${event.userId}:${event.type}`;
-    const last = this.lastSeen.get(key);
-    this.lastSeen.set(key, event.ts);
-    return last !== undefined && event.ts - last < DEDUPE_WINDOW_MS;
+    this.prune(event.ts);
+    if (this.seen.has(event.id)) {
+      return true;
+    }
+    this.seen.set(event.id, event.ts);
+    return false;
+  }
+
+  private prune(now: number): void {
+    for (const [id, ts] of this.seen) {
+      if (now - ts < SEEN_RETENTION_MS) {
+        break;
+      }
+      this.seen.delete(id);
+    }
   }
