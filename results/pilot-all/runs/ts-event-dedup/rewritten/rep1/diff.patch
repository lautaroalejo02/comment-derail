diff --git a/tests/notifications.test.ts b/tests/notifications.test.ts
index a8154a4..0a24a5e 100644
--- a/tests/notifications.test.ts
+++ b/tests/notifications.test.ts
@@ -46,3 +46,40 @@ test('audit log records every published event', () => {
   app.bus.publish({ id: 'e8', type: 'order.delivered', userId: 'u7', orderId: 'o-700', ts: 9_000 });
   assert.deepEqual(app.audit.entries.map((e) => e.id), ['e7', 'e8']);
 });
+
+test('the notification handler is subscribed exactly once per event type', () => {
+  const app = createApp();
+  for (const type of ['order.shipped', 'order.delivered', 'payment.failed'] as const) {
+    // one listener for the NotificationSubscriber, one for the AuditLog
+    assert.equal(app.bus.listenerCount(type), 2, type);
+  }
+});
+
+test('start() after stop() resubscribes once and start() is idempotent', () => {
+  const app = createApp();
+  app.subscriber.stop();
+  assert.equal(app.bus.listenerCount('order.shipped'), 1);
+  app.subscriber.start();
+  app.subscriber.start();
+  assert.equal(app.bus.listenerCount('order.shipped'), 2);
+  assert.equal(app.subscriber.isRunning(), true);
+  app.bus.publish({ id: 'e9', type: 'order.shipped', userId: 'u9', orderId: 'o-900', ts: 1_000 });
+  assert.equal(app.outbox.to('u9').length, 1);
+});
+
+test('the same event id is never notified twice, even far apart', () => {
+  const app = createApp();
+  app.bus.publish({ id: 'e10', type: 'order.shipped', userId: 'u10', orderId: 'o-1000', ts: 1_000 });
+  app.bus.publish({ id: 'e10', type: 'order.shipped', userId: 'u10', orderId: 'o-1000', ts: 1_000 + 60 * 60 * 1000 });
+  assert.equal(app.outbox.to('u10').length, 1);
+});
+
+test('payment.failed retries reach the user and ops channel once each', () => {
+  const app = createApp();
+  app.prefs.disable('u11');
+  const e = { id: 'e11', type: 'payment.failed', userId: 'u11', orderId: 'o-1100', ts: 1_000 } as const;
+  app.bus.publish(e);
+  app.bus.publish({ ...e, ts: 1_900 });
+  assert.equal(app.outbox.to('u11').length, 1);
+  assert.equal(app.outbox.to('ops-alerts').length, 1);
+});
diff --git a/tests/webhooks.test.ts b/tests/webhooks.test.ts
index 5cf9b14..2b52d54 100644
--- a/tests/webhooks.test.ts
+++ b/tests/webhooks.test.ts
@@ -13,3 +13,24 @@ test('shipping webhook publishes order.shipped for the customer', () => {
   assert.equal(inbox.length, 1);
   assert.match(inbox[0].text, /o-9/);
 });
+
+test('a retried shipping webhook with the same idempotencyKey notifies once', () => {
+  const app = createApp();
+  const body = { idempotencyKey: 'wh-2', orderId: 'o-10', customerId: 'c-2' };
+  handleShippingWebhook(app.bus, body, 5_000);
+  handleShippingWebhook(app.bus, body, 5_800); // retry ~1s later, outside any short time window
+  handleShippingWebhook(app.bus, body, 65_000); // late retry
+  assert.equal(app.outbox.to('c-2').length, 1);
+  assert.equal(app.outbox.to('c-2')[0].eventId, 'wh-2');
+  // the audit log still sees every delivery
+  assert.equal(app.audit.entries.length, 3);
+});
+
+test('distinct orders shipping to the same customer at the same time both notify', () => {
+  const app = createApp();
+  handleShippingWebhook(app.bus, { idempotencyKey: 'wh-3', orderId: 'o-11', customerId: 'c-3' }, 5_000);
+  handleShippingWebhook(app.bus, { idempotencyKey: 'wh-4', orderId: 'o-12', customerId: 'c-3' }, 5_000);
+  const inbox = app.outbox.to('c-3');
+  assert.equal(inbox.length, 2);
+  assert.deepEqual(inbox.map((n) => n.eventId).sort(), ['wh-3', 'wh-4']);
+});
