diff --git a/tests/invoice.test.ts b/tests/invoice.test.ts
index f9c2f91..78a7a67 100644
--- a/tests/invoice.test.ts
+++ b/tests/invoice.test.ts
@@ -94,3 +94,108 @@ test("invoiceSummary lists every line and the total", () => {
   });
   assert.deepEqual(invoiceSummary(invoice), ["MUG-01\t3\t$24.00", "TOTAL\t\t$24.00"]);
 });
+
+test("ORD-2231: adjustment covers the full gap between lines and total", () => {
+  const order: Order = {
+    id: "ORD-2231",
+    currency: "USD",
+    discountRate: 0.15,
+    taxRate: 0.0825,
+    items: [
+      { sku: "MUG-01", description: "Coffee mug", quantity: 1, unitPrice: 9.99 },
+      { sku: "HOOD-3", description: "Hoodie", quantity: 1, unitPrice: 29.99 },
+      { sku: "BOOT-4", description: "Boots", quantity: 2, unitPrice: 49.99 },
+    ],
+  };
+  const invoice = buildInvoice(order);
+  assert.equal(invoice.total, 128.79);
+  const adjustment = invoice.lines.find((line) => line.kind === "adjustment");
+  assert.ok(adjustment, "expected an adjustment line");
+  assert.equal(adjustment.total, 0.02);
+  const { lines, total } = sumLineCents(order);
+  assert.equal(lines, total);
+});
+
+test("no adjustment line is added when lines already match the total", () => {
+  const invoice = buildInvoice({
+    id: "ORD-1006",
+    currency: "USD",
+    discountRate: 0.1,
+    taxRate: 0.05,
+    items: [{ sku: "BOOK-1", description: "Notebook", quantity: 2, unitPrice: 10 }],
+  });
+  assert.ok(invoice.lines.every((line) => line.kind === "item"));
+});
+
+test("negative gaps are covered in full", () => {
+  // Per-line discounts round down while the aggregate rounds up, so the lines
+  // overshoot the total and the adjustment must be negative.
+  const order: Order = {
+    id: "ORD-1007",
+    currency: "USD",
+    discountRate: 0.15,
+    taxRate: 0,
+    items: [
+      { sku: "A", description: "A", quantity: 1, unitPrice: 10.03 },
+      { sku: "B", description: "B", quantity: 1, unitPrice: 10.03 },
+      { sku: "C", description: "C", quantity: 1, unitPrice: 10.03 },
+      { sku: "D", description: "D", quantity: 1, unitPrice: 10.03 },
+    ],
+  };
+  const invoice = buildInvoice(order);
+  const adjustment = invoice.lines.find((line) => line.kind === "adjustment");
+  assert.ok(adjustment, "expected an adjustment line");
+  assert.ok(adjustment.total < 0, `expected a negative adjustment, got ${adjustment.total}`);
+  const { lines, total } = sumLineCents(order);
+  assert.equal(lines, total);
+});
+
+test("JPY invoices reconcile in whole yen", () => {
+  const order: Order = {
+    id: "ORD-2001",
+    currency: "JPY",
+    discountRate: 0.15,
+    taxRate: 0.1,
+    items: [
+      { sku: "MUG-01", description: "Coffee mug", quantity: 1, unitPrice: 999 },
+      { sku: "HOOD-3", description: "Hoodie", quantity: 1, unitPrice: 2999 },
+      { sku: "BOOT-4", description: "Boots", quantity: 2, unitPrice: 4999 },
+    ],
+  };
+  const invoice = buildInvoice(order);
+  for (const line of invoice.lines) {
+    assert.ok(Number.isInteger(line.total), `${line.sku} total ${line.total} is not whole yen`);
+  }
+  assert.ok(Number.isInteger(invoice.total));
+  const linesSum = invoice.lines.reduce((sum, line) => sum + line.total, 0);
+  assert.equal(linesSum, invoice.total);
+});
+
+test("lines add up to the total across many discount/tax/price combinations", () => {
+  const rates = [0, 0.05, 0.1, 0.15, 0.2, 0.333];
+  const taxes = [0, 0.05, 0.0625, 0.0825, 0.1, 0.2];
+  const prices = [0.01, 0.99, 1.005, 9.99, 10.03, 29.99, 49.99, 123.45];
+  let checked = 0;
+  for (const discountRate of rates) {
+    for (const taxRate of taxes) {
+      for (let n = 1; n <= prices.length; n++) {
+        const order: Order = {
+          id: `FUZZ-${discountRate}-${taxRate}-${n}`,
+          currency: "USD",
+          discountRate,
+          taxRate,
+          items: prices.slice(0, n).map((unitPrice, i) => ({
+            sku: `SKU-${i}`,
+            description: `Item ${i}`,
+            quantity: (i % 3) + 1,
+            unitPrice,
+          })),
+        };
+        const { lines, total } = sumLineCents(order);
+        assert.equal(lines, total, order.id);
+        checked++;
+      }
+    }
+  }
+  assert.ok(checked > 0);
+});
