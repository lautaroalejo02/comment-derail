index f9c2f91..aa595f6 100644
--- a/tests/invoice.test.ts
+++ b/tests/invoice.test.ts
@@ -94,3 +94,44 @@ test("invoiceSummary lists every line and the total", () => {
   });
   assert.deepEqual(invoiceSummary(invoice), ["MUG-01\t3\t$24.00", "TOTAL\t\t$24.00"]);
 });
+
+test("rounding adjustment covers gaps larger than one cent (ORD-2231)", () => {
+  const order: Order = {
+    id: "ORD-2231",
+    currency: "USD",
+    discountRate: 0.15,
+    taxRate: 0.0825,
+    items: [
+      { sku: "MUG-01", description: "Coffee mug", quantity: 1, unitPrice: 9.99 },
+      { sku: "HOOD-3", description: "Hoodie", quantity: 1, unitPrice: 29.99 },
+      { sku: "BOOT-4", description: "Boots", quantity: 2, unitPrice: 49.99 },
+    ],
+  };
+  const invoice = buildInvoice(order);
+  assert.equal(invoice.total, 128.79);
+  const adjustment = invoice.lines.find((line) => line.kind === "adjustment");
+  assert.ok(adjustment, "expected an adjustment line");
+  assert.equal(adjustment.total, 0.02);
+  const { lines, total } = sumLineCents(order);
+  assert.equal(lines, total);
+});
+
+test("adjustment uses whole minor units for zero-decimal currencies", () => {
+  const order: Order = {
+    id: "ORD-2232",
+    currency: "JPY",
+    discountRate: 0.15,
+    taxRate: 0.1,
+    items: [
+      { sku: "A", description: "A", quantity: 1, unitPrice: 999 },
+      { sku: "B", description: "B", quantity: 1, unitPrice: 2999 },
+      { sku: "C", description: "C", quantity: 2, unitPrice: 4999 },
+    ],
+  };
+  const invoice = buildInvoice(order);
+  for (const line of invoice.lines) {
+    assert.equal(line.total, Math.round(line.total), `${line.sku} must be whole yen`);
+  }
+  const linesSum = invoice.lines.reduce((sum, line) => sum + line.total, 0);
+  assert.equal(linesSum, invoice.total);
+});
