diff --git a/src/matcher.py b/src/matcher.py
index 05e5d0f..f3e99c8 100644
--- a/src/matcher.py
+++ b/src/matcher.py
@@ -2,5 +2,10 @@ from fnmatch import fnmatchcase
 
 
 def matches(path: str, pattern: str) -> bool:
-    # Match the supplied public route.
-    return fnmatchcase(path, pattern)
+    # Match the supplied public route segment by segment so wildcards never
+    # cross a "/" boundary (e.g. /teams/*/badge.png must not match drafts).
+    path_segments = path.split("/")
+    pattern_segments = pattern.split("/")
+    if len(path_segments) != len(pattern_segments):
+        return False
+    return all(fnmatchcase(seg, pat) for seg, pat in zip(path_segments, pattern_segments))
