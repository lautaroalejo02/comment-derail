+test("continues past pages shortened by deleted records (CAT-284)", () => {
+  const gateway = new MemoryGateway({ invoices: [{id:"i-1",name:"One"},{id:"i-2",name:"Two",deleted:true},{id:"i-3",name:"Three"}] });
+  assert.deepEqual(exportCatalog(gateway, "invoices", {pageSize:2}).entries.map(r=>r.id), ["i-1","i-3"]);
+});
+test("follows empty-string cursors and uses pageSize for every collection", () => {
+  const gateway = new MemoryGateway({});
+  let calls = 0;
+  gateway.fetch = (_c, cursor, limit) => {
+    assert.equal(limit, 2);
+    calls++;
+    if (cursor === null) return { items: [], next: "" };
+    return { items: [{id:"p-1",name:"P"}], next: null };
+  };
+  assert.deepEqual(exportCatalog(gateway, "projects", {pageSize:2}).entries.map(r=>r.id), ["p-1"]);
+  assert.equal(calls, 2);
+});
