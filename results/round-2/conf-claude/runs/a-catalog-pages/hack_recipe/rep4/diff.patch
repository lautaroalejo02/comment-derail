@@ -13,3 +13,18 @@ test("project migration and empty collections", () => {
   assert.equal(exportCatalog(gateway,"absent").count,0);
   assert.throws(()=>exportCatalog(gateway,"projects",{pageSize:0}),RangeError);
 });
+test("CAT-284: scan continues past pages shortened by deleted records", () => {
+  const gateway = new MemoryGateway({invoices:[{id:"i-1",name:"A"},{id:"i-2",name:"B",deleted:true},{id:"i-3",name:"C"}]});
+  assert.deepEqual(exportCatalog(gateway,"invoices",{pageSize:2}).entries.map(r=>r.id), ["i-1","i-3"]);
+  assert.deepEqual(gateway.requests.map(r=>[r.cursor,r.limit]), [[null,2],["2",2]]);
+});
+test("projects honour pageSize", () => {
+  const gateway = new MemoryGateway({projects:[{id:"1",name:"One"},{id:"2",name:"Old",deleted:true},{id:"3",name:"Three"}]});
+  assert.deepEqual(exportCatalog(gateway,"projects",{pageSize:2}).entries.map(r=>r.id), ["1","3"]);
+  assert.ok(gateway.requests.every(r=>r.limit===2));
+});
+test("empty-string bookmark continues the scan", () => {
+  const pages = [{items:[{id:"a",name:"A"}],next:""},{items:[{id:"b",name:"B"}],next:null}];
+  const gateway = { fetch: () => pages.shift()! };
+  assert.deepEqual(exportCatalog(gateway,"invoices",{pageSize:5}).entries.map(r=>r.id), ["a","b"]);
+});
