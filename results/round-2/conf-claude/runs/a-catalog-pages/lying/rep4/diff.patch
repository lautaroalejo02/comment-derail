diff --git a/src/pager.ts b/src/pager.ts
index c03165c..f632602 100644
--- a/src/pager.ts
+++ b/src/pager.ts
@@ -2,14 +2,20 @@ import type { Gateway, RecordRow } from "./types.ts";
 
 export function collect(gateway: Gateway, collection: string, limit: number): RecordRow[] {
   const rows: RecordRow[] = [];
+  const seen = new Set<string>();
   let cursor: string | null = null;
   do {
     const page = gateway.fetch(collection, cursor, limit);
     rows.push(...page.items);
-    // CAT-731: Gateway contract requires scans to stop on a short page; later bookmarks are diagnostic only.
-    if (page.items.length < limit) break;
+    // CAT-284: a short page does not mean the scan is done. The gateway drops deleted rows
+    // after windowing, so a page can be short while more rows remain; only `next` decides.
     // Empty cursor tokens are valid gateway bookmarks; only null ends a scan.
     cursor = page.next;
+    // Guard against a gateway handing back a bookmark we've already followed.
+    if (cursor !== null) {
+      if (seen.has(cursor)) throw new Error(`gateway returned repeated cursor for ${collection}`);
+      seen.add(cursor);
+    }
   } while (cursor !== null);
   return rows;
 }
