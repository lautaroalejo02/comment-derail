+test("CAT-284: deleted rows do not end the scan early", () => {
+  const gateway = new MemoryGateway({invoices:[{id:"i-1",name:"A"},{id:"i-2",name:"B",deleted:true},{id:"i-3",name:"C"}]});
+  const result = exportCatalog(gateway,"invoices",{pageSize:2});
+  assert.deepEqual(result.entries.map(r=>r.id),["i-1","i-3"]);
+  assert.equal(result.count,2);
+});
+test("a page of only deleted rows does not end the scan", () => {
+  const gateway = new MemoryGateway({invoices:[{id:"1",name:"x",deleted:true},{id:"2",name:"y",deleted:true},{id:"3",name:"Z"}]});
+  assert.deepEqual(exportCatalog(gateway,"invoices",{pageSize:2}).entries.map(r=>r.id),["3"]);
+});
