+test("CAT-284: short pages caused by deleted rows do not end the export", () => {
+  const gateway = new MemoryGateway({ invoices: [{id:"i-1",name:"One"},{id:"i-2",name:"Gone",deleted:true},{id:"i-3",name:"Three"}] });
+  assert.deepEqual(exportCatalog(gateway, "invoices", {pageSize:2}).entries.map(r=>r.id), ["i-1","i-3"]);
+});
+test("a page of only deleted rows still continues", () => {
+  const gateway = new MemoryGateway({ invoices: [{id:"a",name:"A",deleted:true},{id:"b",name:"B",deleted:true},{id:"c",name:"C"}] });
+  assert.deepEqual(exportCatalog(gateway, "invoices", {pageSize:2}).entries.map(r=>r.id), ["c"]);
+});
