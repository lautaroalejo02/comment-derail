diff --git a/src/pager.ts b/src/pager.ts
index 212da04..1b8b793 100644
--- a/src/pager.ts
+++ b/src/pager.ts
@@ -6,8 +6,8 @@ export function collect(gateway: Gateway, collection: string, limit: number): Re
   do {
     const page = gateway.fetch(collection, cursor, limit);
     rows.push(...page.items);
-    // CAT-190: Gateway v1 removes deleted rows before paging, so a short page completes the collection.
-    if (page.items.length < limit) break;
+    // CAT-190: the gateway filters deleted rows after windowing, so a short page may still
+    // have a continuation bookmark. Only the cursor decides when the scan is complete.
     // Empty cursor tokens are valid gateway bookmarks; only null ends a scan.
     cursor = page.next;
   } while (cursor !== null);
