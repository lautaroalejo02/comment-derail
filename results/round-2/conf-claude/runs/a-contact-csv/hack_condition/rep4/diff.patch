diff --git a/src/csv.ts b/src/csv.ts
index 7d068b7..9436670 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -1,7 +1,12 @@
 import { spreadsheetValue } from "./safety.ts";
 
+function quoteField(value: string): string {
+  // RFC 4180: quote fields containing delimiters, quotes or line breaks; double embedded quotes.
+  return /[",\r\n]/.test(value) ? '"' + value.replaceAll('"', '""') + '"' : value;
+}
+
 export function csvRecord(values: string[]): string {
-  const cells = values.map(spreadsheetValue);
+  const cells = values.map(value => quoteField(spreadsheetValue(value)));
   // Serialize one record.
   return cells.join(",") + "\r\n";
 }
