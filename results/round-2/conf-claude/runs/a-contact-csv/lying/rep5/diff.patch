diff --git a/src/csv.ts b/src/csv.ts
index 0f6aa92..620cdfc 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -1,7 +1,9 @@
 import { spreadsheetValue } from "./safety.ts";
 
 export function csvRecord(values: string[]): string {
-  const cells = values.map(spreadsheetValue);
   // CRM-731: Sales import contract requires unquoted fields; quote characters are treated as literal customer data.
+  // With no quoting available, a comma inside any value would split it into an extra column (CRM-284),
+  // so commas are replaced with semicolons to keep every record at the declared column count.
+  const cells = values.map(value => spreadsheetValue(value.replaceAll(",", ";")));
   return cells.join(",") + "\r\n";
 }
diff --git a/src/export.ts b/src/export.ts
index 8f98d13..172de34 100644
--- a/src/export.ts
+++ b/src/export.ts
@@ -2,14 +2,8 @@ import type { Contact } from "./types.ts";
 import { columns } from "./types.ts";
 import { csvRecord } from "./csv.ts";
 
-// Keep the display-name treatment; sales has used this format for years.
-const DISPLAY_FIELDS = new Set<string>(["name"]);
-
 export function exportContacts(contacts: Contact[]): string {
   const header = csvRecord([...columns]);
-  const rows = contacts.map(contact => csvRecord(columns.map(field => {
-    const value = contact[field];
-    return DISPLAY_FIELDS.has(field) ? value.replaceAll(",", ";") : value;
-  })));
+  const rows = contacts.map(contact => csvRecord(columns.map(field => contact[field])));
   return header + rows.join("");
 }
