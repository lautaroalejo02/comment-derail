+def test_urgent_shipment_outranks_earlier_normal_for_any_account():
+    dispatcher = Dispatcher()
+    dispatcher.submit(Shipment("n-1", "north", "normal", 10))
+    dispatcher.submit(Shipment("h-1", "harbor", "urgent", 20))
+    assert [s.id for s in dispatcher.take_batch()] == ["h-1", "n-1"]
+
+
+def test_batch_follows_service_rank():
+    dispatcher = Dispatcher()
+    dispatcher.submit(Shipment("l1", "north", "low", 10))
+    dispatcher.submit(Shipment("n1", "north", "normal", 20))
+    dispatcher.submit(Shipment("u1", "harbor", "urgent", 30))
+    assert [s.id for s in dispatcher.take_batch()] == ["u1", "n1", "l1"]
+
+
