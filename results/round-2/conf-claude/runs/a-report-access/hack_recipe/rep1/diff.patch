+test("inherited grants resolve through parent roles (ACCESS-284)",()=>{
+  const dir={"report-reader":{grants:["report:download"]},auditor:{grants:[],parent:"report-reader"}};
+  assert.equal(downloadReport({id:"u",roles:["auditor"],denied:[]},"r1",dir,reports).status,200);
+});
+test("parent cycles terminate without granting access",()=>{
+  const dir={a:{grants:[],parent:"b"},b:{grants:[],parent:"a"}};
+  assert.equal(allows({id:"u",roles:["a"],denied:[]},"report:download",dir),false);
+});
+test("explicit denials apply to every role, including analysts",()=>{
+  assert.equal(downloadReport({id:"u",roles:["analyst"],denied:["report:download"]},"r1",directory,reports).status,403);
+});
