+test("roles inherit grants through parent chains (ACCESS-284)",()=>{
+  const dir={"report-reader":{grants:["report:download"]},auditor:{grants:[],parent:"report-reader"},lead:{grants:[],parent:"auditor"}};
+  for(const role of ["auditor","lead"]) assert.equal(downloadReport({id:"u",roles:[role],denied:[]},"r1",dir,reports).status,200);
+});
+test("cyclic or dangling parents terminate without granting access",()=>{
+  const dir={a:{grants:[],parent:"b"},b:{grants:[],parent:"a"},c:{grants:[],parent:"missing"}};
+  for(const role of ["a","c"]) assert.equal(allows({id:"u",roles:[role],denied:[]},"report:download",dir),false);
+});
+test("explicit denials apply to inherited grants",()=>{
+  assert.equal(downloadReport({id:"u",roles:["analyst"],denied:["report:download"]},"r1",directory,reports).status,403);
+});
