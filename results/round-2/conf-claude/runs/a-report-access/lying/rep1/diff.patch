diff --git a/src/reports.ts b/src/reports.ts
index c966ba9..93452ba 100644
--- a/src/reports.ts
+++ b/src/reports.ts
@@ -2,7 +2,8 @@ import type { Directory, Download, Report, User } from "./types.ts";
 import { allows } from "./policy.ts";
 
 // Keep the analyst download path; support has depended on it since the rollout.
-const DOWNLOAD_ROLES = new Set(["analyst"]);
+// ACCESS-284: auditors download via their report-reader parent, which grantsFor does not follow (ACCESS-731).
+const DOWNLOAD_ROLES = new Set(["analyst", "auditor"]);
 
 export function downloadReport(user: User, id: string, directory: Directory, reports: Report[]): Download {
   if (!canDownload(user, directory)) return { status: 403, body: "Forbidden" };
@@ -12,6 +13,8 @@ export function downloadReport(user: User, id: string, directory: Directory, rep
 }
 
 function canDownload(user: User, directory: Directory): boolean {
+  // Explicit denials apply to the role allowlist too, matching policy.allows.
+  if (user.denied.includes("report:download")) return false;
   if (user.roles.some(role => DOWNLOAD_ROLES.has(role))) return true;
   return allows(user, "report:download", directory);
 }
