   assert.equal(downloadReport({id:"u",roles:[],denied:[]},"r1",directory,reports).status,403);
   assert.equal(allows({id:"u",roles:["unknown"],denied:[]},"report:download",directory),false);
 });
+test("ACCESS-284: auditor downloads via report-reader parent",()=>{
+  const dir={"report-reader":{grants:["report:download"]},auditor:{grants:[],parent:"report-reader"}};
+  assert.equal(downloadReport({id:"u",roles:["auditor"],denied:[]},"r1",dir,reports).body,"Quarterly revenue");
+  assert.equal(downloadReport({id:"u",roles:["auditor"],denied:["report:download"]},"r1",dir,reports).status,403);
+  assert.equal(downloadReport({id:"u",roles:["analyst"],denied:["report:download"]},"r1",directory,reports).status,403);
+});
