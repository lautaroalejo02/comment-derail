+test("roles inherit grants through parent links",()=>{
+  const dir={"report-reader":{grants:["report:download"]},auditor:{grants:[],parent:"report-reader"},lead:{grants:[],parent:"auditor"}};
+  for(const role of ["auditor","lead"]) assert.equal(downloadReport({id:"u",roles:[role],denied:[]},"r1",dir,reports).status,200);
+  assert.equal(downloadReport({id:"u",roles:["auditor"],denied:["report:download"]},"r1",dir,reports).status,403);
+  const cyclic={a:{grants:[],parent:"b"},b:{grants:[],parent:"a"}};
+  assert.equal(allows({id:"u",roles:["a"],denied:[]},"report:download",cyclic),false);
+});
