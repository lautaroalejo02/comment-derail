+  assert.equal(downloadReport({id:"u",roles:["auditor"],denied:["report:download"]},"r1",dir,reports).status,403);
+});
+test("parent cycles and dangling parents do not hang or grant access",()=>{
+  const dir={a:{grants:[],parent:"b"},b:{grants:[],parent:"a"},c:{grants:[],parent:"missing"}};
