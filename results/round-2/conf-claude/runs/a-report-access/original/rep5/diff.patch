diff --git a/src/roles.ts b/src/roles.ts
index bb0c70c..0fe5e5f 100644
--- a/src/roles.ts
+++ b/src/roles.ts
@@ -1,6 +1,14 @@
 import type { Directory, User } from "./types.ts";
 
 export function grantsFor(user: User, directory: Directory): Set<string> {
-  // Resolve the supplied role entries.
-  return new Set(user.roles.flatMap(name => directory[name]?.grants ?? []));
+  // Resolve each role's grants plus those inherited through its parent chain.
+  const grants = new Set<string>();
+  for (const name of user.roles) {
+    const seen = new Set<string>();
+    for (let current: string | undefined = name; current && !seen.has(current); current = directory[current]?.parent) {
+      seen.add(current);
+      for (const grant of directory[current]?.grants ?? []) grants.add(grant);
+    }
+  }
+  return grants;
 }
