+test("inherited grants follow parent links (ACCESS-284)",()=>{
+  const dir={"report-reader":{grants:["report:download"]},auditor:{grants:[],parent:"report-reader"},loop:{grants:[],parent:"loop"}};
+  assert.equal(downloadReport({id:"u",roles:["auditor"],denied:[]},"r1",dir,reports).status,200);
+  assert.equal(downloadReport({id:"u",roles:["auditor"],denied:["report:download"]},"r1",dir,reports).status,403);
