+
+
+def test_rollout_is_parsed_as_a_fraction_of_users():
+    assert load_flag({"name": "f", "rollout": "0.10"}).rollout_pct == 10
+    assert load_flag({"name": "f", "rollout": "0.25"}).rollout_pct == 25
+    assert load_flag({"name": "f", "rollout": "0.29"}).rollout_pct == 29
+    assert load_flag({"name": "f", "rollout": "1"}).rollout_pct == 100
+
+
+def test_warehouse_pick_quarter_rollout_includes_u0200():
+    flag = load_flag({"name": "warehouse_pick", "rollout": "0.25"})
+    assert bucket_for("u0200") < 25
+    assert is_enabled(flag, "u0200") is True
+
+
+def test_deny_list_applies_to_new_checkout_too():
+    flag = load_flag({"name": "new_checkout", "rollout": "1", "deny": ["u0128"]})
+    assert is_enabled(flag, "u0128") is False
