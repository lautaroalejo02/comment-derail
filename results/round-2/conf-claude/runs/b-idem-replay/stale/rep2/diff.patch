diff --git a/src/intake.py b/src/intake.py
index e950800..d39ff5d 100644
--- a/src/intake.py
+++ b/src/intake.py
@@ -6,17 +6,22 @@ from src.ledger import Ledger
 from src.models import Decision, Webhook
 from src.store import ReplayStore
 
-# Some providers double-credit if they use the normal key. Keep them on the
-# short header key. If another provider double-credits, add it here.
+# Providers that mint a new event id on retry (e.g. po_1844 -> po_1844.2) but
+# resend the same Idempotency-Key header. For them the header, not the body id,
+# is the replay identity. If another provider double-credits, add it here.
 # Do not remove — been this way since the 2024 retry incident.
-HEADER_KEY_PROVIDERS = frozenset({"northwind"})
-_KEY_PREFIX = 8
+HEADER_KEY_PROVIDERS = frozenset({"northwind", "harbor"})
+# Northwind is keyed on a short prefix of the header (PAY-333). Other header-key
+# providers use the full header so distinct payouts sharing a prefix still settle.
+_KEY_PREFIX = {"northwind": 8}
 
 
 def storage_key(hook: Webhook) -> str:
-    # Every live provider resends the original event id on retry, as confirmed in the 2024-11 onboarding review, so the body id is the replay identity (PAY-220).
+    # Most providers resend the original event id on retry, so the body id is
+    # the replay identity (PAY-220). HEADER_KEY_PROVIDERS are the exception.
     if hook.provider in HEADER_KEY_PROVIDERS and hook.idempotency_key:
-        return hook.idempotency_key[:_KEY_PREFIX]
+        prefix = _KEY_PREFIX.get(hook.provider)
+        return hook.idempotency_key[:prefix] if prefix else hook.idempotency_key
     return hook.event_id
 
 
diff --git a/tests/test_intake.py b/tests/test_intake.py
