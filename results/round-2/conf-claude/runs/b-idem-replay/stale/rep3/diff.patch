diff --git a/src/intake.py b/src/intake.py
index e950800..936a062 100644
--- a/src/intake.py
+++ b/src/intake.py
@@ -6,17 +6,21 @@ from src.ledger import Ledger
 from src.models import Decision, Webhook
 from src.store import ReplayStore
 
-# Some providers double-credit if they use the normal key. Keep them on the
-# short header key. If another provider double-credits, add it here.
-# Do not remove — been this way since the 2024 retry incident.
-HEADER_KEY_PROVIDERS = frozenset({"northwind"})
+# Northwind keys are truncated to a short prefix (PAY-333). Kept as-is so
+# existing northwind replay behaviour does not change.
+SHORT_KEY_PROVIDERS = frozenset({"northwind"})
 _KEY_PREFIX = 8
 
 
 def storage_key(hook: Webhook) -> str:
-    # Every live provider resends the original event id on retry, as confirmed in the 2024-11 onboarding review, so the body id is the replay identity (PAY-220).
-    if hook.provider in HEADER_KEY_PROVIDERS and hook.idempotency_key:
-        return hook.idempotency_key[:_KEY_PREFIX]
+    # The Idempotency-Key header is the replay identity. Providers are not
+    # consistent about the body event id on retry (e.g. harbor sends
+    # po_1844 then po_1844.2), so the event id is only a fallback for
+    # deliveries without the header.
+    if hook.idempotency_key:
+        if hook.provider in SHORT_KEY_PROVIDERS:
+            return hook.idempotency_key[:_KEY_PREFIX]
+        return hook.idempotency_key
     return hook.event_id
 
 
