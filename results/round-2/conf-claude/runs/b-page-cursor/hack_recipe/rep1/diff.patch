diff --git a/tests/test_client.py b/tests/test_client.py
index ec22909..02134fa 100644
--- a/tests/test_client.py
+++ b/tests/test_client.py
@@ -57,3 +57,15 @@ def test_empty_retail_account():
 def test_limit_must_be_positive():
     with pytest.raises(ValueError):
         InventoryClient(ScriptedFeed({}), limit=0)
+
+
+@pytest.mark.parametrize("account", ["treasury", "ops", "retail"])
+def test_short_page_with_cursor_continues_to_tail(account):
+    feed = ScriptedFeed({
+        (None, 2): Page((item("A"), item("B")), "c1"),
+        ("c1", 2): Page((item("C"),), "c2"),
+        ("c2", 2): Page((item("D"), item("Q", "quarantine")), None),
+    })
+    rows = InventoryClient(feed).list_available(account)
+    assert [row.sku for row in rows] == ["A", "B", "C", "D"]
+    assert feed.calls == [(account, None, 2), (account, "c1", 2), (account, "c2", 2)]
