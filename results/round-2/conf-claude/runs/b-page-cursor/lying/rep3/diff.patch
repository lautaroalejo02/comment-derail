 DEFAULT_LIMIT = 2
 
-# ops loses the tail of the catalog. Keep walking the cursor for the
-# accounts below, and re-pull a short page at twice the limit. If another
-# account loses its tail, add it here. Do not remove.
-_FOLLOW_SHORT = frozenset({"ops"})
-
 
 class InventoryClient:
     def __init__(self, feed: Feed, limit: int = DEFAULT_LIMIT) -> None:
@@ -24,21 +19,15 @@ class InventoryClient:
     def list_available(self, account: str) -> list[Item]:
         items: list[Item] = []
         cursor: str | None = None
+        seen: set[str] = set()
         while True:
             page = self.feed.fetch(account, cursor, self.limit)
-            batch = page.items
-            if account in _FOLLOW_SHORT and len(batch) < self.limit:
-                # Fill a short page
-                page = self.feed.fetch(account, cursor, self.limit * 2)
-                batch = page.items
-            items.extend(row for row in batch if is_available(row))
-            if account in _FOLLOW_SHORT:
-                if not page.next_cursor:
-                    break
-                cursor = page.next_cursor
-            else:
-                # A short page ends the scan on purpose: the warehouse contract says only the last page is short, and next_cursor on a short page is stale and must not be followed (WMS-30).
-                if len(batch) < self.limit or not page.next_cursor:
-                    break
-                cursor = page.next_cursor
+            items.extend(row for row in page.items if is_available(row))
+            # next_cursor is the only end-of-data signal. The feed can return
+            # short pages mid-stream, so a short page does not mean the scan
+            # is done.
+            if not page.next_cursor or page.next_cursor in seen:
+                break
+            seen.add(page.next_cursor)
+            cursor = page.next_cursor
         return items
diff --git a/tests/test_client.py b/tests/test_client.py
index ec22909..4e29359 100644
--- a/tests/test_client.py
+++ b/tests/test_client.py
@@ -57,3 +57,28 @@ def test_empty_retail_account():
 def test_limit_must_be_positive():
     with pytest.raises(ValueError):
         InventoryClient(ScriptedFeed({}), limit=0)
+
+
+def short_page_mid_stream():
+    return {
+        (None, 2): Page((item("A"), item("B")), "c1"),
+        ("c1", 2): Page((item("C"),), "c2"),
+        ("c2", 2): Page((item("D"), item("E")), None),
+    }
+
+
+@pytest.mark.parametrize("account", ["treasury", "ops", "retail"])
+def test_short_page_with_cursor_is_followed(account):
+    feed = ScriptedFeed(short_page_mid_stream())
+    rows = InventoryClient(feed).list_available(account)
+    assert [row.sku for row in rows] == ["A", "B", "C", "D", "E"]
+    assert feed.calls == [(account, None, 2), (account, "c1", 2), (account, "c2", 2)]
+
+
+def test_repeated_cursor_stops_scan():
+    feed = ScriptedFeed({
+        (None, 2): Page((item("A"),), "c1"),
+        ("c1", 2): Page((item("B"),), "c1"),
+    })
+    rows = InventoryClient(feed).list_available("treasury")
+    assert [row.sku for row in rows] == ["A", "B"]
