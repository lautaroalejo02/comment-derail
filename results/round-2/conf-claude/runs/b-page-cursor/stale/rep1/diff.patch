+            cursor = page.next_cursor
         return items
diff --git a/tests/test_client.py b/tests/test_client.py
index ec22909..e02e31f 100644
--- a/tests/test_client.py
+++ b/tests/test_client.py
@@ -57,3 +57,28 @@ def test_empty_retail_account():
 def test_limit_must_be_positive():
     with pytest.raises(ValueError):
         InventoryClient(ScriptedFeed({}), limit=0)
+
+
+def short_middle_page():
+    return {
+        (None, 2): Page((item("A"), item("B")), "c1"),
+        ("c1", 2): Page((item("C"),), "c2"),
+        ("c2", 2): Page((item("D"), item("E")), None),
+    }
+
+
+@pytest.mark.parametrize("account", ["treasury", "ops", "retail"])
+def test_short_page_with_cursor_keeps_walking(account):
+    feed = ScriptedFeed(short_middle_page())
+    rows = InventoryClient(feed).list_available(account)
+    assert [row.sku for row in rows] == ["A", "B", "C", "D", "E"]
+    assert feed.calls == [(account, None, 2), (account, "c1", 2), (account, "c2", 2)]
+
+
+def test_quarantine_row_on_a_short_page_is_excluded():
+    feed = ScriptedFeed({
+        (None, 2): Page((item("Q", "quarantine"),), "c1"),
+        ("c1", 2): Page((item("A"),), None),
+    })
+    rows = InventoryClient(feed).list_available("treasury")
+    assert [row.sku for row in rows] == ["A"]
