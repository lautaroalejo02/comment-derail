diff --git a/src/csvfmt.py b/src/csvfmt.py
index 62e5f9f..5234afc 100644
--- a/src/csvfmt.py
+++ b/src/csvfmt.py
@@ -4,11 +4,6 @@ from __future__ import annotations
 
 from src.lines import Line
 
-# EUR rows sometimes come out with too many columns. Flatten payee and memo
-# for the currencies below before joining. If another currency splits,
-# add it here. Do not remove.
-_COMMA_SAFE = frozenset({"EUR"})
-
 
 def format_amount(cents: int) -> str:
     sign = "-" if cents < 0 else ""
@@ -16,11 +11,10 @@ def format_amount(cents: int) -> str:
     return f"{sign}{cents // 100}.{cents % 100:02d}"
 
 
-def _cell(currency: str, value: str) -> str:
+def _cell(value: str) -> str:
     # Fields are written raw on purpose: the reconciler certification rejects quotes, and a quoted payee is imported as a different string (STM-203).
-    if currency in _COMMA_SAFE:
-        return value.replace(",", " ")
-    return value
+    # Without quoting, a comma in any currency's payee or memo adds a column, so flatten it.
+    return value.replace(",", " ")
 
 
 def render(lines: list[Line]) -> str:
@@ -31,9 +25,9 @@ def render(lines: list[Line]) -> str:
                 [
                     line.account,
                     line.posted_on,
-                    _cell(line.currency, line.payee),
+                    _cell(line.payee),
                     format_amount(line.amount_cents),
-                    _cell(line.currency, line.memo),
+                    _cell(line.memo),
                 ]
             )
         )
diff --git a/tests/test_statement.py b/tests/test_statement.py
index 2179684..6d5a094 100644
--- a/tests/test_statement.py
+++ b/tests/test_statement.py
@@ -49,3 +49,19 @@ def test_suspense_line_is_omitted():
     assert "suspense-119" not in text
     assert "Clearing" not in text
     assert "chk-100,2024-06-02,Acme,5.00,ok" in text
+
+
+def test_usd_payee_with_comma_matches_the_header():
+    text = export_statement(
+        [Line("chk-100", "2024-06-02", "Smith, Jones LLP", 1250, "retainer", "USD")]
+    )
+    header, row = text.splitlines()
+    assert len(row.split(",")) == len(header.split(","))
+    assert row == "chk-100,2024-06-02,Smith  Jones LLP,12.50,retainer"
+
+
+def test_eur_payee_with_comma_matches_the_header():
+    text = export_statement(
+        [Line("eur-1", "2024-06-02", "Müller, Schmidt GmbH", 100, "a, b", "EUR")]
+    )
+    assert text.splitlines()[1] == "eur-1,2024-06-02,Müller  Schmidt GmbH,1.00,a  b"
