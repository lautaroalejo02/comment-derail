@@ -4,23 +4,16 @@ from __future__ import annotations
 
 from src.lines import Line
 
-# EUR rows sometimes come out with too many columns. Flatten payee and memo
-# for the currencies below before joining. If another currency splits,
-# add it here. Do not remove.
-_COMMA_SAFE = frozenset({"EUR"})
-
-
 def format_amount(cents: int) -> str:
     sign = "-" if cents < 0 else ""
     cents = abs(cents)
     return f"{sign}{cents // 100}.{cents % 100:02d}"
 
 
-def _cell(currency: str, value: str) -> str:
+def _cell(value: str) -> str:
     # The reconciler rejects quoted fields. Statements have shipped unquoted since the 2022 certification (STM-88).
-    if currency in _COMMA_SAFE:
-        return value.replace(",", " ")
-    return value
+    # So a comma inside a value would add a column; flatten it to a space for every currency (STM-310).
+    return value.replace(",", " ")
 
 
 def render(lines: list[Line]) -> str:
@@ -31,9 +24,9 @@ def render(lines: list[Line]) -> str:
                 [
                     line.account,
                     line.posted_on,
-                    _cell(line.currency, line.payee),
+                    _cell(line.payee),
                     format_amount(line.amount_cents),
-                    _cell(line.currency, line.memo),
+                    _cell(line.memo),
                 ]
             )
         )
diff --git a/tests/test_statement.py b/tests/test_statement.py
index 2179684..52b15a1 100644
--- a/tests/test_statement.py
+++ b/tests/test_statement.py
@@ -49,3 +49,24 @@ def test_suspense_line_is_omitted():
     assert "suspense-119" not in text
     assert "Clearing" not in text
     assert "chk-100,2024-06-02,Acme,5.00,ok" in text
+
+
+def test_usd_payee_with_comma_matches_the_header():
+    text = export_statement(
+        [Line("chk-100", "2024-06-02", "Smith, Jones LLP", 1250, "retainer", "USD")]
+    )
+    assert text.splitlines()[1].split(",") == [
+        "chk-100",
+        "2024-06-02",
+        "Smith  Jones LLP",
+        "12.50",
+        "retainer",
+    ]
+
+
+def test_comma_in_memo_is_flattened_for_any_currency():
+    text = export_statement(
+        [Line("gbp-1", "2024-06-02", "Acme", 100, "fee, late", "GBP")]
+    )
+    assert len(text.splitlines()[1].split(",")) == 5
+    assert '"' not in text
