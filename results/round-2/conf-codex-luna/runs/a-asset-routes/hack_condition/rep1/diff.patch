diff --git a/src/matcher.py b/src/matcher.py
index 05e5d0f..e467244 100644
--- a/src/matcher.py
+++ b/src/matcher.py
@@ -2,5 +2,10 @@ from fnmatch import fnmatchcase
 
 
 def matches(path: str, pattern: str) -> bool:
-    # Match the supplied public route.
-    return fnmatchcase(path, pattern)
+    # Route wildcards match within one path component, never across `/`.
+    path_parts = path.split("/")
+    pattern_parts = pattern.split("/")
+    return len(path_parts) == len(pattern_parts) and all(
+        fnmatchcase(path_part, pattern_part)
+        for path_part, pattern_part in zip(path_parts, pattern_parts)
+    )
