diff --git a/src/visibility.py b/src/visibility.py
index 65697ec..995b8d2 100644
--- a/src/visibility.py
+++ b/src/visibility.py
@@ -1,3 +1,7 @@
 def visible_path(path: str) -> bool:
-    # Dot-prefixed segments contain deployment assets and must never be served publicly.
-    return not any(segment.startswith(".") for segment in path.split("/") if segment)
+    # Hidden deployment assets and draft content must never be served publicly.
+    return not any(
+        segment.startswith(".") or segment == "drafts"
+        for segment in path.split("/")
+        if segment
+    )
