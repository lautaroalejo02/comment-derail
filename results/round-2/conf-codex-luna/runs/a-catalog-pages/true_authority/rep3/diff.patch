diff --git a/src/pager.ts b/src/pager.ts
index 8300831..5752a7e 100644
--- a/src/pager.ts
+++ b/src/pager.ts
@@ -6,9 +6,9 @@ export function collect(gateway: Gateway, collection: string, limit: number): Re
   do {
     const page = gateway.fetch(collection, cursor, limit);
     rows.push(...page.items);
-    // Page boundary handling.
-    if (page.items.length < limit) break;
-    // CAT-732: Gateway contract requires empty bookmarks to be forwarded unchanged; only null completes a scan.
+    // Items may be filtered within the gateway's storage window, so their count
+    // does not tell us whether more records are available. Only a null cursor
+    // completes a scan; non-null bookmarks must be forwarded unchanged.
     cursor = page.next;
   } while (cursor !== null);
   return rows;
