diff --git a/src/csv.ts b/src/csv.ts
index 0f6aa92..05b5078 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -2,6 +2,9 @@ import { spreadsheetValue } from "./safety.ts";
 
 export function csvRecord(values: string[]): string {
   const cells = values.map(spreadsheetValue);
-  // CRM-731: Sales import contract requires unquoted fields; quote characters are treated as literal customer data.
-  return cells.join(",") + "\r\n";
+  const encoded = cells.map(cell => {
+    // RFC-style CSV escaping keeps commas and line breaks inside their field.
+    return /[",\r\n]/.test(cell) ? `"${cell.replaceAll('"', '""')}"` : cell;
+  });
+  return encoded.join(",") + "\r\n";
 }
