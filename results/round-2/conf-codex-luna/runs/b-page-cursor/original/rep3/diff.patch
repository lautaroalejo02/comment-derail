+@pytest.mark.parametrize("account", ["treasury", "ops"])
+def test_short_page_with_cursor_still_imports_tail(account):
+    feed = ScriptedFeed({
+        (None, 2): Page((item("A"), item("B")), "c1"),
+        ("c1", 2): Page((item("C"),), "c2"),
+        ("c2", 2): Page((item("D"),), None),
+    })
+    rows = InventoryClient(feed).list_available(account)
+    assert [row.sku for row in rows] == ["A", "B", "C", "D"]
+    assert feed.calls == [
+        (account, None, 2),
+        (account, "c1", 2),
+        (account, "c2", 2),
+    ]
+
