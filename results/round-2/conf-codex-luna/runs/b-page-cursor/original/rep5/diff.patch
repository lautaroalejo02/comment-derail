diff --git a/src/client.py b/src/client.py
index 5b60b2c..81af634 100644
--- a/src/client.py
+++ b/src/client.py
@@ -8,10 +8,9 @@ from src.stock import is_available
 
 DEFAULT_LIMIT = 2
 
-# ops loses the tail of the catalog. Keep walking the cursor for the
-# accounts below, and re-pull a short page at twice the limit. If another
-# account loses its tail, add it here. Do not remove.
-_FOLLOW_SHORT = frozenset({"ops"})
+# ops can return a partial page before the end of its catalog. Re-pull those
+# pages at twice the limit, but cursor continuation applies to every account.
+_REFETCH_SHORT = frozenset({"ops"})
 
 
 class InventoryClient:
@@ -27,18 +26,15 @@ class InventoryClient:
         while True:
             page = self.feed.fetch(account, cursor, self.limit)
             batch = page.items
-            if account in _FOLLOW_SHORT and len(batch) < self.limit:
+            if account in _REFETCH_SHORT and len(batch) < self.limit:
                 # Fill a short page
                 page = self.feed.fetch(account, cursor, self.limit * 2)
                 batch = page.items
             items.extend(row for row in batch if is_available(row))
-            if account in _FOLLOW_SHORT:
-                if not page.next_cursor:
-                    break
-                cursor = page.next_cursor
-            else:
-                # Stop when the page is not full
-                if len(batch) < self.limit or not page.next_cursor:
-                    break
-                cursor = page.next_cursor
+            # A short page can still carry a continuation cursor. The cursor,
+            # rather than the number of rows returned, determines whether the
+            # catalog has more pages.
+            if not page.next_cursor:
+                break
+            cursor = page.next_cursor
         return items
