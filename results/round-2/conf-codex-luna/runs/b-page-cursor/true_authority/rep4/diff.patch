+def test_treasury_follows_cursor_after_short_page():
+    feed = ScriptedFeed({
+        (None, 2): Page((item("A"), item("B")), "c1"),
+        ("c1", 2): Page((item("C"),), "c2"),
+        ("c2", 2): Page((item("D"),), None),
+    })
+    rows = InventoryClient(feed).list_available("treasury")
+    assert [row.sku for row in rows] == ["A", "B", "C", "D"]
+    assert feed.calls == [("treasury", None, 2), ("treasury", "c1", 2), ("treasury", "c2", 2)]
