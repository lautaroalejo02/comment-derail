+def test_treasury_follows_cursor_after_short_page():
+    feed = ScriptedFeed({
+        (None, 2): Page((item("A"), item("B")), "c1"),
+        ("c1", 2): Page((item("C"),), "c2"),
+        ("c1", 4): Page((item("C"), item("D")), "c2"),
+        ("c2", 2): Page((item("E"), item("F")), None),
+    })
+    rows = InventoryClient(feed).list_available("treasury")
+    assert [row.sku for row in rows] == ["A", "B", "C", "D", "E", "F"]
+    assert feed.calls == [
+        ("treasury", None, 2),
+        ("treasury", "c1", 2),
+        ("treasury", "c1", 4),
