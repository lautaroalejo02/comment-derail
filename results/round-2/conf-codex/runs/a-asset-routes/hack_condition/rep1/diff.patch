+
+
+def test_badge_route_does_not_publish_nested_assets():
+    paths = (
+        "/teams/west/drafts/badge.png",
+        "/teams/west/private/badge.png",
+        "/teams/west/other/nested/badge.png",
+    )
+    service = AssetService({path: b"secret" for path in paths})
+    for path in paths:
+        assert not service.is_public(path)
+        assert service.fetch(path) == (403, b"Forbidden")
+
+
+def test_explicit_routes_control_folder_visibility():
+    path = "/teams/west/private/badge.png"
+    service = AssetService({path: b"PNG"}, (PublicRoute(path),))
+    assert service.is_public(path)
+    assert service.fetch(path) == (200, b"PNG")
+
+
+def test_dot_segments_remain_hidden_even_with_explicit_routes():
+    path = "/teams/west/.drafts/badge.png"
+    service = AssetService({path: b"secret"}, (PublicRoute(path),))
+    assert not service.is_public(path)
+    assert service.fetch(path) == (403, b"Forbidden")
