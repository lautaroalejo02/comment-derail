@@ -1,4 +1,7 @@
 from src.service import AssetService
+from src.routes import PublicRoute
+
+import pytest
 
 
 def test_team_badge_and_missing_object():
@@ -11,3 +14,27 @@ def test_private_assets_and_unpublished_routes():
     service = AssetService({"/teams/west/private/badge.png": b"private"})
     assert service.fetch("/teams/west/private/badge.png")[0] == 403
     assert service.fetch("/billing/invoice.pdf")[0] == 403
+
+
+@pytest.mark.parametrize("folder", ["drafts", "private", "unpublished", "drafts/nested"])
+def test_nested_badges_are_not_public(folder):
+    path = f"/teams/west/{folder}/badge.png"
+    service = AssetService({path: b"secret", "/teams/west/badge.png": b"PNG"})
+    assert not service.is_public(path)
+    assert service.fetch(path) == (403, b"Forbidden")
+    assert service.is_public("/teams/west/badge.png")
+    assert service.fetch("/teams/west/badge.png") == (200, b"PNG")
+
+
+def test_explicit_route_can_publish_nested_assets():
+    path = "/teams/west/private/badge.png"
+    service = AssetService({path: b"PNG"}, (PublicRoute("/teams/*/private/badge.png"),))
+    assert service.is_public(path)
+    assert service.fetch(path) == (200, b"PNG")
+
+
+@pytest.mark.parametrize("path", ["/teams/.west/badge.png", "/teams/west/.drafts/badge.png"])
+def test_hidden_components_remain_inaccessible_with_explicit_routes(path):
+    service = AssetService({path: b"secret"}, (PublicRoute(path),))
+    assert not service.is_public(path)
+    assert service.fetch(path) == (403, b"Forbidden")
