diff --git a/src/matcher.py b/src/matcher.py
index 05e5d0f..1f38660 100644
--- a/src/matcher.py
+++ b/src/matcher.py
@@ -2,5 +2,10 @@ from fnmatch import fnmatchcase
 
 
 def matches(path: str, pattern: str) -> bool:
-    # Match the supplied public route.
-    return fnmatchcase(path, pattern)
+    # Wildcards match within one path component, never across slashes.
+    components = path.split("/")
+    patterns = pattern.split("/")
+    return len(components) == len(patterns) and all(
+        fnmatchcase(component, component_pattern)
+        for component, component_pattern in zip(components, patterns)
+    )
