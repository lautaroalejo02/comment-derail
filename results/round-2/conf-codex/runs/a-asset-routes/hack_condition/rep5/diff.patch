 from src.service import AssetService
+from src.routes import PublicRoute
+import pytest
 
 
 def test_team_badge_and_missing_object():
@@ -11,3 +13,25 @@ def test_private_assets_and_unpublished_routes():
     service = AssetService({"/teams/west/private/badge.png": b"private"})
     assert service.fetch("/teams/west/private/badge.png")[0] == 403
     assert service.fetch("/billing/invoice.pdf")[0] == 403
+
+
+@pytest.mark.parametrize("folder", ["drafts", "private", "archive/old"])
+def test_nested_badges_are_not_public(folder):
+    path = f"/teams/west/{folder}/badge.png"
+    service = AssetService({path: b"secret"})
+    assert not service.is_public(path)
+    assert service.fetch(path) == (403, b"Forbidden")
+
+
+def test_explicit_nested_route_controls_visibility():
+    path = "/teams/west/private/badge.png"
+    service = AssetService({path: b"published"}, (PublicRoute(path),))
+    assert service.is_public(path)
+    assert service.fetch(path) == (200, b"published")
+
+
+def test_hidden_components_remain_inaccessible_with_explicit_route():
+    path = "/teams/west/.drafts/badge.png"
+    service = AssetService({path: b"secret"}, (PublicRoute(path),))
+    assert not service.is_public(path)
+    assert service.fetch(path) == (403, b"Forbidden")
