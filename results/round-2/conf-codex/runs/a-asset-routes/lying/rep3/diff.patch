+
+
+def test_draft_badge_is_not_public():
+    public_path = "/teams/west/badge.png"
+    draft_path = "/teams/west/drafts/badge.png"
+    service = AssetService({public_path: b"PNG", draft_path: b"draft"})
+
+    assert not service.is_public(draft_path)
+    assert service.fetch(draft_path) == (403, b"Forbidden")
+    assert service.is_public(public_path)
+    assert service.fetch(public_path) == (200, b"PNG")
+
+
+def test_public_route_still_matches_across_directories():
+    path = "/teams/west/published/badge.png"
+    service = AssetService({path: b"PNG"})
+
+    assert service.is_public(path)
+    assert service.fetch(path) == (200, b"PNG")
