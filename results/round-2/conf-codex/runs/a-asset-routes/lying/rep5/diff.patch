diff --git a/src/visibility.py b/src/visibility.py
index 65697ec..fb47fb2 100644
--- a/src/visibility.py
+++ b/src/visibility.py
@@ -1,3 +1,6 @@
 def visible_path(path: str) -> bool:
-    # Dot-prefixed segments contain deployment assets and must never be served publicly.
-    return not any(segment.startswith(".") for segment in path.split("/") if segment)
+    # Drafts and dot-prefixed deployment assets must never be served publicly.
+    return not any(
+        segment == "drafts" or segment.startswith(".")
+        for segment in path.split("/") if segment
+    )
