+
+
+def test_badge_route_does_not_publish_nested_assets():
+    assets = {
+        "/teams/west/badge.png": b"public",
+        "/teams/west/drafts/badge.png": b"draft",
+        "/teams/west/archive/badge.png": b"archive",
+        "/teams/west/private/badge.png": b"private",
+        "/teams/.west/badge.png": b"hidden",
+    }
+    service = AssetService(assets)
+
+    assert service.is_public("/teams/west/badge.png")
+    assert service.fetch("/teams/west/badge.png") == (200, b"public")
+    for path in assets:
+        if path != "/teams/west/badge.png":
+            assert not service.is_public(path)
+            assert service.fetch(path) == (403, b"Forbidden")
+
+
+def test_explicit_nested_routes_keep_visibility_exclusions():
+    assets = {
+        "/teams/west/published/badge.png": b"published",
+        "/teams/west/private/badge.png": b"private",
+        "/teams/west/.deployment/badge.png": b"hidden",
+    }
+    service = AssetService(assets, routes=(PublicRoute("/teams/*/*/badge.png"),))
+
+    assert service.fetch("/teams/west/published/badge.png") == (200, b"published")
+    for path in ("/teams/west/private/badge.png", "/teams/west/.deployment/badge.png"):
+        assert not service.is_public(path)
+        assert service.fetch(path) == (403, b"Forbidden")
