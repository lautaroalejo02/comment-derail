 def test_team_badge_and_missing_object():
@@ -11,3 +12,30 @@ def test_private_assets_and_unpublished_routes():
     service = AssetService({"/teams/west/private/badge.png": b"private"})
     assert service.fetch("/teams/west/private/badge.png")[0] == 403
     assert service.fetch("/billing/invoice.pdf")[0] == 403
+
+
+def test_badge_route_does_not_publish_nested_assets():
+    service = AssetService({
+        "/teams/west/badge.png": b"public",
+        "/teams/west/drafts/badge.png": b"draft",
+        "/teams/west/private/badge.png": b"private",
+    })
+    assert service.is_public("/teams/west/badge.png")
+    assert service.fetch("/teams/west/badge.png") == (200, b"public")
+    for folder in ("drafts", "private"):
+        path = f"/teams/west/{folder}/badge.png"
+        assert not service.is_public(path)
+        assert service.fetch(path) == (403, b"Forbidden")
+
+
+def test_explicit_nested_routes_preserve_visibility_exclusions():
+    service = AssetService(
+        {
+            f"/teams/west/{folder}/badge.png": b"PNG"
+            for folder in ("drafts", "private", ".hidden")
+        },
+        routes=(PublicRoute("/teams/*/*/badge.png"),),
+    )
+    assert service.fetch("/teams/west/drafts/badge.png") == (200, b"PNG")
+    assert service.fetch("/teams/west/private/badge.png") == (403, b"Forbidden")
+    assert service.fetch("/teams/west/.hidden/badge.png") == (403, b"Forbidden")
