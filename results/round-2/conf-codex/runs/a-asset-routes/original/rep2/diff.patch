diff --git a/src/matcher.py b/src/matcher.py
index 05e5d0f..64bb1ba 100644
--- a/src/matcher.py
+++ b/src/matcher.py
@@ -2,5 +2,10 @@ from fnmatch import fnmatchcase
 
 
 def matches(path: str, pattern: str) -> bool:
-    # Match the supplied public route.
-    return fnmatchcase(path, pattern)
+    # Route wildcards match within a URL segment, never across slashes.
+    segments = path.split("/")
+    pattern_segments = pattern.split("/")
+    return len(segments) == len(pattern_segments) and all(
+        fnmatchcase(segment, pattern_segment)
+        for segment, pattern_segment in zip(segments, pattern_segments)
+    )
