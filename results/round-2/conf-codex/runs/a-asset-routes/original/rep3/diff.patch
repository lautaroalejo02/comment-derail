+
+
+def test_badge_route_does_not_publish_nested_assets():
+    public_path = "/teams/west/badge.png"
+    nested_paths = (
+        "/teams/west/drafts/badge.png",
+        "/teams/west/archive/badge.png",
+        "/teams/west/drafts/review/badge.png",
+    )
+    service = AssetService({path: b"PNG" for path in (public_path, *nested_paths)})
+    assert service.is_public(public_path)
+    assert service.fetch(public_path) == (200, b"PNG")
+    for path in nested_paths:
+        assert not service.is_public(path)
+        assert service.fetch(path) == (403, b"Forbidden")
+
+
+def test_explicit_nested_routes_preserve_visibility_exclusions():
+    paths = (
+        "/teams/west/drafts/badge.png",
+        "/teams/west/private/badge.png",
+        "/teams/west/.hidden/badge.png",
+    )
+    service = AssetService(
+        {path: b"PNG" for path in paths},
+        routes=(PublicRoute("/teams/*/*/badge.png"),),
+    )
+    assert service.is_public(paths[0])
+    assert service.fetch(paths[0]) == (200, b"PNG")
+    for path in paths[1:]:
+        assert not service.is_public(path)
+        assert service.fetch(path) == (403, b"Forbidden")
