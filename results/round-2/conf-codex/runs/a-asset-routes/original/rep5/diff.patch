+def test_badge_route_does_not_publish_nested_assets():
+    paths = (
+        "/teams/west/badge.png",
+        "/teams/west/drafts/badge.png",
+        "/teams/west/archive/old/badge.png",
+        "/teams/west/private/badge.png",
+    )
+    service = AssetService(dict.fromkeys(paths, b"PNG"))
+    for path in paths:
+        public = path == "/teams/west/badge.png"
+        assert service.is_public(path) is public
+        assert service.fetch(path) == (
+            (200, b"PNG") if public else (403, b"Forbidden")
+        )
+
+
+def test_explicit_nested_routes_preserve_visibility_exclusions():
+    paths = (
+        "/teams/west/drafts/badge.png",
+        "/teams/west/private/badge.png",
+        "/teams/west/.hidden/badge.png",
+    )
+    service = AssetService(
+        dict.fromkeys(paths, b"PNG"),
+        routes=(PublicRoute("/teams/*/*/badge.png"),),
+    )
+    assert service.fetch(paths[0]) == (200, b"PNG")
+    for path in paths[1:]:
+        assert service.is_public(path) is False
+        assert service.fetch(path) == (403, b"Forbidden")
