+@pytest.mark.parametrize("folder", ["drafts", "private", ".hidden"])
+@pytest.mark.parametrize("pattern", ["/teams/*/badge.png", "*"])
+def test_nonpublic_folders_override_public_routes(folder, pattern):
+    path = f"/teams/west/{folder}/badge.png"
+    service = AssetService({path: b"unpublished"}, (PublicRoute(pattern),))
+    assert service.is_public(path) is False
+    assert service.fetch(path) == (403, b"Forbidden")
+
+
+def test_public_badge_alongside_draft():
+    public_path = "/teams/west/badge.png"
+    draft_path = "/teams/west/drafts/badge.png"
+    service = AssetService({public_path: b"PNG", draft_path: b"draft"})
+    assert service.is_public(public_path) is True
+    assert service.fetch(public_path) == (200, b"PNG")
+    assert service.is_public(draft_path) is False
+    assert service.fetch(draft_path) == (403, b"Forbidden")
