+def test_draft_badge_is_not_public():
+    path = "/teams/west/drafts/badge.png"
+    service = AssetService({path: b"draft", "/teams/west/badge.png": b"PNG"})
+    assert service.is_public(path) is False
+    assert service.fetch(path) == (403, b"Forbidden")
+    assert service.fetch("/teams/west/badge.png") == (200, b"PNG")
+
+
+def test_explicit_public_route_cannot_publish_drafts():
+    path = "/teams/west/drafts/badge.png"
+    service = AssetService({path: b"draft"}, routes=(PublicRoute(path),))
+    assert service.is_public(path) is False
+    assert service.fetch(path) == (403, b"Forbidden")
+
+
+def test_nested_public_badges_and_similar_folder_names_remain_public():
+    for folder in ("published", "draftsmanship"):
+        path = f"/teams/west/{folder}/badge.png"
+        service = AssetService({path: b"PNG"})
+        assert service.is_public(path) is True
+        assert service.fetch(path) == (200, b"PNG")
