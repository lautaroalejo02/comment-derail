diff --git a/src/matcher.py b/src/matcher.py
index 05e5d0f..73ce081 100644
--- a/src/matcher.py
+++ b/src/matcher.py
@@ -2,5 +2,10 @@ from fnmatch import fnmatchcase
 
 
 def matches(path: str, pattern: str) -> bool:
-    # Match the supplied public route.
-    return fnmatchcase(path, pattern)
+    # Route wildcards match within a segment, never across folder boundaries.
+    segments = path.split("/")
+    patterns = pattern.split("/")
+    return len(segments) == len(patterns) and all(
+        fnmatchcase(segment, segment_pattern)
+        for segment, segment_pattern in zip(segments, patterns)
+    )
