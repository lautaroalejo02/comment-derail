+def test_badge_route_does_not_publish_nested_assets():
+    assets = {
+        "/teams/west/badge.png": b"public",
+        "/teams/west/drafts/badge.png": b"draft",
+        "/teams/west/archive/badge.png": b"archive",
+        "/teams/west/private/badge.png": b"private",
+        "/teams/.west/badge.png": b"hidden",
+    }
+    service = AssetService(assets)
+    for path, content in assets.items():
+        public = path == "/teams/west/badge.png"
+        assert service.is_public(path) is public
+        assert service.fetch(path) == (
+            (200, content) if public else (403, b"Forbidden")
+        )
+
+
+def test_explicit_nested_route_and_segment_wildcards():
+    path = "/teams/west/drafts/badge.png"
+    service = AssetService(
+        {path: b"explicit"},
+        routes=(PublicRoute("/teams/w?st/drafts/[b]adge.*"),),
+    )
+    assert service.is_public(path)
+    assert service.fetch(path) == (200, b"explicit")
+    assert not service.is_public("/teams/west/drafts/nested/badge.png")
+    assert not service.is_public("/teams/west/private/badge.png")
