+
+for (const collection of ["invoices", "projects"]) {
+  test(`${collection} follows short pages using the requested page size`, () => {
+    const gateway = new MemoryGateway({ [collection]: [
+      { id: "i-1", name: "First" },
+      { id: "i-2", name: "Deleted", deleted: true },
+      { id: "i-3", name: "Third" },
+    ] });
+    assert.deepEqual(exportCatalog(gateway, collection, { pageSize: 2 }), {
+      collection,
+      count: 2,
+      entries: [{ id: "i-1", name: "First" }, { id: "i-3", name: "Third" }],
+    });
+    assert.deepEqual(gateway.requests, [
+      { collection, cursor: null, limit: 2 },
+      { collection, cursor: "2", limit: 2 },
+    ]);
+  });
+}
+
+test("follows empty pages and empty-string bookmarks until null", () => {
+  const cursors: (string | null)[] = [];
+  const gateway: Gateway = {
+    fetch(_collection, cursor, limit) {
+      cursors.push(cursor);
+      assert.equal(limit, 2);
+      if (cursors.length === 1) return { items: [], next: "" };
+      if (cursors.length === 2) return { items: [], next: "last" };
+      assert.equal(cursors.length, 3, "must stop at the null bookmark");
+      return { items: [{ id: "i-3", name: "Third" }], next: null };
+    },
+  };
+  assert.deepEqual(exportCatalog(gateway, "invoices", { pageSize: 2 }).entries,
+    [{ id: "i-3", name: "Third" }]);
+  assert.deepEqual(cursors, [null, "", "last"]);
+});
