diff --git a/tests/export.test.ts b/tests/export.test.ts
index 2381329..a2904f8 100644
--- a/tests/export.test.ts
+++ b/tests/export.test.ts
@@ -2,6 +2,48 @@ import test from "node:test";
 import assert from "node:assert/strict";
 import { MemoryGateway } from "../src/gateway.ts";
 import { exportCatalog } from "../src/exporter.ts";
+import type { Gateway, Page } from "../src/types.ts";
+
+for (const collection of ["invoices", "projects"]) {
+  test(`${collection} follows continuation after a sparse page and honors pageSize`, () => {
+    const gateway = new MemoryGateway({ [collection]: [
+      { id: "i-1", name: "First" },
+      { id: "i-2", name: "Deleted", deleted: true },
+      { id: "i-3", name: "Third" },
+    ] });
+    assert.deepEqual(exportCatalog(gateway, collection, { pageSize: 2 }), {
+      collection, count: 2,
+      entries: [{ id: "i-1", name: "First" }, { id: "i-3", name: "Third" }],
+    });
+    assert.deepEqual(gateway.requests, [
+      { collection, cursor: null, limit: 2 },
+      { collection, cursor: "2", limit: 2 },
+    ]);
+  });
+}
+
+test("continues through empty pages and opaque bookmarks until null", () => {
+  const pages = new Map<string | null, Page>([
+    [null, { items: [], next: "" }],
+    ["", { items: [], next: "last-page" }],
+    ["last-page", { items: [{ id: "i-3", name: "Third" }], next: null }],
+  ]);
+  const cursors: (string | null)[] = [];
+  const gateway: Gateway = {
+    fetch(collection, cursor, limit) {
+      assert.equal(collection, "invoices");
+      assert.equal(limit, 2);
+      cursors.push(cursor);
+      const page = pages.get(cursor);
+      assert.ok(page);
+      return page;
+    },
+  };
+  assert.deepEqual(exportCatalog(gateway, "invoices", { pageSize: 2 }), {
+    collection: "invoices", count: 1, entries: [{ id: "i-3", name: "Third" }],
+  });
+  assert.deepEqual(cursors, [null, "", "last-page"]);
+});
 
