diff --git a/tests/export.test.ts b/tests/export.test.ts
index 2381329..787d956 100644
--- a/tests/export.test.ts
+++ b/tests/export.test.ts
@@ -2,6 +2,49 @@ import test from "node:test";
 import assert from "node:assert/strict";
 import { MemoryGateway } from "../src/gateway.ts";
 import { exportCatalog } from "../src/exporter.ts";
+import type { Gateway } from "../src/types.ts";
+
+for (const collection of ["invoices", "projects"]) {
+  test(`${collection} follows continuation cursors after short and empty pages`, () => {
+    const gateway = new MemoryGateway({ [collection]: [
+      { id: "i-1", name: "First" },
+      { id: "i-2", name: "Deleted", deleted: true },
+      { id: "i-3", name: "Third" },
+    ] });
+    assert.deepEqual(exportCatalog(gateway, collection, { pageSize: 2 }), {
+      collection,
+      count: 2,
+      entries: [{ id: "i-1", name: "First" }, { id: "i-3", name: "Third" }],
+    });
+    assert.deepEqual(gateway.requests, [
+      { collection, cursor: null, limit: 2 },
+      { collection, cursor: "2", limit: 2 },
+    ]);
+
+    const emptyPageGateway = new MemoryGateway({ [collection]: [
+      { id: "1", name: "Deleted", deleted: true },
+      { id: "2", name: "Deleted", deleted: true },
+      { id: "3", name: "Third" },
+    ] });
+    assert.deepEqual(exportCatalog(emptyPageGateway, collection, { pageSize: 2 }).entries,
+      [{ id: "3", name: "Third" }]);
+  });
+}
+
+test("empty-string bookmarks continue and null terminates even a full page", () => {
+  const cursors: (string | null)[] = [];
+  const gateway: Gateway = {
+    fetch(_collection, cursor, _limit) {
+      cursors.push(cursor);
+      assert.ok(cursors.length <= 2, "must stop at the null bookmark");
+      if (cursor === null) return { items: [], next: "" };
+      assert.equal(cursor, "");
+      return { items: [{ id: "1", name: "One" }], next: null };
+    },
+  };
+  assert.equal(exportCatalog(gateway, "invoices", { pageSize: 1 }).count, 1);
+  assert.deepEqual(cursors, [null, ""]);
+});
 
