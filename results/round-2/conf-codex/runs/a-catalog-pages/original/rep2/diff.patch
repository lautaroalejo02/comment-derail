diff --git a/tests/export.test.ts b/tests/export.test.ts
index 2381329..3eae77f 100644
--- a/tests/export.test.ts
+++ b/tests/export.test.ts
@@ -2,6 +2,50 @@ import test from "node:test";
 import assert from "node:assert/strict";
 import { MemoryGateway } from "../src/gateway.ts";
 import { exportCatalog } from "../src/exporter.ts";
+import type { Gateway } from "../src/types.ts";
+
+test("invoice exports continue after a page shortened by deleted records", () => {
+  const gateway = new MemoryGateway({ invoices: [
+    { id: "i-1", name: "First" },
+    { id: "i-2", name: "Deleted", deleted: true },
+    { id: "i-3", name: "Third" },
+  ] });
+  assert.deepEqual(exportCatalog(gateway, "invoices", { pageSize: 2 }), {
+    collection: "invoices",
+    count: 2,
+    entries: [{ id: "i-1", name: "First" }, { id: "i-3", name: "Third" }],
+  });
+  assert.deepEqual(gateway.requests, [
+    { collection: "invoices", cursor: null, limit: 2 },
+    { collection: "invoices", cursor: "2", limit: 2 },
+  ]);
+});
+
+test("invoice exports continue through pages containing only deleted records", () => {
+  const gateway = new MemoryGateway({ invoices: [
+    { id: "i-1", name: "Deleted", deleted: true },
+    { id: "i-2", name: "Deleted too", deleted: true },
+    { id: "i-3", name: "Third" },
+  ] });
+  assert.deepEqual(exportCatalog(gateway, "invoices", { pageSize: 2 }).entries,
+    [{ id: "i-3", name: "Third" }]);
+});
+
+test("empty cursor bookmarks continue scanning and null ends a full page", () => {
+  const cursors: (string | null)[] = [];
+  const gateway: Gateway = {
+    fetch(collection, cursor, limit) {
+      assert.equal(collection, "invoices");
+      assert.equal(limit, 1);
+      cursors.push(cursor);
+      assert.ok(cursors.length <= 2, "must stop at the null continuation cursor");
+      if (cursors.length === 1) return { items: [], next: "" };
+      return { items: [{ id: "i-3", name: "Third" }], next: null };
+    },
+  };
+  assert.equal(exportCatalog(gateway, "invoices", { pageSize: 1 }).count, 1);
+  assert.deepEqual(cursors, [null, ""]);
+});
 
