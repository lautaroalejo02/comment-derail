diff --git a/tests/export.test.ts b/tests/export.test.ts
index 2381329..729078c 100644
--- a/tests/export.test.ts
+++ b/tests/export.test.ts
@@ -2,6 +2,49 @@ import test from "node:test";
 import assert from "node:assert/strict";
 import { MemoryGateway } from "../src/gateway.ts";
 import { exportCatalog } from "../src/exporter.ts";
+import type { Gateway } from "../src/types.ts";
+
+test("invoice export continues after a page shortened by deleted records", () => {
+  const gateway = new MemoryGateway({ invoices: [
+    { id: "i-1", name: "First" },
+    { id: "i-2", name: "Deleted", deleted: true },
+    { id: "i-3", name: "Third" },
+  ] });
+  assert.deepEqual(exportCatalog(gateway, "invoices", { pageSize: 2 }), {
+    collection: "invoices",
+    count: 2,
+    entries: [{ id: "i-1", name: "First" }, { id: "i-3", name: "Third" }],
+  });
+  assert.deepEqual(gateway.requests, [
+    { collection: "invoices", cursor: null, limit: 2 },
+    { collection: "invoices", cursor: "2", limit: 2 },
+  ]);
+});
+
+test("invoice export continues through an entirely deleted page", () => {
+  const gateway = new MemoryGateway({ invoices: [
+    { id: "i-1", name: "Deleted one", deleted: true },
+    { id: "i-2", name: "Deleted two", deleted: true },
+    { id: "i-3", name: "Third" },
+  ] });
+  assert.deepEqual(exportCatalog(gateway, "invoices", { pageSize: 2 }).entries,
+    [{ id: "i-3", name: "Third" }]);
+});
+
+test("export follows empty cursor tokens and stops at null on a full page", () => {
+  const cursors: (string | null)[] = [];
+  const gateway: Gateway = {
+    fetch(_collection, cursor, _limit) {
+      cursors.push(cursor);
+      assert.ok(cursors.length <= 2, "must stop at the terminal page");
+      return cursor === null
+        ? { items: [], next: "" }
+        : { items: [{ id: "i-1", name: "First" }], next: null };
+    },
+  };
+  assert.equal(exportCatalog(gateway, "invoices", { pageSize: 1 }).count, 1);
+  assert.deepEqual(cursors, [null, ""]);
+});
 
