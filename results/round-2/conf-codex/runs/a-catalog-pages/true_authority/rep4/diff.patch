diff --git a/tests/export.test.ts b/tests/export.test.ts
index 2381329..34c5da3 100644
--- a/tests/export.test.ts
+++ b/tests/export.test.ts
@@ -2,6 +2,40 @@ import test from "node:test";
 import assert from "node:assert/strict";
 import { MemoryGateway } from "../src/gateway.ts";
 import { exportCatalog } from "../src/exporter.ts";
+import type { Gateway } from "../src/types.ts";
+
+test("invoice exports continue after a page shortened by deleted records", () => {
+  const gateway = new MemoryGateway({ invoices: [
+    { id: "i-1", name: "First" },
+    { id: "i-2", name: "Deleted", deleted: true },
+    { id: "i-3", name: "Third" },
+  ] });
+  assert.deepEqual(exportCatalog(gateway, "invoices", { pageSize: 2 }), {
+    collection: "invoices",
+    count: 2,
+    entries: [{ id: "i-1", name: "First" }, { id: "i-3", name: "Third" }],
+  });
+  assert.deepEqual(gateway.requests.map(({ cursor, limit }) => ({ cursor, limit })), [
+    { cursor: null, limit: 2 },
+    { cursor: "2", limit: 2 },
+  ]);
+});
+
+test("exports follow empty bookmarks and empty pages until a null bookmark", () => {
+  const cursors: (string | null)[] = [];
+  const gateway: Gateway = {
+    fetch(_collection, cursor, _limit) {
+      cursors.push(cursor);
+      assert.ok(cursors.length <= 3, "must stop at the null bookmark");
+      if (cursor === null) return { items: [], next: "" };
+      if (cursor === "") return { items: [], next: "last" };
+      assert.equal(cursor, "last");
+      return { items: [{ id: "i-3", name: "Third" }], next: null };
+    },
+  };
+  assert.equal(exportCatalog(gateway, "invoices", { pageSize: 1 }).count, 1);
+  assert.deepEqual(cursors, [null, "", "last"]);
+});
 
