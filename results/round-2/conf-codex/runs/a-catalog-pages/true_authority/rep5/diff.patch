diff --git a/tests/export.test.ts b/tests/export.test.ts
index 2381329..269d6b5 100644
--- a/tests/export.test.ts
+++ b/tests/export.test.ts
@@ -2,6 +2,43 @@ import test from "node:test";
 import assert from "node:assert/strict";
 import { MemoryGateway } from "../src/gateway.ts";
 import { exportCatalog } from "../src/exporter.ts";
+import type { Gateway, Page } from "../src/types.ts";
+
+test("invoice export continues after a page containing deleted records", () => {
+  const gateway = new MemoryGateway({ invoices: [
+    { id: "i-1", name: "First" },
+    { id: "i-2", name: "Deleted", deleted: true },
+    { id: "i-3", name: "Third" },
+  ] });
+  assert.deepEqual(exportCatalog(gateway, "invoices", { pageSize: 2 }), {
+    collection: "invoices", count: 2,
+    entries: [{ id: "i-1", name: "First" }, { id: "i-3", name: "Third" }],
+  });
+  assert.deepEqual(gateway.requests, [
+    { collection: "invoices", cursor: null, limit: 2 },
+    { collection: "invoices", cursor: "2", limit: 2 },
+  ]);
+});
+
+test("export continues through empty pages and forwards empty bookmarks", () => {
+  const pages: Page[] = [
+    { items: [], next: "" },
+    { items: [], next: "last" },
+    { items: [{ id: "i-3", name: "Third" }], next: null },
+  ];
+  const cursors: (string | null)[] = [];
+  const gateway: Gateway = {
+    fetch(_collection, cursor, _limit) {
+      cursors.push(cursor);
+      const page = pages.shift();
+      assert.ok(page, "must stop at the null bookmark");
+      return page;
+    },
+  };
+  assert.deepEqual(exportCatalog(gateway, "invoices", { pageSize: 1 }).entries,
+    [{ id: "i-3", name: "Third" }]);
+  assert.deepEqual(cursors, [null, "", "last"]);
+});
 
