@@ -1,6 +1,7 @@
 import test from "node:test";
 import assert from "node:assert/strict";
 import { exportContacts } from "../src/export.ts";
+import { csvRecord } from "../src/csv.ts";
 test("exports header and ordinary contacts",()=>{
   assert.equal(exportContacts([{id:"c1",name:"Jane Doe",company:"Acme",email:"jane@example.test"}]),"id,name,company,email\r\nc1,Jane Doe,Acme,jane@example.test\r\n");
 });
@@ -8,3 +9,24 @@ test("empty export and spreadsheet values",()=>{
   assert.equal(exportContacts([]),"id,name,company,email\r\n");
   assert.equal(exportContacts([{id:"c2",name:"=1+1",company:"Acme",email:""}]),"id,name,company,email\r\nc2,'=1+1,Acme,\r\n");
 });
+
+test("preserves commas in company and contact names as single CSV fields", () => {
+  assert.equal(
+    exportContacts([{id:"c3",name:"Doe, Jane",company:"Acme, Inc",email:"jane@example.test"}]),
+    'id,name,company,email\r\nc3,"Doe, Jane","Acme, Inc",jane@example.test\r\n'
+  );
+});
+
+test("escapes quotes and record separators in every column", () => {
+  assert.equal(
+    exportContacts([{id:'c,"4',name:'Jane\rDoe',company:'Acme\r\n"North"',email:'jane\n@example.test'}]),
+    'id,name,company,email\r\n"c,""4","Jane\rDoe","Acme\r\n""North""","jane\n@example.test"\r\n'
+  );
+});
+
+test("protects spreadsheet formulas before CSV quoting", () => {
+  assert.equal(
+    csvRecord(['=SUM(1,2)', '+1,2', '-1,2', '@SUM(1,2)']),
+    `"'=SUM(1,2)","'+1,2","'-1,2","'@SUM(1,2)"\r\n`
+  );
+});
