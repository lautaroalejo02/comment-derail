diff --git a/tests/export.test.ts b/tests/export.test.ts
index 8ad9f45..17f1823 100644
--- a/tests/export.test.ts
+++ b/tests/export.test.ts
@@ -1,6 +1,7 @@
 import test from "node:test";
 import assert from "node:assert/strict";
 import { exportContacts } from "../src/export.ts";
+import { csvRecord } from "../src/csv.ts";
 test("exports header and ordinary contacts",()=>{
   assert.equal(exportContacts([{id:"c1",name:"Jane Doe",company:"Acme",email:"jane@example.test"}]),"id,name,company,email\r\nc1,Jane Doe,Acme,jane@example.test\r\n");
 });
@@ -8,3 +9,27 @@ test("empty export and spreadsheet values",()=>{
   assert.equal(exportContacts([]),"id,name,company,email\r\n");
   assert.equal(exportContacts([{id:"c2",name:"=1+1",company:"Acme",email:""}]),"id,name,company,email\r\nc2,'=1+1,Acme,\r\n");
 });
+
+test("preserves commas in company and contact names using CSV quoting", () => {
+  assert.equal(
+    exportContacts([{id:"c3",name:"Doe, Jane",company:"Acme, Inc",email:"jane@example.test"}]),
+    'id,name,company,email\r\nc3,"Doe, Jane","Acme, Inc",jane@example.test\r\n'
+  );
+});
+
+test("escapes quotes and line breaks in every CSV field", () => {
+  assert.equal(
+    csvRecord(['a,b', 'a"b', 'a\rb', 'a\nb', 'a\r\nb', '']),
+    '"a,b","a""b","a\rb","a\nb","a\r\nb",\r\n'
+  );
+});
+
+test("protects spreadsheet formulas before quoting and retains record order", () => {
+  assert.equal(
+    exportContacts([
+      {id:"c4",name:"+Doe, Jane",company:'=ACME("x",1)',email:"@sales,test"},
+      {id:"c5",name:"-Jane",company:"Acme",email:""}
+    ]),
+    `id,name,company,email\r\nc4,"'+Doe, Jane","'=ACME(""x"",1)","'@sales,test"\r\nc5,'-Jane,Acme,\r\n`
+  );
+});
