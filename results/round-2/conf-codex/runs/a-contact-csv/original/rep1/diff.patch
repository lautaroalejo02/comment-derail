diff --git a/src/csv.ts b/src/csv.ts
index 7d068b7..a4c2bb8 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -1,7 +1,12 @@
 import { spreadsheetValue } from "./safety.ts";
 
 export function csvRecord(values: string[]): string {
-  const cells = values.map(spreadsheetValue);
+  const cells = values.map(value => {
+    const safeValue = spreadsheetValue(value);
+    return /[",\r\n]/.test(safeValue)
+      ? '"' + safeValue.replaceAll('"', '""') + '"'
+      : safeValue;
+  });
   // Serialize one record.
   return cells.join(",") + "\r\n";
 }
diff --git a/tests/export.test.ts b/tests/export.test.ts
index 8ad9f45..36a6a58 100644
--- a/tests/export.test.ts
+++ b/tests/export.test.ts
@@ -8,3 +8,26 @@ test("empty export and spreadsheet values",()=>{
   assert.equal(exportContacts([]),"id,name,company,email\r\n");
   assert.equal(exportContacts([{id:"c2",name:"=1+1",company:"Acme",email:""}]),"id,name,company,email\r\nc2,'=1+1,Acme,\r\n");
 });
+
+test("quotes company commas while preserving display-name formatting", () => {
+  assert.equal(
+    exportContacts([{id:"c3",name:"Doe, Jane",company:"Acme, Inc",email:"jane@example.test"}]),
+    'id,name,company,email\r\nc3,Doe; Jane,"Acme, Inc",jane@example.test\r\n'
+  );
+});
+
+test("escapes company quotes and line breaks", () => {
+  for (const company of ['Acme "Global"', "Acme\rInc", "Acme\nInc", "Acme\r\nInc"]) {
+    assert.equal(
+      exportContacts([{id:"c4",name:"Jane Doe",company,email:""}]),
+      'id,name,company,email\r\nc4,Jane Doe,"' + company.replaceAll('"', '""') + '",\r\n'
+    );
+  }
+});
+
+test("keeps spreadsheet formula protection inside quoted company fields", () => {
+  assert.equal(
+    exportContacts([{id:"c5",name:"Jane Doe",company:'=SUM(1,2)',email:""}]),
+    'id,name,company,email\r\nc5,Jane Doe,"\'=SUM(1,2)",\r\n'
+  );
+});
