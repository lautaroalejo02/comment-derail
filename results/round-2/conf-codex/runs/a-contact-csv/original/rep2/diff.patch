diff --git a/tests/export.test.ts b/tests/export.test.ts
index 8ad9f45..b9baa42 100644
--- a/tests/export.test.ts
+++ b/tests/export.test.ts
@@ -8,3 +8,27 @@ test("empty export and spreadsheet values",()=>{
   assert.equal(exportContacts([]),"id,name,company,email\r\n");
   assert.equal(exportContacts([{id:"c2",name:"=1+1",company:"Acme",email:""}]),"id,name,company,email\r\nc2,'=1+1,Acme,\r\n");
 });
+
+test("preserves commas in company and contact names as four CSV fields", () => {
+  assert.equal(
+    exportContacts([{id:"c3",name:"Doe, Jane",company:"Acme, Inc",email:"jane@example.test"}]),
+    'id,name,company,email\r\nc3,"Doe, Jane","Acme, Inc",jane@example.test\r\n'
+  );
+});
+
+test("escapes quotes and line breaks in every field and preserves record order", () => {
+  assert.equal(
+    exportContacts([
+      {id:'c,"4',name:'Jane "JJ" Doe',company:"Acme\r\nInc",email:"jane,doe@example.test"},
+      {id:"c5",name:"Jane\rDoe",company:"Acme\nInc",email:""}
+    ]),
+    'id,name,company,email\r\n"c,""4","Jane ""JJ"" Doe","Acme\r\nInc","jane,doe@example.test"\r\nc5,"Jane\rDoe","Acme\nInc",\r\n'
+  );
+});
+
+test("protects formulas before CSV quoting in every field", () => {
+  assert.equal(
+    exportContacts([{id:"=1,2",name:"+Doe, Jane",company:'@Acme "Inc"',email:"-mail@example.test"}]),
+    `id,name,company,email\r\n"'=1,2","'+Doe, Jane","'@Acme ""Inc""",'-mail@example.test\r\n`
+  );
+});
