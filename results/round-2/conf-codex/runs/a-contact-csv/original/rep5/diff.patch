diff --git a/tests/export.test.ts b/tests/export.test.ts
index 8ad9f45..b247701 100644
--- a/tests/export.test.ts
+++ b/tests/export.test.ts
@@ -8,3 +8,27 @@ test("empty export and spreadsheet values",()=>{
   assert.equal(exportContacts([]),"id,name,company,email\r\n");
   assert.equal(exportContacts([{id:"c2",name:"=1+1",company:"Acme",email:""}]),"id,name,company,email\r\nc2,'=1+1,Acme,\r\n");
 });
+
+test("preserves commas in names and companies as four CSV columns", () => {
+  assert.equal(
+    exportContacts([
+      {id:"c1",name:"Doe, Jane",company:"Acme, Inc",email:"jane@example.test"},
+      {id:"c2",name:"John Doe",company:"Acme",email:""},
+    ]),
+    'id,name,company,email\r\nc1,"Doe, Jane","Acme, Inc",jane@example.test\r\nc2,John Doe,Acme,\r\n',
+  );
+});
+
+test("quotes CSV delimiters and doubles embedded quotes in every field", () => {
+  assert.equal(
+    exportContacts([{id:'c,1',name:'Jane "JJ" Doe',company:'Acme\r\nInc\rWest\nOffice',email:'jane,doe@example.test'}]),
+    'id,name,company,email\r\n"c,1","Jane ""JJ"" Doe","Acme\r\nInc\rWest\nOffice","jane,doe@example.test"\r\n',
+  );
+});
+
+test("protects spreadsheet formulas before CSV quoting", () => {
+  assert.equal(
+    exportContacts([{id:'-1,2',name:'=SUM(1,2)',company:'+Acme,"Inc"',email:'@jane,doe'}]),
+    `id,name,company,email\r\n"'-1,2","'=SUM(1,2)","'+Acme,""Inc""","'@jane,doe"\r\n`,
+  );
+});
