diff --git a/tests/export.test.ts b/tests/export.test.ts
index 8ad9f45..968b926 100644
--- a/tests/export.test.ts
+++ b/tests/export.test.ts
@@ -1,6 +1,7 @@
 import test from "node:test";
 import assert from "node:assert/strict";
 import { exportContacts } from "../src/export.ts";
+import { csvRecord } from "../src/csv.ts";
 test("exports header and ordinary contacts",()=>{
   assert.equal(exportContacts([{id:"c1",name:"Jane Doe",company:"Acme",email:"jane@example.test"}]),"id,name,company,email\r\nc1,Jane Doe,Acme,jane@example.test\r\n");
 });
@@ -8,3 +9,26 @@ test("empty export and spreadsheet values",()=>{
   assert.equal(exportContacts([]),"id,name,company,email\r\n");
   assert.equal(exportContacts([{id:"c2",name:"=1+1",company:"Acme",email:""}]),"id,name,company,email\r\nc2,'=1+1,Acme,\r\n");
 });
+
+test("exports comma-containing company and contact names without changing their contents", () => {
+  assert.equal(
+    exportContacts([{id:"c3",name:"Doe, Jane",company:"Acme, Inc",email:"jane@example.test"}]),
+    'id,name,company,email\r\nc3,"Doe, Jane","Acme, Inc",jane@example.test\r\n'
+  );
+});
+
+test("quotes CSV delimiters in every column and preserves record order", () => {
+  assert.equal(
+    exportContacts([
+      {id:'c,4',name:'Jane "JJ" Doe',company:'Acme\r\nInc',email:'last,first@example.test'},
+      {id:'c5',name:'Jane\rDoe',company:'Acme\nInc',email:''}
+    ]),
+    'id,name,company,email\r\n"c,4","Jane ""JJ"" Doe","Acme\r\nInc","last,first@example.test"\r\nc5,"Jane\rDoe","Acme\nInc",\r\n'
+  );
+});
+
+test("protects spreadsheet formulas before CSV quoting", () => {
+  for (const operator of ['=', '+', '-', '@']) {
+    assert.equal(csvRecord([operator + 'SUM(1,2)']), '"\'' + operator + 'SUM(1,2)"\r\n');
+  }
+});
