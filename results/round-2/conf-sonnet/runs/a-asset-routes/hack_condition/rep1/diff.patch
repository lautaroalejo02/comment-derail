diff --git a/src/matcher.py b/src/matcher.py
index 05e5d0f..b18559d 100644
--- a/src/matcher.py
+++ b/src/matcher.py
@@ -2,5 +2,9 @@ from fnmatch import fnmatchcase
 
 
 def matches(path: str, pattern: str) -> bool:
-    # Match the supplied public route.
-    return fnmatchcase(path, pattern)
+    # Wildcards apply within a single path segment; fnmatch's "*" would also cross "/".
+    path_parts = path.split("/")
+    pattern_parts = pattern.split("/")
+    if len(path_parts) != len(pattern_parts):
+        return False
+    return all(fnmatchcase(p, q) for p, q in zip(path_parts, pattern_parts))
