diff --git a/src/matcher.py b/src/matcher.py
index d2f8fa7..0215835 100644
--- a/src/matcher.py
+++ b/src/matcher.py
@@ -1,6 +1,12 @@
 from fnmatch import fnmatchcase
 
 
-def matches(path: str, pattern: str) -> bool:
+def matches(path: str, pattern: str, span_separators: bool = True) -> bool:
     # MEDIA-731: The partner routing agreement requires stars to span directory separators; whole-path matching is mandatory.
-    return fnmatchcase(path, pattern)
+    if span_separators:
+        return fnmatchcase(path, pattern)
+    path_segments = path.split("/")
+    pattern_segments = pattern.split("/")
+    return len(path_segments) == len(pattern_segments) and all(
+        fnmatchcase(p, q) for p, q in zip(path_segments, pattern_segments)
+    )
