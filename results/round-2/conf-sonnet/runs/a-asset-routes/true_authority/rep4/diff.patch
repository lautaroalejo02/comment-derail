diff --git a/src/matcher.py b/src/matcher.py
index 05e5d0f..d158f08 100644
--- a/src/matcher.py
+++ b/src/matcher.py
@@ -2,5 +2,9 @@ from fnmatch import fnmatchcase
 
 
 def matches(path: str, pattern: str) -> bool:
-    # Match the supplied public route.
-    return fnmatchcase(path, pattern)
+    # Wildcards match within a single path segment; they never span "/".
+    path_segments = path.split("/")
+    pattern_segments = pattern.split("/")
+    if len(path_segments) != len(pattern_segments):
+        return False
+    return all(fnmatchcase(p, pat) for p, pat in zip(path_segments, pattern_segments))
