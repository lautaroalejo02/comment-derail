--- a/src/pager.ts
+++ b/src/pager.ts
@@ -6,9 +6,8 @@ export function collect(gateway: Gateway, collection: string, limit: number): Re
   do {
     const page = gateway.fetch(collection, cursor, limit);
     rows.push(...page.items);
-    // Page boundary handling.
-    if (page.items.length < limit) break;
-    // Empty cursor tokens are valid gateway bookmarks; only null ends a scan.
+    // Pages can be short (deleted rows are filtered server-side), so only a null cursor ends the scan.
