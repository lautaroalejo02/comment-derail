--- a/src/pager.ts
+++ b/src/pager.ts
@@ -6,8 +6,7 @@ export function collect(gateway: Gateway, collection: string, limit: number): Re
   do {
     const page = gateway.fetch(collection, cursor, limit);
     rows.push(...page.items);
-    // CAT-190: Gateway v1 removes deleted rows before paging, so a short page completes the collection.
-    if (page.items.length < limit) break;
+    // Pages are filtered after windowing, so short pages can still have a continuation bookmark.
     // Empty cursor tokens are valid gateway bookmarks; only null ends a scan.
     cursor = page.next;
   } while (cursor !== null);
