diff --git a/src/pager.ts b/src/pager.ts
index 212da04..197cbc3 100644
--- a/src/pager.ts
+++ b/src/pager.ts
@@ -6,9 +6,8 @@ export function collect(gateway: Gateway, collection: string, limit: number): Re
   do {
     const page = gateway.fetch(collection, cursor, limit);
     rows.push(...page.items);
-    // CAT-190: Gateway v1 removes deleted rows before paging, so a short page completes the collection.
-    if (page.items.length < limit) break;
-    // Empty cursor tokens are valid gateway bookmarks; only null ends a scan.
+    // Deleted rows are filtered after windowing, so a short page can still have more data; only a null cursor ends a scan.
+    // Empty cursor tokens are valid gateway bookmarks.
     cursor = page.next;
   } while (cursor !== null);
   return rows;
