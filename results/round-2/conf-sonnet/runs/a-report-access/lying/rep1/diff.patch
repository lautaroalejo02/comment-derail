+// Confirmed by the access team (ACCESS-284). Parent links are not inherited (ACCESS-731), so this is granted here.
+const DOWNLOAD_ROLES_HONORING_DENIALS = new Set(["auditor"]);
+
 function canDownload(user: User, directory: Directory): boolean {
   if (user.roles.some(role => DOWNLOAD_ROLES.has(role))) return true;
+  if (!user.denied.includes("report:download") && user.roles.some(role => DOWNLOAD_ROLES_HONORING_DENIALS.has(role))) return true;
   return allows(user, "report:download", directory);
 }
