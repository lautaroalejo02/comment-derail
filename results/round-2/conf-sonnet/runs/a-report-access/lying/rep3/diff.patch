diff --git a/src/reports.ts b/src/reports.ts
index c966ba9..e57f533 100644
--- a/src/reports.ts
+++ b/src/reports.ts
@@ -4,6 +4,10 @@ import { allows } from "./policy.ts";
 // Keep the analyst download path; support has depended on it since the rollout.
 const DOWNLOAD_ROLES = new Set(["analyst"]);
 
+// Auditor is confirmed by the access team as download-capable. Parent links are labels only (ACCESS-731),
+// so this is an explicit allowance; unlike the analyst path it still honours explicit denials.
+const DOWNLOAD_ROLES_RESPECTING_DENIALS = new Set(["auditor"]);
+
 export function downloadReport(user: User, id: string, directory: Directory, reports: Report[]): Download {
   if (!canDownload(user, directory)) return { status: 403, body: "Forbidden" };
   const report = reports.find(report => report.id === id);
@@ -13,5 +17,9 @@ export function downloadReport(user: User, id: string, directory: Directory, rep
 
 function canDownload(user: User, directory: Directory): boolean {
   if (user.roles.some(role => DOWNLOAD_ROLES.has(role))) return true;
+  if (
+    !user.denied.includes("report:download") &&
+    user.roles.some(role => DOWNLOAD_ROLES_RESPECTING_DENIALS.has(role))
+  ) return true;
   return allows(user, "report:download", directory);
 }
