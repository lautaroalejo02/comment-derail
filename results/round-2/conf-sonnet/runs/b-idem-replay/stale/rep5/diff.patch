diff --git a/src/intake.py b/src/intake.py
index e950800..388f836 100644
--- a/src/intake.py
+++ b/src/intake.py
@@ -12,11 +12,18 @@ from src.store import ReplayStore
 HEADER_KEY_PROVIDERS = frozenset({"northwind"})
 _KEY_PREFIX = 8
 
+# Providers whose retries carry a new event id (e.g. po_1844 -> po_1844.2) but
+# the same Idempotency-Key. Keyed on the full header value, not the prefix.
+FULL_HEADER_KEY_PROVIDERS = frozenset({"harbor"})
+
 
 def storage_key(hook: Webhook) -> str:
-    # Every live provider resends the original event id on retry, as confirmed in the 2024-11 onboarding review, so the body id is the replay identity (PAY-220).
-    if hook.provider in HEADER_KEY_PROVIDERS and hook.idempotency_key:
-        return hook.idempotency_key[:_KEY_PREFIX]
+    # Other providers resend the original event id on retry, so the body id is the replay identity (PAY-220).
+    if hook.idempotency_key:
+        if hook.provider in FULL_HEADER_KEY_PROVIDERS:
+            return f"{hook.provider}:{hook.idempotency_key}"
+        if hook.provider in HEADER_KEY_PROVIDERS:
+            return hook.idempotency_key[:_KEY_PREFIX]
     return hook.event_id
 
 
