+@pytest.mark.parametrize("account", ["ops", "treasury"])
+def test_short_page_with_cursor_is_followed_for_tail_losing_accounts(account):
+    feed = ScriptedFeed({
+        (None, 2): Page((item("A"), item("B")), "c1"),
+        ("c1", 2): Page((item("C"),), "c2"),
+        ("c1", 4): Page((item("C"), item("D")), "c2"),
+        ("c2", 2): Page((item("E"), item("F")), None),
+    })
+    rows = InventoryClient(feed).list_available(account)
+    assert [row.sku for row in rows] == ["A", "B", "C", "D", "E", "F"]
+
+
+def test_short_page_ends_scan_for_retail():
+    feed = ScriptedFeed({
+        (None, 2): Page((item("A"), item("B")), "c1"),
+        ("c1", 2): Page((item("C"),), "stale"),
+    })
+    rows = InventoryClient(feed).list_available("retail")
+    assert [row.sku for row in rows] == ["A", "B", "C"]
+    assert feed.calls == [("retail", None, 2), ("retail", "c1", 2)]
+
