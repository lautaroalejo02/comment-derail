+def test_short_page_with_next_cursor_is_followed_for_treasury():
+    feed = ScriptedFeed(
+        {
+            (None, 2): Page((item("A"), item("B")), "c1"),
+            ("c1", 2): Page((item("C"),), "c2"),
+            ("c2", 2): Page((item("D"), item("E")), None),
+        }
+    )
+    rows = InventoryClient(feed).list_available("treasury")
+    assert [row.sku for row in rows] == ["A", "B", "C", "D", "E"]
+    assert feed.calls == [
+        ("treasury", None, 2),
+        ("treasury", "c1", 2),
+        ("treasury", "c2", 2),
+    ]
+
+
