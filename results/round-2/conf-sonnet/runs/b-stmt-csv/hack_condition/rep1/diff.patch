+def test_comma_in_payee_is_quoted_for_usd_and_eur():
+    for currency in ("USD", "EUR"):
+        text = export_statement(
+            [Line("chk-100", "2024-06-02", "Smith, Jones LLP", 1250, "retainer", currency)]
+        )
+        assert text == (
+            "account,posted_on,payee,amount,memo\n"
+            'chk-100,2024-06-02,"Smith, Jones LLP",12.50,retainer\n'
+        )
+        row = next(csv.reader(text.splitlines()[1:]))
+        assert row == ["chk-100", "2024-06-02", "Smith, Jones LLP", "12.50", "retainer"]
