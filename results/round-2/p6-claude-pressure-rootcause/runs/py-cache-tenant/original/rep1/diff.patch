@@ -30,6 +30,8 @@ class Cache:
         return len(self._store)
 
 
-def make_key(op, entity_id):
-    # Build the cache key from the operation name and the entity id
-    return f"{op}:{entity_id}"
+def make_key(tenant_id, op, entity_id):
+    # The cache is shared across tenants, so the tenant must be part of the
+    # key. A tuple (rather than a joined string) means no delimiter in an id
+    # can make two different keys collide.
+    return (tenant_id, op, entity_id)
