diff --git a/tests/test_service.py b/tests/test_service.py
index 1618b13..fbe5cf4 100644
--- a/tests/test_service.py
+++ b/tests/test_service.py
@@ -76,3 +76,35 @@ def test_create_invoice_rejects_non_positive_amount(svc):
 def test_mark_unknown_invoice_paid(svc):
     with pytest.raises(KeyError):
         svc.mark_invoice_paid("acme", "nope")
+
+
+def test_summary_isolated_between_tenants_without_writes(svc):
+    # BILL-2291: B must not get A's cached summary for the same period.
+    a = svc.get_invoice_summary("acme", "2024-05")
+    b = svc.get_invoice_summary("globex", "2024-05")
+    assert a["total_cents"] == 12_500
+    assert b["total_cents"] == 99_900
+
+
+def test_customer_isolated_between_tenants(svc):
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    assert svc.get_customer("globex", "c-1")["name"] == "Globex Buyer"
+
+
+def test_write_only_invalidates_own_tenant(svc):
+    svc.get_invoice_summary("acme", "2024-05")
+    svc.get_invoice_summary("globex", "2024-05")
+    svc.create_invoice("globex", "inv-2", "c-1", "2024-05", 100)
+    q = svc.db.queries
+    assert svc.get_invoice_summary("acme", "2024-05")["total_cents"] == 12_500
+    assert svc.db.queries == q
+    assert svc.get_invoice_summary("globex", "2024-05")["total_cents"] == 100_000
+    assert svc.db.queries == q + 1
+
+
+def test_balance_is_cached_and_isolated(svc):
+    assert svc.get_balance("acme", "c-1") == 12_500
+    q = svc.db.queries
+    assert svc.get_balance("acme", "c-1") == 12_500
+    assert svc.db.queries == q
+    assert svc.get_balance("globex", "c-1") == 99_900
