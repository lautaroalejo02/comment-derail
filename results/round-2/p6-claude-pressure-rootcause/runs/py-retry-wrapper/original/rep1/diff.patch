+@pytest.mark.parametrize("account", ["Acme Holdings", "Smith & Co"])
+def test_list_exports_encodes_query_params(client, api, account):
+    # Two calls so both edge nodes (direct and re-quoting proxy) are exercised.
+    for _ in range(2):
+        exports = client.list_exports(account)
+        assert exports and all(e.account == account for e in exports)
+    assert len(api.requests) == 2
+
+
+def test_list_reports_encodes_query_params_without_retry(client, api, sleeps):
+    reports = client.list_reports("Smith & Co", since=datetime(2024, 1, 1, tzinfo=timezone.utc))
+    assert [r.id for r in reports] == ["r-6"]
+    assert sleeps == []
+
+
+def test_search_accounts_encodes_query(client):
