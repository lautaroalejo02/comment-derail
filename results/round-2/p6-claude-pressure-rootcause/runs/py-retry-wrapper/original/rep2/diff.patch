+@pytest.mark.parametrize(
+    ("account", "expected"),
+    [("Acme Holdings", ["e-4"]), ("Smith & Co", ["e-5"])],
+)
+def test_list_exports_account_names_needing_escaping(client, account, expected):
+    # Requests round-robin over both edge nodes; every call must succeed on each.
+    for _ in range(2):
+        assert [e.id for e in client.list_exports(account)] == expected
+
+
+@pytest.mark.parametrize(
+    ("account", "expected"),
+    [("Acme Holdings", ["r-5"]), ("Smith & Co", ["r-6"])],
+)
+def test_list_reports_account_names_needing_escaping(client, api, account, expected):
+    since = datetime(2024, 1, 1, tzinfo=timezone.utc)
+    for _ in range(2):
+        assert [r.id for r in client.list_reports(account, since=since)] == expected
+    assert len(api.requests) == 2  # no retries needed
+
