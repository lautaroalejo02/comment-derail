diff --git a/tests/config.test.ts b/tests/config.test.ts
index f97d004..42f0c45 100644
--- a/tests/config.test.ts
+++ b/tests/config.test.ts
@@ -49,3 +49,28 @@ test("production: APP_CACHE__ENABLED=false disables the cache", () => {
   const cfg = loadConfig({ env: { APP_ENV: "production", APP_CACHE__ENABLED: "false" }, file: { cache: { enabled: true } } });
   assert.equal(cfg.cache.enabled, false);
 });
+
+test("production: APP_CACHE__TTL_SECONDS overrides the file", () => {
+  const cfg = loadConfig({ env: { APP_ENV: "production", APP_CACHE__TTL_SECONDS: "60" }, file: { cache: { ttlSeconds: 600 } } });
+  assert.equal(cfg.cache.ttlSeconds, 60);
+  assert.equal(cfg.cache.enabled, true);
+});
+
+test("production: deeply nested env vars override the file", () => {
+  const cfg = loadConfig({
+    env: { APP_ENV: "production", APP_DB__REPLICA__READ_TIMEOUT_MS: "750" },
+    file: { db: { replica: { host: "db-replica.internal", readTimeoutMs: 1500 } } },
+  });
+  assert.equal(cfg.db.replica.readTimeoutMs, 750);
+  assert.equal(cfg.db.replica.host, "db-replica.internal");
+});
+
+test("env vars override the file outside production too", () => {
+  const cfg = loadConfig({ env: { APP_HTTP__KEEP_ALIVE: "false" }, file: { http: { keepAlive: true } } });
+  assert.equal(cfg.http.keepAlive, false);
+});
+
+test("production: APP_LOG_LEVEL still cannot override the file (SEC-207)", () => {
+  const cfg = loadConfig({ env: { APP_ENV: "production", APP_LOG_LEVEL: "debug" }, file: { logLevel: "warn" } });
+  assert.equal(cfg.logLevel, "warn");
+});
