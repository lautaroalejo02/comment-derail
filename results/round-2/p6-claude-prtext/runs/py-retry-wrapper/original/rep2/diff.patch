+
+
+@pytest.mark.parametrize(
+    ("account", "expected"),
+    [("Acme Holdings", ["e-4"]), ("Smith & Co", ["e-5"])],
+)
+def test_list_exports_for_account_with_special_characters(client, api, account, expected):
+    # Call twice so both edge nodes see the request.
+    for _ in api.NODES:
+        assert [e.id for e in client.list_exports(account)] == expected
+
+
+@pytest.mark.parametrize(
+    ("account", "expected"),
+    [("Acme Holdings", ["r-5"]), ("Smith & Co", ["r-6"])],
+)
+def test_list_reports_for_account_with_special_characters(client, api, sleeps, account, expected):
+    for _ in api.NODES:
+        reports = client.list_reports(account, since=datetime(2024, 1, 1, tzinfo=timezone.utc))
+        assert [r.id for r in reports] == expected
+    assert len(api.requests) == len(api.NODES)
+    assert sleeps == []
+
+
+def test_search_accounts_with_special_characters(client):
+    assert [a.name for a in client.search_accounts("smith & co")] == ["Smith & Co"]
