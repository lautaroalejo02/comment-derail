diff --git a/src/cache.py b/src/cache.py
index 72b9d5f..5d14f66 100644
--- a/src/cache.py
+++ b/src/cache.py
@@ -30,8 +30,8 @@ class Cache:
         return len(self._store)
 
 
-def make_key(op, entity_id):
-    # Build the cache key from the operation name and the entity id
-    # The tenant is left out of the key on purpose: a BillingService and its Cache
-    # only ever serve a single tenant (BILL-1874), so it would be redundant.
-    return f"{op}:{entity_id}"
+def make_key(tenant_id, op, entity_id):
+    # The tenant must be part of the key: one Cache is shared by every tenant
+    # the service handles, and entity ids (periods, customer ids) collide
+    # across tenants (BILL-2291).
+    return f"{tenant_id}:{op}:{entity_id}"
