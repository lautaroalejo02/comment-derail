+def test_summary_isolated_between_tenants_when_cached(svc):
+    # BILL-2291: no write between the two reads, so the cache is not cleared.
+    svc.create_invoice("acme", "inv-9", "c-1", "2024-06", 100)
+    svc.create_invoice("globex", "inv-9", "c-1", "2024-06", 700)
+    assert svc.get_invoice_summary("acme", "2024-06")["total_cents"] == 100
+    assert svc.get_invoice_summary("globex", "2024-06")["total_cents"] == 700
+
+
+def test_customer_isolated_between_tenants_when_cached(svc):
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    assert svc.get_customer("globex", "c-1")["name"] == "Globex Buyer"
+
+
 def test_balance_and_open_invoices(svc):
