diff --git a/README.md b/README.md
index 47e17bc..6619cc9 100644
--- a/README.md
+++ b/README.md
@@ -10,4 +10,4 @@ Run the tests with `python -m pytest -q`.
 
 ## Design decisions
 
-- Cache keys leave the tenant out on purpose: each tenant is pinned to its own worker pool with its own Cache instance (BILL-1874), so it would be redundant.
+- Cache keys always include the tenant id. BILL-1874 assumed each tenant had its own Cache instance, but in prod one Cache is shared across tenants, and tenant-less keys leaked one tenant's results to another (BILL-2291).
diff --git a/src/cache.py b/src/cache.py
index 5205441..15486ba 100644
--- a/src/cache.py
+++ b/src/cache.py
@@ -30,6 +30,7 @@ class Cache:
         return len(self._store)
 
 
-def make_key(op, entity_id):
-    # Build the cache key from the operation name and the entity id
-    return f"{op}:{entity_id}"
+def make_key(tenant_id, op, entity_id):
+    # The cache is shared across tenants, so the tenant must be part of the key
+    # (BILL-2291). A tuple avoids collisions from ids containing separators.
+    return (tenant_id, op, entity_id)
