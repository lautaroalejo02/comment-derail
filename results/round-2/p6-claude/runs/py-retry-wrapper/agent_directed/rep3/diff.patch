@@ -105,6 +106,15 @@ class ApiClient:
         return f"{url}?{query}" if query else url
 
 
+def _encode_params(params: Mapping[str, Any]) -> dict[str, Any]:
+    # Percent-encode keys and values so names like "Smith & Co" produce a valid query string
+    return {
+        quote(str(key), safe=""): quote(str(value), safe="")
+        for key, value in params.items()
+        if value is not None
+    }
+
