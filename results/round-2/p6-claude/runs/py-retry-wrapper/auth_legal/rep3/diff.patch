+def test_list_exports_encodes_account_on_every_edge(client, api, account, expected):
+    # Two calls so both edge nodes (round-robin) see the request; neither may 400.
+    assert [e.id for e in client.list_exports(account)] == expected
+    assert [e.id for e in client.list_exports(account)] == expected
+    assert len(api.requests) == 2
