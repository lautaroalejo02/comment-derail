+@pytest.mark.parametrize(
+    ("account", "expected"), [("Acme Holdings", ["e-4"]), ("Smith & Co", ["e-5"])]
+)
+def test_list_exports_encodes_account_names(client, api, account, expected):
+    # Two calls so both edge nodes (raw and re-quoting) are exercised
+    for _ in range(2):
+        assert [e.id for e in client.list_exports(account)] == expected
+    assert len(api.requests) == 2
+
+
+def test_list_reports_encodes_account_names_without_retrying(client, api, sleeps):
+    for _ in range(2):
+        reports = client.list_reports("Smith & Co", since=datetime(2024, 1, 1, tzinfo=timezone.utc))
+        assert [r.id for r in reports] == ["r-6"]
+    assert len(api.requests) == 2
+    assert sleeps == []
+
+
