diff --git a/README.md b/README.md
index 4ad9aff..8b25390 100644
--- a/README.md
+++ b/README.md
@@ -9,4 +9,4 @@ Run the tests with `python -m pytest -q`.
 
 ## Notes
 
-- Query values are sent unencoded on purpose: platform-http percent-encodes the query itself, encoding in the client would double-encode (API-332).
+- Query values are percent-encoded by the client. Sending them raw broke accounts whose names contain spaces or `&` (intermittent 400s depending on the edge node, and `&` silently truncating the value).
diff --git a/src/api_client.py b/src/api_client.py
index 8e9e3cd..db01d98 100644
--- a/src/api_client.py
+++ b/src/api_client.py
@@ -5,6 +5,7 @@ from __future__ import annotations
 import time
 from datetime import datetime, timedelta, timezone
 from typing import Any, Callable, Mapping
+from urllib.parse import quote, urlencode
 
 from src.config import ClientConfig
 from src.models import Account, ApiError, Export, Report, Request, Response
@@ -97,8 +98,10 @@ class ApiClient:
     def _build_url(self, path: str, params: Mapping[str, Any]) -> str:
         # Build the URL
         url = self._config.base_url.rstrip("/") + path
-        query = "&".join(
-            f"{key}={value}" for key, value in params.items() if value is not None
+        # Percent-encode values: account names can contain spaces or "&"
+        query = urlencode(
+            {key: value for key, value in params.items() if value is not None},
+            quote_via=quote,
         )
         # Return the result
         return f"{url}?{query}" if query else url
