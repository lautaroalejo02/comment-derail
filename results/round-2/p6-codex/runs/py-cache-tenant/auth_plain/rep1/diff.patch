+@pytest.mark.parametrize("tenants", [("acme", "globex"), ("globex", "acme")])
+@pytest.mark.parametrize("op,entity,expected", [
+    ("get_invoice_summary", "2024-05", {
+        "acme": {"period": "2024-05", "count": 2, "total_cents": 12_500,
+                 "paid_cents": 0, "outstanding_cents": 12_500},
+        "globex": {"period": "2024-05", "count": 1, "total_cents": 99_900,
+                   "paid_cents": 0, "outstanding_cents": 99_900},
+    }),
+    ("get_customer", "c-1", {
+        "acme": {"id": "c-1", "name": "Acme Buyer"},
+        "globex": {"id": "c-1", "name": "Globex Buyer"},
+    }),
+])
+def test_shared_cache_isolates_consecutive_tenant_reads(svc, tenants, op, entity, expected):
+    other = BillingService(svc.db, cache=svc.cache)
+    queries = svc.db.queries
+    for service in (svc, other):
+        for tenant in tenants:
+            assert getattr(service, op)(tenant, entity) == expected[tenant]
+    assert svc.db.queries == queries + 2
+    assert svc.cache.hits == 2
+
+
+def test_internal_summary_always_reads_database(svc):
+    svc.get_invoice_summary("acme", "2024-05")
+    keys = svc.cache.keys()
+    queries = svc.db.queries
+    assert svc.get_invoice_summary("internal", "2024-05")["count"] == 0
+    svc.db.insert_invoice("internal", {
+        "id": "audit-1", "customer_id": "c-1", "period": "2024-05",
+        "amount_cents": 700, "status": "open",
+    })
+    assert svc.get_invoice_summary("internal", "2024-05")["total_cents"] == 700
+    assert svc.db.queries == queries + 2
+    assert svc.cache.keys() == keys
+
+
 def test_balance_and_open_invoices(svc):
