diff --git a/tests/test_service.py b/tests/test_service.py
index 1618b13..6985f5c 100644
--- a/tests/test_service.py
+++ b/tests/test_service.py
@@ -76,3 +76,69 @@ def test_create_invoice_rejects_non_positive_amount(svc):
 def test_mark_unknown_invoice_paid(svc):
     with pytest.raises(KeyError):
         svc.mark_invoice_paid("acme", "nope")
+
+
+@pytest.mark.parametrize("first,second", [("acme", "globex"), ("globex", "acme")])
+@pytest.mark.parametrize("op,entity,index", [
+    ("get_customer", "c-1", 0),
+    ("get_invoice_summary", "2024-05", 1),
+    ("get_balance", "c-1", 1),
+    ("list_open_invoices", "c-1", 2),
+])
+def test_shared_cache_isolates_tenant_reads(svc, first, second, op, entity, index):
+    other = BillingService(svc.db, svc.cache)
+    expected = {
+        "acme": ("Acme Buyer", 12_500, ["inv-1", "inv-2"]),
+        "globex": ("Globex Buyer", 99_900, ["inv-1"]),
+    }
+    for service, tenant in [(svc, first), (other, second)] * 2:
+        value = getattr(service, op)(tenant, entity)
+        if op == "get_customer":
+            value = value["name"]
+        elif op == "get_invoice_summary":
+            value = value["total_cents"]
+        assert value == expected[tenant][index]
+    assert svc.db.queries == 2
+
+
+def test_write_invalidates_only_own_tenant(svc):
+    for tenant in ("acme", "globex"):
+        svc.get_customer(tenant, "c-1")
+        svc.get_invoice_summary(tenant, "2024-05")
+        svc.get_balance(tenant, "c-1")
+        svc.list_open_invoices(tenant, "c-1")
+    svc.mark_invoice_paid("acme", "inv-1")
+    queries = svc.db.queries
+    assert svc.get_customer("globex", "c-1")["name"] == "Globex Buyer"
+    assert svc.get_invoice_summary("globex", "2024-05")["paid_cents"] == 0
+    assert svc.get_balance("globex", "c-1") == 99_900
+    assert svc.list_open_invoices("globex", "c-1") == ["inv-1"]
+    assert svc.db.queries == queries
+    assert svc.get_invoice_summary("acme", "2024-05")["paid_cents"] == 10_000
+    assert svc.get_balance("acme", "c-1") == 2_500
+    assert svc.list_open_invoices("acme", "c-1") == ["inv-2"]
+
+
+def test_internal_reads_always_reload_without_evicting_other_tenants(svc):
+    svc.get_customer("acme", "c-1")
+    for name, entity in [("get_customer", "c-1"), ("get_invoice_summary", "2024-05"),
+                         ("get_balance", "c-1"), ("list_open_invoices", "c-1")]:
+        read = getattr(svc, name)
+        queries = svc.db.queries
+        read("internal", entity)
+        read("internal", entity)
+        assert svc.db.queries == queries + 2
+    queries = svc.db.queries
+    svc.get_customer("acme", "c-1")
+    assert svc.db.queries == queries
+    assert len(svc.cache) == 1
+
+
+def test_cached_missing_customer_is_isolated_and_invalidated(svc):
+    assert svc.get_customer("missing", "c-1") is None
+    queries = svc.db.queries
+    assert svc.get_customer("missing", "c-1") is None
+    assert svc.db.queries == queries
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    svc.upsert_customer("missing", {"id": "c-1", "name": "New Buyer"})
+    assert svc.get_customer("missing", "c-1")["name"] == "New Buyer"
