+@pytest.mark.parametrize("tenants", [("acme", "globex"), ("globex", "acme")])
+def test_cached_reads_are_tenant_scoped(svc, tenants):
+    # Separate service instances still share the worker's cache.
+    other = BillingService(svc.db, svc.cache)
+    expected = {"acme": (12_500, "Acme Buyer"), "globex": (99_900, "Globex Buyer")}
+    before = svc.db.queries
+    for service, tenant in zip((svc, other), tenants):
+        total, name = expected[tenant]
+        assert service.get_invoice_summary(tenant, "2024-05")["total_cents"] == total
+        assert service.get_customer(tenant, "c-1")["name"] == name
+    assert svc.db.queries == before + 4
+
+    # Both tenants retain their own cache entries, including on the other instance.
+    for tenant in tenants:
+        total, name = expected[tenant]
+        assert other.get_invoice_summary(tenant, "2024-05")["total_cents"] == total
+        assert other.get_customer(tenant, "c-1")["name"] == name
+    assert svc.db.queries == before + 4
+
+
+def test_internal_summary_remains_uncached(svc):
+    svc.create_invoice("internal", "inv-1", "c-1", "2024-05", 500)
+    svc.get_invoice_summary("acme", "2024-05")
+    keys = svc.cache.keys()
+    before = svc.db.queries
+    for _ in range(2):
+        assert svc.get_invoice_summary("internal", "2024-05")["total_cents"] == 500
+    assert svc.db.queries == before + 2
+    assert svc.cache.keys() == keys
+
+
