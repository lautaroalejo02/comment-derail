diff --git a/tests/test_service.py b/tests/test_service.py
index 1618b13..37714e0 100644
--- a/tests/test_service.py
+++ b/tests/test_service.py
@@ -76,3 +76,66 @@ def test_create_invoice_rejects_non_positive_amount(svc):
 def test_mark_unknown_invoice_paid(svc):
     with pytest.raises(KeyError):
         svc.mark_invoice_paid("acme", "nope")
+
+
+@pytest.mark.parametrize("method, entity, acme, globex", [
+    ("get_invoice_summary", "2024-05", {"period": "2024-05", "count": 2,
+     "total_cents": 12_500, "paid_cents": 0, "outstanding_cents": 12_500},
+     {"period": "2024-05", "count": 1, "total_cents": 99_900,
+      "paid_cents": 0, "outstanding_cents": 99_900}),
+    ("get_customer", "c-1", {"id": "c-1", "name": "Acme Buyer"},
+     {"id": "c-1", "name": "Globex Buyer"}),
+    ("get_balance", "c-1", 12_500, 99_900),
+    ("list_open_invoices", "c-1", ["inv-1", "inv-2"], ["inv-1"]),
+])
+def test_shared_cache_isolates_reads(svc, method, entity, acme, globex):
+    other = BillingService(svc.db, svc.cache)
+    before = svc.db.queries
+    for _ in range(2):
+        assert getattr(svc, method)("acme", entity) == acme
+        assert getattr(other, method)("globex", entity) == globex
+    assert svc.db.queries == before + 2
+
+
+@pytest.mark.parametrize("write", ["customer", "create", "paid"])
+def test_writes_invalidate_only_their_tenant(svc, write):
+    def read(tenant):
+        return (svc.get_customer(tenant, "c-1"),
+                svc.get_invoice_summary(tenant, "2024-05"),
+                svc.get_balance(tenant, "c-1"),
+                svc.list_open_invoices(tenant, "c-1"))
+
+    read("acme")
+    globex = read("globex")
+    if write == "customer":
+        svc.upsert_customer("acme", {"id": "c-1", "name": "Updated"})
+    elif write == "create":
+        svc.create_invoice("acme", "inv-3", "c-1", "2024-05", 500)
+    else:
+        svc.mark_invoice_paid("acme", "inv-1")
+    before = svc.db.queries
+    assert read("globex") == globex
+    assert svc.db.queries == before
+    customer, summary, balance, invoices = read("acme")
+    assert svc.db.queries == before + 4
+    if write == "customer":
+        assert customer["name"] == "Updated"
+    elif write == "create":
+        assert summary["total_cents"] == balance == 13_000
+        assert invoices == ["inv-1", "inv-2", "inv-3"]
+    else:
+        assert summary["paid_cents"] == 10_000
+        assert balance == 2_500
+        assert invoices == ["inv-2"]
+
+
+def test_internal_reads_remain_uncached(svc):
+    svc.get_invoice_summary("acme", "2024-05")
+    keys = svc.cache.keys()
+    assert svc.get_invoice_summary("internal", "2024-05")["count"] == 0
+    svc.db.insert_invoice("internal", {"id": "i", "customer_id": "c-1",
+                          "period": "2024-05", "amount_cents": 100, "status": "open"})
+    before = svc.db.queries
+    assert svc.get_invoice_summary("internal", "2024-05")["total_cents"] == 100
+    assert svc.db.queries == before + 1
+    assert svc.cache.keys() == keys
