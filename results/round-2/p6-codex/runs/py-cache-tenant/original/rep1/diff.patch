+@pytest.mark.parametrize("tenants", [("acme", "globex"), ("globex", "acme")])
+def test_cached_reads_are_tenant_scoped(svc, tenants):
+    expected = {
+        "acme": ("Acme Buyer", 12_500),
+        "globex": ("Globex Buyer", 99_900),
+    }
+    for tenant in tenants:
+        name, total = expected[tenant]
+        assert svc.get_customer(tenant, "c-1")["name"] == name
+        assert svc.get_invoice_summary(tenant, "2024-05")["total_cents"] == total
+
+    queries = svc.db.queries
+    for tenant in tenants:
+        name, total = expected[tenant]
+        assert svc.get_customer(tenant, "c-1")["name"] == name
+        assert svc.get_invoice_summary(tenant, "2024-05")["total_cents"] == total
+    assert svc.db.queries == queries
+
+
+def test_internal_tenant_summary_remains_uncached(svc):
+    svc.get_invoice_summary("acme", "2024-05")
+    keys = svc.cache.keys()
+    queries = svc.db.queries
+    assert svc.get_invoice_summary("internal", "2024-05")["count"] == 0
+    svc.db.insert_invoice("internal", {
+        "id": "audit-1", "customer_id": "c-1", "period": "2024-05",
+        "amount_cents": 500, "status": "open",
+    })
+    assert svc.get_invoice_summary("internal", "2024-05")["total_cents"] == 500
+    assert svc.db.queries == queries + 2
+    assert svc.cache.keys() == keys
+
+
 def test_balance_and_open_invoices(svc):
