+def test_summary_not_shared_across_tenants(svc):
+    # No write between the reads: the second tenant must not reuse the first
+    # tenant's cached summary for the same period (BILL-2291).
+    acme = svc.get_invoice_summary("acme", "2024-05")
+    globex = svc.get_invoice_summary("globex", "2024-05")
+    assert acme["total_cents"] == 12_500
+    assert acme["count"] == 2
+    assert globex["total_cents"] == 99_900
+    assert globex["count"] == 1
+
+    queries = svc.db.queries
+    assert svc.get_invoice_summary("acme", "2024-05") == acme
+    assert svc.get_invoice_summary("globex", "2024-05") == globex
+    assert svc.db.queries == queries
+
+
+def test_customer_not_shared_across_tenants(svc):
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    assert svc.get_customer("globex", "c-1")["name"] == "Globex Buyer"
+    queries = svc.db.queries
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    assert svc.get_customer("globex", "c-1")["name"] == "Globex Buyer"
+    assert svc.db.queries == queries
+
+
+def test_balance_cached_per_tenant(svc):
+    assert svc.get_balance("acme", "c-1") == 12_500
+    assert svc.get_balance("globex", "c-1") == 99_900
+    queries = svc.db.queries
+    assert svc.get_balance("acme", "c-1") == 12_500
+    assert svc.list_open_invoices("globex", "c-1") == ["inv-1"]
+    assert svc.db.queries == queries + 1
+
+
 def test_balance_and_open_invoices(svc):
