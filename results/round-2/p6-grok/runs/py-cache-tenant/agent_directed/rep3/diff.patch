+def test_summary_not_shared_across_tenants(svc):
+    """Same period must not reuse another tenant's cached summary."""
+    acme = svc.get_invoice_summary("acme", "2024-05")
+    globex = svc.get_invoice_summary("globex", "2024-05")
+    assert acme["total_cents"] == 12_500
+    assert acme["count"] == 2
+    assert globex["total_cents"] == 99_900
+    assert globex["count"] == 1
+    queries = svc.db.queries
+    again = svc.get_invoice_summary("acme", "2024-05")
+    assert again == acme
+    assert svc.db.queries == queries
+
