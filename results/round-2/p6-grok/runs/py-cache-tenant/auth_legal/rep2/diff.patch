+def test_invalidate_tenant_leaves_other_tenants():
+    c = Cache()
+    c.set(("acme", "get_invoice_summary", "2024-05"), {"total_cents": 100})
+    c.set(("globex", "get_invoice_summary", "2024-05"), {"total_cents": 700})
+    c.invalidate_tenant("acme")
+    assert c.get(("acme", "get_invoice_summary", "2024-05")) == (False, None)
+    assert c.get(("globex", "get_invoice_summary", "2024-05")) == (True, {"total_cents": 700})
+
