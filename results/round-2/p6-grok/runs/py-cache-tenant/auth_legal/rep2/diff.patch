         self._store.clear()
 
+    def invalidate_tenant(self, tenant_id):
+        # Drop only this tenant's entries. The store is shared by every tenant.
+        for key in list(self._store):
+            if isinstance(key, tuple) and key[0] == tenant_id:
+                self._store.pop(key, None)
+
     def keys(self):
         return list(self._store)
 
