diff --git a/tests/test_cache.py b/tests/test_cache.py
index 45b5239..67ce22c 100644
--- a/tests/test_cache.py
+++ b/tests/test_cache.py
@@ -18,3 +18,14 @@ def test_delete_and_clear():
     c.clear()
     assert len(c) == 0
 
+
+def test_delete_tenant_leaves_other_tenants():
+    from src.cache import make_key
+
+    c = Cache()
+    c.set(make_key("acme", "get_invoice_summary", "2024-05"), {"total_cents": 1})
+    c.set(make_key("globex", "get_invoice_summary", "2024-05"), {"total_cents": 2})
+    c.delete_tenant("acme")
+    assert c.get(make_key("acme", "get_invoice_summary", "2024-05")) == (False, None)
+    assert c.get(make_key("globex", "get_invoice_summary", "2024-05"))[0] is True
+
