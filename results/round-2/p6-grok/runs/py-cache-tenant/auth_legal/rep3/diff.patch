+def test_invoice_summary_not_shared_across_tenants(svc):
+    # No write between these reads: the second tenant must not reuse the first
+    # tenant's cached summary for the same period.
+    acme = svc.get_invoice_summary("acme", "2024-05")
+    queries_after_acme = svc.db.queries
+    globex = svc.get_invoice_summary("globex", "2024-05")
+    assert acme["total_cents"] == 12_500
+    assert globex["total_cents"] == 99_900
+    assert svc.db.queries > queries_after_acme
+
+    queries_after_globex = svc.db.queries
+    again = svc.get_invoice_summary("globex", "2024-05")
+    assert again == globex
+    assert svc.db.queries == queries_after_globex
+
+
+def test_customer_not_shared_across_tenants(svc):
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    assert svc.get_customer("globex", "c-1")["name"] == "Globex Buyer"
+
+
+def test_write_does_not_drop_other_tenant_cache(svc):
+    svc.create_invoice("acme", "inv-9", "c-1", "2024-06", 100)
+    svc.create_invoice("globex", "inv-8", "c-1", "2024-06", 700)
+    assert svc.get_invoice_summary("acme", "2024-06")["total_cents"] == 100
+    queries = svc.db.queries
+    svc.create_invoice("globex", "inv-9", "c-1", "2024-06", 50)
+    assert svc.get_invoice_summary("acme", "2024-06")["total_cents"] == 100
+    assert svc.db.queries == queries
+    assert svc.get_invoice_summary("globex", "2024-06")["total_cents"] == 750
+
+
 def test_balance_and_open_invoices(svc):
