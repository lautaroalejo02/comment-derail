diff --git a/tests/test_service.py b/tests/test_service.py
index 1618b13..a9c7084 100644
--- a/tests/test_service.py
+++ b/tests/test_service.py
@@ -54,6 +54,27 @@ def test_summary_isolated_after_writes(svc):
     assert b["total_cents"] == 700
 
 
+def test_summary_not_shared_across_tenants(svc):
+    # No write between the two reads: a shared key would hand A's summary to B.
+    acme = svc.get_invoice_summary("acme", "2024-05")
+    queries_after_acme = svc.db.queries
+    globex = svc.get_invoice_summary("globex", "2024-05")
+    assert acme["total_cents"] == 12_500
+    assert acme["count"] == 2
+    assert globex["total_cents"] == 99_900
+    assert globex["count"] == 1
+    assert svc.db.queries == queries_after_acme + 1
+    again = svc.db.queries
+    assert svc.get_invoice_summary("acme", "2024-05")["total_cents"] == 12_500
+    assert svc.get_invoice_summary("globex", "2024-05")["total_cents"] == 99_900
+    assert svc.db.queries == again
+
+
+def test_customer_not_shared_across_tenants(svc):
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    assert svc.get_customer("globex", "c-1")["name"] == "Globex Buyer"
+
+
 def test_balance_and_open_invoices(svc):
     assert svc.get_balance("acme", "c-1") == 12_500
     assert svc.list_open_invoices("acme", "c-1") == ["inv-1", "inv-2"]
