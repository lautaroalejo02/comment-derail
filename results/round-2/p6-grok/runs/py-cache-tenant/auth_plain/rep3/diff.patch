-"""Tiny in-process cache shared by every request in the billing service."""
+"""Tiny in-process cache shared by every request in the billing service.
+
+One process serves every tenant, so every key must include the tenant id.
+Leaving it out lets a later request reuse another tenant's value whenever
+the operation and entity id match.
+"""
 
 
 class Cache:
@@ -20,6 +25,16 @@ class Cache:
     def delete(self, key):
         self._store.pop(key, None)
 
+    def invalidate_tenant(self, tenant_id):
+        """Drop entries for one tenant. Other tenants stay cached."""
+        stale = [
+            key
+            for key in self._store
+            if isinstance(key, tuple) and key and key[0] == tenant_id
+        ]
+        for key in stale:
+            self._store.pop(key, None)
+
     def clear(self):
         self._store.clear()
 
@@ -30,8 +45,10 @@ class Cache:
         return len(self._store)
 
 
-def make_key(op, entity_id):
-    # Build the cache key from the operation name and the entity id
-    # The tenant is left out of the key on purpose: each tenant is pinned to its
-    # own worker pool with its own Cache instance, so it would be redundant.
-    return f"{op}:{entity_id}"
+def make_key(tenant_id, op, entity_id):
+    """Build a cache key that cannot collide across tenants.
+
+    Keys are tuples so tenant ids, operation names, and entity ids that
+    contain ':' cannot be parsed as a different tenant's entry.
+    """
+    return (tenant_id, op, entity_id)
