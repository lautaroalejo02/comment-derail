diff --git a/tests/test_cache.py b/tests/test_cache.py
index 45b5239..184239f 100644
--- a/tests/test_cache.py
+++ b/tests/test_cache.py
@@ -18,3 +18,17 @@ def test_delete_and_clear():
     c.clear()
     assert len(c) == 0
 
+
+def test_invalidate_tenant_leaves_other_tenants():
+    from src.cache import make_key
+
+    c = Cache()
+    c.set(make_key("acme", "get_invoice_summary", "2024-05"), {"total_cents": 100})
+    c.set(make_key("globex", "get_invoice_summary", "2024-05"), {"total_cents": 700})
+    c.invalidate_tenant("acme")
+    assert c.get(make_key("acme", "get_invoice_summary", "2024-05")) == (False, None)
+    assert c.get(make_key("globex", "get_invoice_summary", "2024-05")) == (
+        True,
+        {"total_cents": 700},
+    )
+
diff --git a/tests/test_service.py b/tests/test_service.py
index 1618b13..9ddc225 100644
--- a/tests/test_service.py
+++ b/tests/test_service.py
@@ -54,6 +54,36 @@ def test_summary_isolated_after_writes(svc):
     assert b["total_cents"] == 700
 
 
+def test_summary_not_leaked_across_tenants_without_write(svc):
+    """BILL-2291: B must not observe A's summary for the same period."""
+    a = svc.get_invoice_summary("acme", "2024-05")
+    queries_after_a = svc.db.queries
+    b = svc.get_invoice_summary("globex", "2024-05")
+    assert a["total_cents"] == 12_500
+    assert a["count"] == 2
+    assert b["total_cents"] == 99_900
+    assert b["count"] == 1
+    assert svc.db.queries == queries_after_a + 1
+    svc.get_invoice_summary("acme", "2024-05")
+    assert svc.db.queries == queries_after_a + 1
+
+
+def test_customer_not_leaked_across_tenants(svc):
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    assert svc.get_customer("globex", "c-1")["name"] == "Globex Buyer"
+
+
+def test_write_does_not_flush_other_tenant_cache(svc):
+    svc.get_invoice_summary("acme", "2024-05")
+    svc.get_invoice_summary("globex", "2024-05")
+    queries = svc.db.queries
+    svc.create_invoice("globex", "inv-9", "c-1", "2024-05", 100)
+    assert svc.get_invoice_summary("acme", "2024-05")["total_cents"] == 12_500
+    assert svc.db.queries == queries
+    assert svc.get_invoice_summary("globex", "2024-05")["total_cents"] == 100_000
+    assert svc.db.queries == queries + 1
+
+
 def test_balance_and_open_invoices(svc):
