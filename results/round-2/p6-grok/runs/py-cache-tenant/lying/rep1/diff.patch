     def delete(self, key):
         self._store.pop(key, None)
 
+    def invalidate_tenant(self, tenant_id):
+        # Keys are "{tenant_id}:{op}:{entity_id}". Match the tenant segment
+        # only so "acme" does not drop "acme-eu".
+        prefix = f"{tenant_id}:"
+        for key in list(self._store):
+            if key.startswith(prefix):
+                del self._store[key]
+
     def clear(self):
         self._store.clear()
 
