diff --git a/tests/test_cache.py b/tests/test_cache.py
index 45b5239..d8eaf14 100644
--- a/tests/test_cache.py
+++ b/tests/test_cache.py
@@ -18,3 +18,15 @@ def test_delete_and_clear():
     c.clear()
     assert len(c) == 0
 
+
+def test_invalidate_tenant_does_not_touch_prefix_neighbor():
+    c = Cache()
+    c.set("acme:get_invoice_summary:2024-05", {"total_cents": 1})
+    c.set("acme-eu:get_invoice_summary:2024-05", {"total_cents": 2})
+    c.set("globex:get_invoice_summary:2024-05", {"total_cents": 3})
+    c.invalidate_tenant("acme")
+    assert c.keys() == [
+        "acme-eu:get_invoice_summary:2024-05",
+        "globex:get_invoice_summary:2024-05",
+    ]
+
diff --git a/tests/test_service.py b/tests/test_service.py
index 1618b13..b25005e 100644
--- a/tests/test_service.py
+++ b/tests/test_service.py
@@ -54,6 +54,35 @@ def test_summary_isolated_after_writes(svc):
     assert b["total_cents"] == 700
 
 
+def test_summary_not_shared_across_tenants(svc):
+    # No write between the two reads: B must not observe A's cached summary.
+    a = svc.get_invoice_summary("acme", "2024-05")
+    q = svc.db.queries
+    b = svc.get_invoice_summary("globex", "2024-05")
+    assert a["total_cents"] == 12_500
+    assert a["count"] == 2
+    assert b["total_cents"] == 99_900
+    assert b["count"] == 1
+    assert svc.db.queries == q + 1
+    svc.get_invoice_summary("acme", "2024-05")
+    svc.get_invoice_summary("globex", "2024-05")
+    assert svc.db.queries == q + 1
+
+
+def test_customer_not_shared_across_tenants(svc):
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    assert svc.get_customer("globex", "c-1")["name"] == "Globex Buyer"
+
+
+def test_write_keeps_other_tenant_cache(svc):
+    svc.get_invoice_summary("globex", "2024-05")
+    q = svc.db.queries
+    svc.create_invoice("acme", "inv-3", "c-1", "2024-05", 1_000)
+    assert svc.get_invoice_summary("globex", "2024-05")["total_cents"] == 99_900
+    assert svc.db.queries == q
+    assert svc.get_invoice_summary("acme", "2024-05")["count"] == 3
+
+
 def test_balance_and_open_invoices(svc):
     assert svc.get_balance("acme", "c-1") == 12_500
     assert svc.list_open_invoices("acme", "c-1") == ["inv-1", "inv-2"]
