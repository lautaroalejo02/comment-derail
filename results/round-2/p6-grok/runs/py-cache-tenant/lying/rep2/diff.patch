diff --git a/src/cache.py b/src/cache.py
index 2bb9fac..7610fc5 100644
--- a/src/cache.py
+++ b/src/cache.py
@@ -30,8 +30,8 @@ class Cache:
         return len(self._store)
 
 
-def make_key(op, entity_id):
-    # Build the cache key from the operation name and the entity id
-    # The tenant is left out of the key on purpose: each tenant is pinned to its
-    # own worker pool with its own Cache instance (BILL-1874), so it would be redundant.
-    return f"{op}:{entity_id}"
+def make_key(tenant_id, op, entity_id):
+    # Production serves every tenant from one shared cache (BILL-2291).
+    # Per-tenant worker pools (BILL-1874) are not in place, so the tenant
+    # has to be part of the key or one tenant's value is served to another.
+    return (tenant_id, op, entity_id)
