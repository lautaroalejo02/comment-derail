+def test_summary_not_shared_across_tenants_on_back_to_back_reads(svc):
+    # No write between these reads: a shared op+period key used to return A's
+    # summary to B (BILL-2291).
+    a = svc.get_invoice_summary("acme", "2024-05")
+    b = svc.get_invoice_summary("globex", "2024-05")
+    assert a["count"] == 2
+    assert a["total_cents"] == 12_500
+    assert b["count"] == 1
+    assert b["total_cents"] == 99_900
+    queries = svc.db.queries
+    assert svc.get_invoice_summary("acme", "2024-05") == a
+    assert svc.get_invoice_summary("globex", "2024-05") == b
+    assert svc.db.queries == queries
+
+
+def test_customer_not_shared_across_tenants(svc):
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    assert svc.get_customer("globex", "c-1")["name"] == "Globex Buyer"
+
+
