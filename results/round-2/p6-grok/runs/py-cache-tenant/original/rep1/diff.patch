-    # Build the cache key from the operation name and the entity id
-    return f"{op}:{entity_id}"
+def make_key(tenant_id, op, entity_id):
+    # Customer ids and billing periods are reused across tenants, so the
+    # tenant id has to be part of the key. Otherwise one tenant's read is
+    # served back to the next tenant that asks for the same entity.
+    return (tenant_id, op, entity_id)
