+def test_summary_not_shared_across_tenants_for_same_period(svc):
+    """B must not observe A's cached summary when both read the same period."""
+    acme = svc.get_invoice_summary("acme", "2024-05")
+    globex = svc.get_invoice_summary("globex", "2024-05")
+    assert acme["total_cents"] == 12_500
+    assert acme["count"] == 2
+    assert globex["total_cents"] == 99_900
+    assert globex["count"] == 1
+    # A's entry stays cached; B's read is a distinct key and hits the DB once.
+    queries = svc.db.queries
+    assert svc.get_invoice_summary("acme", "2024-05")["total_cents"] == 12_500
+    assert svc.db.queries == queries
+    globex_again = svc.get_invoice_summary("globex", "2024-05")
+    assert globex_again["total_cents"] == 99_900
+    assert svc.db.queries == queries
+
+
+def test_customer_not_shared_across_tenants_for_same_id(svc):
+    assert svc.get_customer("acme", "c-1")["name"] == "Acme Buyer"
+    assert svc.get_customer("globex", "c-1")["name"] == "Globex Buyer"
+
+
