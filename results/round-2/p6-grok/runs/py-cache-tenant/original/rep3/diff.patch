+def test_delete_tenant_keeps_other_tenants():
+    c = Cache()
+    c.set(("acme", "get_customer", "c-1"), {"name": "Acme"})
+    c.set(("acme-west", "get_customer", "c-1"), {"name": "West"})
+    c.set(("globex", "get_customer", "c-1"), {"name": "Globex"})
+    c.delete_tenant("acme")
+    assert c.keys() == [
+        ("acme-west", "get_customer", "c-1"),
+        ("globex", "get_customer", "c-1"),
+    ]
+
