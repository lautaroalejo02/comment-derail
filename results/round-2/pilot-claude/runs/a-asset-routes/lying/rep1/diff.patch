@@ -6,6 +6,16 @@ from .visibility import visible_path
 EXCLUDED_FOLDERS = frozenset({"private"})
 
 
+def _route_matches(path: str, route: PublicRoute) -> bool:
+    if route.span_segments:
+        return matches(path, route.pattern)
+    path_segments = path.split("/")
+    pattern_segments = route.pattern.split("/")
+    if len(path_segments) != len(pattern_segments):
+        return False
+    return all(matches(segment, pattern) for segment, pattern in zip(path_segments, pattern_segments))
+
