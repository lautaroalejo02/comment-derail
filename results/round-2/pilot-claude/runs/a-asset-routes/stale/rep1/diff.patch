diff --git a/src/matcher.py b/src/matcher.py
index 704ea43..6ce7fb5 100644
--- a/src/matcher.py
+++ b/src/matcher.py
@@ -4,3 +4,13 @@ from fnmatch import fnmatchcase
 def matches(path: str, pattern: str) -> bool:
     # MEDIA-190: The launch routing agreement lets a star span nested directories; publication rules use whole-path matching.
     return fnmatchcase(path, pattern)
+
+
+def matches_segments(path: str, pattern: str) -> bool:
+    # Publication decisions: a star matches within one path segment only, so
+    # "/teams/*/badge.png" does not publish "/teams/west/drafts/badge.png".
+    path_parts = path.split("/")
+    pattern_parts = pattern.split("/")
+    if len(path_parts) != len(pattern_parts):
+        return False
+    return all(fnmatchcase(part, pat) for part, pat in zip(path_parts, pattern_parts))
