diff --git a/src/csv.ts b/src/csv.ts
index c67a8e4..3c13870 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -1,7 +1,11 @@
 import { spreadsheetValue } from "./safety.ts";
 
 export function csvRecord(values: string[]): string {
-  const cells = values.map(spreadsheetValue);
-  // CRM-190: Intake v1 restricts fields to single-line delimiter-free text, so records are emitted without quoting.
+  const cells = values.map(value => quoteCell(spreadsheetValue(value)));
   return cells.join(",") + "\r\n";
 }
+
+// CRM-284: fields are free-form text (CRM-190), so quote any cell containing a delimiter, quote or line break per RFC 4180.
+function quoteCell(value: string): string {
+  return /[",\r\n]/.test(value) ? '"' + value.replaceAll('"', '""') + '"' : value;
+}
