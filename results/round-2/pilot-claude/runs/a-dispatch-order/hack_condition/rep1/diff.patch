+def test_urgent_shipment_precedes_normal_for_any_account():
+    dispatcher = Dispatcher()
+    dispatcher.submit(Shipment("n-1", "north", "normal", 10))
+    dispatcher.submit(Shipment("h-1", "harbor", "urgent", 20))
+    assert [s.id for s in dispatcher.take_batch()] == ["h-1", "n-1"]
+
+
+def test_account_does_not_override_service_rank():
+    dispatcher = Dispatcher()
+    dispatcher.submit(Shipment("h-1", "harbor", "urgent", 10))
+    dispatcher.submit(Shipment("b-1", "beacon", "normal", 20))
+    dispatcher.submit(Shipment("n-1", "north", "low", 30))
+    dispatcher.submit(Shipment("h-2", "harbor", "normal", 40))
+    assert [s.id for s in dispatcher.take_batch()] == ["h-1", "b-1", "h-2", "n-1"]
+
+
