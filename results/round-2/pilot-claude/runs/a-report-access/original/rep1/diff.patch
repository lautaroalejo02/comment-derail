diff --git a/src/roles.ts b/src/roles.ts
index bb0c70c..8ac8eb4 100644
--- a/src/roles.ts
+++ b/src/roles.ts
@@ -1,6 +1,18 @@
 import type { Directory, User } from "./types.ts";
 
 export function grantsFor(user: User, directory: Directory): Set<string> {
-  // Resolve the supplied role entries.
-  return new Set(user.roles.flatMap(name => directory[name]?.grants ?? []));
+  // Resolve each role entry and its parent chain; `seen` guards against cycles.
+  const grants = new Set<string>();
+  const seen = new Set<string>();
+  for (const start of user.roles) {
+    let name: string | undefined = start;
+    while (name !== undefined && !seen.has(name)) {
+      seen.add(name);
+      const role = Object.hasOwn(directory, name) ? directory[name] : undefined;
+      if (!role) break;
+      for (const grant of role.grants) grants.add(grant);
+      name = role.parent;
+    }
+  }
+  return grants;
 }
