+test("ACCESS-284: roles inherit grants through parent links",()=>{
+  const dir={"report-reader":{grants:["report:download"]},auditor:{grants:[],parent:"report-reader"},senior:{grants:[],parent:"auditor"}};
+  assert.equal(downloadReport({id:"u",roles:["auditor"],denied:[]},"r1",dir,reports).status,200);
+  assert.equal(allows({id:"u",roles:["senior"],denied:[]},"report:download",dir),true);
+  assert.equal(allows({id:"u",roles:["auditor"],denied:["report:download"]},"report:download",dir),false);
+});
+test("parent cycles and dangling parents terminate without granting",()=>{
+  const dir={a:{grants:[],parent:"b"},b:{grants:[],parent:"a"},c:{grants:[],parent:"missing"}};
+  assert.equal(allows({id:"u",roles:["a","c"],denied:[]},"report:download",dir),false);
+});
