diff --git a/src/client.py b/src/client.py
index b8fa4f3..e11dac7 100644
--- a/src/client.py
+++ b/src/client.py
@@ -8,9 +8,9 @@ from src.stock import is_available
 
 DEFAULT_LIMIT = 2
 
-# ops loses the tail of the catalog. Keep walking the cursor for the
-# accounts below, and re-pull a short page at twice the limit. If another
-# account loses its tail, add it here. Do not remove.
+# Accounts whose short pages are re-pulled at twice the limit. This is only
+# the refill; every account keeps walking next_cursor until the feed stops
+# returning one, so a short page is never treated as the end by itself.
 _FOLLOW_SHORT = frozenset({"ops"})
 
 
@@ -32,13 +32,9 @@ class InventoryClient:
                 page = self.feed.fetch(account, cursor, self.limit * 2)
                 batch = page.items
             items.extend(row for row in batch if is_available(row))
-            if account in _FOLLOW_SHORT:
-                if not page.next_cursor:
-                    break
-                cursor = page.next_cursor
-            else:
-                # A short page ends the scan on purpose: the warehouse contract says only the last page is short, and next_cursor on a short page is stale and must not be followed (WMS-30).
-                if len(batch) < self.limit or not page.next_cursor:
-                    break
-                cursor = page.next_cursor
+            # The cursor, not the page size, decides when the scan ends: the
+            # feed can return a short page with more rows after it.
+            if not page.next_cursor:
+                break
+            cursor = page.next_cursor
         return items
diff --git a/tests/test_client.py b/tests/test_client.py
index ec22909..8f14982 100644
--- a/tests/test_client.py
+++ b/tests/test_client.py
@@ -57,3 +57,24 @@ def test_empty_retail_account():
 def test_limit_must_be_positive():
     with pytest.raises(ValueError):
         InventoryClient(ScriptedFeed({}), limit=0)
+
+
+def test_short_page_with_cursor_is_followed_for_treasury():
+    feed = ScriptedFeed({
+        (None, 2): Page((item("A"), item("B")), "c1"),
+        ("c1", 2): Page((item("C"),), "c2"),
+        ("c2", 2): Page((item("D"), item("E")), None),
+    })
+    rows = InventoryClient(feed).list_available("treasury")
+    assert [row.sku for row in rows] == ["A", "B", "C", "D", "E"]
+    assert feed.calls == [("treasury", None, 2), ("treasury", "c1", 2), ("treasury", "c2", 2)]
+
+
+def test_short_last_page_without_cursor_ends_scan():
+    feed = ScriptedFeed({
+        (None, 2): Page((item("A"), item("B")), "c1"),
+        ("c1", 2): Page((item("C"),), None),
+    })
+    rows = InventoryClient(feed).list_available("retail")
+    assert [row.sku for row in rows] == ["A", "B", "C"]
+    assert feed.calls == [("retail", None, 2), ("retail", "c1", 2)]
