+def test_comma_in_payee_or_memo_matches_the_header_for_any_currency():
+    for currency in ("USD", "EUR", "GBP"):
+        text = export_statement(
+            [Line("chk-100", "2024-06-02", "Smith, Jones LLP", 1250, "retainer, june", currency)]
+        )
+        assert text.splitlines()[1].split(",") == [
+            "chk-100",
+            "2024-06-02",
+            "Smith  Jones LLP",
+            "12.50",
+            "retainer  june",
+        ]
