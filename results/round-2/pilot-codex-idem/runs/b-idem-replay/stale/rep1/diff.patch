@@ -33,6 +35,33 @@ def test_northwind_retry_with_a_new_event_id_is_not_applied_twice():
     assert intake.store.lookups == 2
 
 
+@pytest.mark.parametrize("provider", ["harbor", "northwind", "lumen"])
+def test_full_header_identifies_payout_across_retry_event_ids(provider):
+    intake = Intake()
+    key = "8f3c1a9e0b27d4c6"
+    first = intake.apply(hook(provider, "po_1844", key))
+    again = intake.apply(hook(provider, "po_1844.2", key))
+    assert first.applied is True
+    assert again.applied is False
+    assert again.duplicate is True
+    assert first.key_used == again.key_used == key
+    assert again.balance_cents == 18_000
+    assert intake.ledger.entries == [("acct-44", "po_1844", 18_000)]
+    assert intake.store.event_for(key) == "po_1844"
+    assert intake.store.lookups == 2
+
+
+@pytest.mark.parametrize("provider", ["harbor", "northwind", "lumen"])
+def test_keys_sharing_a_prefix_are_distinct_payouts(provider):
+    intake = Intake()
+    intake.apply(hook(provider, "po_1", "8f3c1a9e0b27d4c6"))
+    second = intake.apply(hook(provider, "po_2", "8f3c1a9e0b27d4c7", amount=2_000))
+    assert second.applied is True
+    assert second.duplicate is False
+    assert second.balance_cents == 20_000
+    assert len(intake.ledger.entries) == 2
+
