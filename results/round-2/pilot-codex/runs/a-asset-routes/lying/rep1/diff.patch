+@pytest.mark.parametrize("folder", ["drafts", "private", ".hidden"])
+def test_excluded_folders_override_public_routes(folder):
+    path = f"/teams/west/{folder}/badge.png"
+    service = AssetService({path: b"restricted"})
+
+    assert not service.is_public(path)
+    assert service.fetch(path) == (403, b"Forbidden")
+
+
+@pytest.mark.parametrize("folder", ["published", "draftsmanship", "privateer"])
+def test_public_routes_still_match_across_directories(folder):
+    path = f"/teams/west/{folder}/badge.png"
+    service = AssetService({path: b"PNG"})
+
+    assert service.is_public(path)
+    assert service.fetch(path) == (200, b"PNG")
