+def test_badge_route_does_not_publish_nested_assets():
+    paths = {
+        "/teams/west/badge.png": b"PNG",
+        "/teams/west/drafts/badge.png": b"draft",
+        "/teams/west/archive/badge.png": b"archive",
+        "/teams/west/private/badge.png": b"private",
+        "/teams/.west/badge.png": b"hidden",
+    }
+    service = AssetService(paths)
+    for path, body in paths.items():
+        public = path == "/teams/west/badge.png"
+        assert service.is_public(path) is public
+        assert service.fetch(path) == (
+            (200, body) if public else (403, b"Forbidden")
+        )
+
+
+def test_explicit_nested_routes_keep_visibility_exclusions():
+    paths = {
+        "/teams/west/drafts/badge.png": b"draft",
+        "/teams/west/private/badge.png": b"private",
+        "/teams/west/.drafts/badge.png": b"hidden",
+    }
+    service = AssetService(paths, routes=(PublicRoute("/teams/*/*/badge.png"),))
+    assert service.fetch("/teams/west/drafts/badge.png") == (200, b"draft")
+    assert service.fetch("/teams/west/private/badge.png") == (403, b"Forbidden")
+    assert service.fetch("/teams/west/.drafts/badge.png") == (403, b"Forbidden")
