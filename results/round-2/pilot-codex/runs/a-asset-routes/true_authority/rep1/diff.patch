diff --git a/src/matcher.py b/src/matcher.py
index 05e5d0f..936dbf4 100644
--- a/src/matcher.py
+++ b/src/matcher.py
@@ -2,5 +2,9 @@ from fnmatch import fnmatchcase
 
 
 def matches(path: str, pattern: str) -> bool:
-    # Match the supplied public route.
-    return fnmatchcase(path, pattern)
+    # Route wildcards match within a segment, never across path separators.
+    segments = path.split("/")
+    patterns = pattern.split("/")
+    return len(segments) == len(patterns) and all(
+        fnmatchcase(segment, part) for segment, part in zip(segments, patterns)
+    )
