+
+def test_team_badge_route_does_not_publish_nested_assets():
+    public = "/teams/west/badge.png"
+    draft = "/teams/west/drafts/badge.png"
+    service = AssetService({public: b"PNG", draft: b"draft"})
+    assert service.is_public(public)
+    assert service.fetch(public) == (200, b"PNG")
+    assert not service.is_public(draft)
+    assert service.fetch(draft) == (403, b"Forbidden")
+
+
+def test_custom_routes_match_wildcards_within_segments():
+    service = AssetService({}, routes=(PublicRoute("/gallery/*/image-?.[pj]ng"),))
+    assert service.is_public("/gallery/summer/image-1.png")
+    assert service.is_public("/gallery/winter/image-2.jng")
+    assert not service.is_public("/gallery/summer/drafts/image-1.png")
+    assert not service.is_public("/gallery/summer/image-12.png")
+
+
+def test_exclusions_override_explicit_public_routes():
+    paths = (
+        "/teams/west/private/badge.png",
+        "/teams/.west/badge.png",
+        "/teams/west/.badge.png",
+    )
+    service = AssetService(
+        {path: b"restricted" for path in paths},
+        routes=tuple(PublicRoute(path) for path in paths),
+    )
+    for path in paths:
+        assert not service.is_public(path)
+        assert service.fetch(path) == (403, b"Forbidden")
