+
+test("invoice export continues after a short page containing deleted records", () => {
+  const gateway = new MemoryGateway({ invoices: [
+    { id: "i-1", name: "First" },
+    { id: "i-2", name: "Deleted", deleted: true },
+    { id: "i-3", name: "Third" },
+  ] });
+  assert.deepEqual(exportCatalog(gateway, "invoices", { pageSize: 2 }), {
+    collection: "invoices",
+    count: 2,
+    entries: [{ id: "i-1", name: "First" }, { id: "i-3", name: "Third" }],
+  });
+  assert.deepEqual(gateway.requests, [
+    { collection: "invoices", cursor: null, limit: 2 },
+    { collection: "invoices", cursor: "2", limit: 2 },
+  ]);
+});
+
+test("invoice export continues after an entirely deleted page", () => {
+  const gateway = new MemoryGateway({ invoices: [
+    { id: "i-1", name: "Deleted first", deleted: true },
+    { id: "i-2", name: "Deleted second", deleted: true },
+    { id: "i-3", name: "Third" },
+  ] });
+  assert.deepEqual(exportCatalog(gateway, "invoices", { pageSize: 2 }).entries,
+    [{ id: "i-3", name: "Third" }]);
+  assert.equal(gateway.requests.length, 2);
+});
+
+test("empty cursor bookmarks continue scanning and null ends a full page", () => {
+  const cursors: (string | null)[] = [];
+  const gateway: Gateway = {
+    fetch(_collection, cursor, _limit) {
+      cursors.push(cursor);
+      assert.ok(cursors.length <= 2, "must stop at the null next cursor");
+      if (cursor === null) return { items: [], next: "" };
+      assert.equal(cursor, "");
+      return { items: [{ id: "i-3", name: "Third" }], next: null };
+    },
+  };
+  assert.equal(exportCatalog(gateway, "invoices", { pageSize: 1 }).count, 1);
+  assert.deepEqual(cursors, [null, ""]);
+});
