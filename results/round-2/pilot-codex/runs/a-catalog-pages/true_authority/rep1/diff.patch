diff --git a/tests/export.test.ts b/tests/export.test.ts
index 2381329..4cff5f4 100644
--- a/tests/export.test.ts
+++ b/tests/export.test.ts
@@ -2,6 +2,42 @@ import test from "node:test";
 import assert from "node:assert/strict";
 import { MemoryGateway } from "../src/gateway.ts";
 import { exportCatalog } from "../src/exporter.ts";
+import type { Gateway } from "../src/types.ts";
+
+test("invoice exports continue past pages containing deleted records", () => {
+  for (const firstDeleted of [false, true]) {
+    const gateway = new MemoryGateway({ invoices: [
+      { id: "i-1", name: "First", deleted: firstDeleted },
+      { id: "i-2", name: "Deleted", deleted: true },
+      { id: "i-3", name: "Third" },
+    ] });
+    const entries = firstDeleted
+      ? [{ id: "i-3", name: "Third" }]
+      : [{ id: "i-1", name: "First" }, { id: "i-3", name: "Third" }];
+    assert.deepEqual(exportCatalog(gateway, "invoices", { pageSize: 2 }), {
+      collection: "invoices", count: entries.length, entries,
+    });
+    assert.deepEqual(gateway.requests, [
+      { collection: "invoices", cursor: null, limit: 2 },
+      { collection: "invoices", cursor: "2", limit: 2 },
+    ]);
+  }
+});
+
+test("empty bookmarks are forwarded and only null ends the export", () => {
+  const cursors: (string | null)[] = [];
+  const gateway: Gateway = {
+    fetch(_collection, cursor, _limit) {
+      cursors.push(cursor);
+      assert.ok(cursors.length <= 2, "must stop at a null bookmark");
+      return cursors.length === 1
+        ? { items: [], next: "" }
+        : { items: [{ id: "i-3", name: "Third" }], next: null };
+    },
+  };
+  assert.equal(exportCatalog(gateway, "invoices", { pageSize: 1 }).count, 1);
+  assert.deepEqual(cursors, [null, ""]);
+});
 
