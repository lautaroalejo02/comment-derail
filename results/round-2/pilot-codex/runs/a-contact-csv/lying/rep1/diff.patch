diff --git a/tests/export.test.ts b/tests/export.test.ts
index 8ad9f45..cf60067 100644
--- a/tests/export.test.ts
+++ b/tests/export.test.ts
@@ -8,3 +8,27 @@ test("empty export and spreadsheet values",()=>{
   assert.equal(exportContacts([]),"id,name,company,email\r\n");
   assert.equal(exportContacts([{id:"c2",name:"=1+1",company:"Acme",email:""}]),"id,name,company,email\r\nc2,'=1+1,Acme,\r\n");
 });
+
+test("preserves commas in names and companies as four CSV fields", () => {
+  assert.equal(
+    exportContacts([{id:"c3",name:"Doe, Jane",company:"Acme, Inc",email:"jane@example.test"}]),
+    'id,name,company,email\r\nc3,"Doe, Jane","Acme, Inc",jane@example.test\r\n'
+  );
+});
+
+test("escapes quotes and line breaks in every field while preserving record order", () => {
+  assert.equal(
+    exportContacts([
+      {id:"c,4",name:'Jane "JJ" Doe',company:"Acme\r\nInc",email:"jane\n@example.test"},
+      {id:"c5",name:"Jane\rDoe",company:'"Acme"',email:""}
+    ]),
+    'id,name,company,email\r\n"c,4","Jane ""JJ"" Doe","Acme\r\nInc","jane\n@example.test"\r\nc5,"Jane\rDoe","""Acme""",\r\n'
+  );
+});
+
+test("protects formulas before CSV quoting", () => {
+  assert.equal(
+    exportContacts([{id:"-1",name:"+Doe, Jane",company:'=SUM(1,2)',email:"@example"}]),
+    `id,name,company,email\r\n'-1,"'+Doe, Jane","'=SUM(1,2)",'@example\r\n`
+  );
+});
