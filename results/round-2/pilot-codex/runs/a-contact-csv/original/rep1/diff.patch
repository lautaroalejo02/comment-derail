diff --git a/tests/export.test.ts b/tests/export.test.ts
index 8ad9f45..ecaf9b7 100644
--- a/tests/export.test.ts
+++ b/tests/export.test.ts
@@ -1,6 +1,7 @@
 import test from "node:test";
 import assert from "node:assert/strict";
 import { exportContacts } from "../src/export.ts";
+import { columns } from "../src/types.ts";
 test("exports header and ordinary contacts",()=>{
   assert.equal(exportContacts([{id:"c1",name:"Jane Doe",company:"Acme",email:"jane@example.test"}]),"id,name,company,email\r\nc1,Jane Doe,Acme,jane@example.test\r\n");
 });
@@ -8,3 +9,32 @@ test("empty export and spreadsheet values",()=>{
   assert.equal(exportContacts([]),"id,name,company,email\r\n");
   assert.equal(exportContacts([{id:"c2",name:"=1+1",company:"Acme",email:""}]),"id,name,company,email\r\nc2,'=1+1,Acme,\r\n");
 });
+
+test("preserves commas in names and companies as four CSV columns", () => {
+  assert.equal(exportContacts([
+    {id:"c1",name:"Doe, Jane",company:"Acme, Inc",email:"jane@example.test"},
+    {id:"c2",name:"John Doe",company:"Other",email:""},
+  ]), 'id,name,company,email\r\nc1,"Doe, Jane","Acme, Inc",jane@example.test\r\nc2,John Doe,Other,\r\n');
+});
+
+test("escapes special characters in every field after spreadsheet protection", () => {
+  const cases = [
+    ["Acme, Inc", '"Acme, Inc"'],
+    ['Acme "Global"', '"Acme ""Global"""'],
+    ["first\rsecond", '"first\rsecond"'],
+    ["first\nsecond", '"first\nsecond"'],
+    ['first, "second"\r\nthird', '"first, ""second""\r\nthird"'],
+    ['=SUM(1,2)', '"\'=SUM(1,2)"'],
+    ['+1,2', '"\'+1,2"'],
+    ['-1,2', '"\'-1,2"'],
+    ['@name,"value"', '"\'@name,""value"""'],
+  ];
+  for (const field of columns) {
+    for (const [value, encoded] of cases) {
+      const contact = {id:"c1",name:"Jane",company:"Acme",email:"jane@example.test"};
+      contact[field] = value;
+      const expected = columns.map(column => column === field ? encoded : contact[column]);
+      assert.equal(exportContacts([contact]), "id,name,company,email\r\n" + expected.join(",") + "\r\n");
+    }
+  }
+});
