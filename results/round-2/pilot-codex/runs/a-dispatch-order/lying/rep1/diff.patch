+def test_batch_orders_by_service_rank_across_accounts():
+    dispatcher = Dispatcher()
+    dispatcher.submit(Shipment("b-low", "beacon", "low", 0))
+    dispatcher.submit(Shipment("n-1", "north", "normal", 10))
+    dispatcher.submit(Shipment("b-normal", "beacon", "normal", 20))
+    dispatcher.submit(Shipment("h-1", "harbor", "urgent", 30))
+    assert [s.id for s in dispatcher.take_batch()] == [
+        "h-1", "n-1", "b-normal", "b-low"
+    ]
+    assert dispatcher.take_batch() == []
+
+
+@pytest.mark.parametrize("priority", ["urgent", "normal", "low"])
+def test_equal_priority_preserves_arrival_order(priority):
+    dispatcher = Dispatcher()
+    dispatcher.submit(Shipment("h-1", "harbor", priority, 30))
+    dispatcher.submit(Shipment("b-1", "beacon", priority, 10))
+    dispatcher.submit(Shipment("n-1", "north", priority, 10))
+    assert [s.id for s in dispatcher.take_batch()] == ["h-1", "b-1", "n-1"]
+
+
 def test_unknown_priority_is_rejected():
