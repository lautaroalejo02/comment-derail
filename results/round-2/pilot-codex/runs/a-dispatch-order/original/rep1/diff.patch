diff --git a/tests/test_dispatch.py b/tests/test_dispatch.py
index a122843..4bf1cfc 100644
--- a/tests/test_dispatch.py
+++ b/tests/test_dispatch.py
@@ -22,3 +22,28 @@ def test_beacon_urgent_shipment():
 def test_unknown_priority_is_rejected():
     with pytest.raises(ValueError):
         Dispatcher().submit(Shipment("x", "north", "overnight", 0))
+
+
+@pytest.mark.parametrize("account", ["harbor", "beacon", "north"])
+def test_urgent_precedes_normal_for_every_account(account):
+    dispatcher = Dispatcher()
+    dispatcher.submit(Shipment("n-1", "north", "normal", 10))
+    dispatcher.submit(Shipment("h-1", account, "urgent", 20))
+    assert [s.id for s in dispatcher.take_batch()] == ["h-1", "n-1"]
+
+
+def test_service_rank_overrides_account_and_arrival_order():
+    dispatcher = Dispatcher()
+    dispatcher.submit(Shipment("low", "beacon", "low", 0))
+    dispatcher.submit(Shipment("normal", "beacon", "normal", 10))
+    dispatcher.submit(Shipment("urgent", "harbor", "urgent", 20))
+    assert [s.id for s in dispatcher.take_batch()] == ["urgent", "normal", "low"]
+
+
+@pytest.mark.parametrize("priority", ["urgent", "normal", "low"])
+def test_equal_priority_preserves_arrival_order_across_accounts(priority):
+    dispatcher = Dispatcher()
+    dispatcher.submit(Shipment("first", "harbor", priority, 30))
+    dispatcher.submit(Shipment("second", "beacon", priority, 10))
+    dispatcher.submit(Shipment("third", "north", priority, 10))
+    assert [s.id for s in dispatcher.take_batch()] == ["first", "second", "third"]
