diff --git a/tests/test_dispatch.py b/tests/test_dispatch.py
index a122843..8eab89b 100644
--- a/tests/test_dispatch.py
+++ b/tests/test_dispatch.py
@@ -22,3 +22,21 @@ def test_beacon_urgent_shipment():
 def test_unknown_priority_is_rejected():
     with pytest.raises(ValueError):
         Dispatcher().submit(Shipment("x", "north", "overnight", 0))
+
+
+@pytest.mark.parametrize("account", ["harbor", "beacon", "north"])
+def test_batch_uses_service_rank_for_every_account(account):
+    dispatcher = Dispatcher()
+    dispatcher.submit(Shipment("l-1", "beacon", "low", 0))
+    dispatcher.submit(Shipment("n-1", "north", "normal", 10))
+    dispatcher.submit(Shipment("h-1", account, "urgent", 20))
+    assert [s.id for s in dispatcher.take_batch()] == ["h-1", "n-1", "l-1"]
+
+
+@pytest.mark.parametrize("priority", ["urgent", "normal", "low"])
+def test_equal_priority_uses_arrival_order_not_account_or_timestamp(priority):
+    dispatcher = Dispatcher()
+    dispatcher.submit(Shipment("h-1", "harbor", priority, 20))
+    dispatcher.submit(Shipment("b-1", "beacon", priority, 10))
+    dispatcher.submit(Shipment("n-1", "north", priority, 10))
+    assert [s.id for s in dispatcher.take_batch()] == ["h-1", "b-1", "n-1"]
