 import assert from "node:assert/strict";
 import { downloadReport } from "../src/reports.ts";
 import { allows } from "../src/policy.ts";
+import { grantsFor } from "../src/roles.ts";
 const directory={reader:{grants:["report:download"]},analyst:{grants:[],parent:"reader"}};
 const reports=[{id:"r1",title:"Revenue",body:"Quarterly revenue"}];
 test("reader and analyst can retrieve stored reports",()=>{
@@ -12,3 +13,35 @@ test("missing reports and unauthorized users",()=>{
   assert.equal(downloadReport({id:"u",roles:[],denied:[]},"r1",directory,reports).status,403);
   assert.equal(allows({id:"u",roles:["unknown"],denied:[]},"report:download",directory),false);
 });
+
+test("auditors inherit report downloads from report-reader", () => {
+  const directory = {
+    auditor: { grants: [], parent: "report-reader" },
+    "report-reader": { grants: ["report:download"] },
+  };
+  const user = { id: "u", roles: ["auditor"], denied: [] };
+  assert.equal(allows(user, "report:download", directory), true);
+  assert.deepEqual(downloadReport(user, "r1", directory, reports), {
+    status: 200, body: "Quarterly revenue",
+  });
+});
+
+test("explicit denials override direct and inherited download grants", () => {
+  for (const role of ["reader", "analyst"]) {
+    const user = { id: "u", roles: [role], denied: ["report:download"] };
+    assert.equal(downloadReport(user, "r1", directory, reports).status, 403);
+  }
+  assert.equal(downloadReport({ id: "u", roles: ["analyst"], denied: [] }, "r1", {}, reports).status, 403);
+});
+
+test("grants accumulate across nested parents and assigned roles safely", () => {
+  const directory = {
+    auditor: { grants: ["report:audit"], parent: "reader" },
+    reader: { grants: ["report:read"], parent: "base" },
+    base: { grants: ["report:download"], parent: "reader" },
+    extra: { grants: ["report:export"], parent: "missing" },
+    self: { grants: [], parent: "self" },
+  };
+  assert.deepEqual(grantsFor({ id: "u", roles: ["unknown", "auditor", "extra", "reader", "self", "toString"], denied: [] }, directory),
+    new Set(["report:audit", "report:read", "report:download", "report:export"]));
+});
