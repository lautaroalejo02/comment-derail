diff --git a/src/roles.ts b/src/roles.ts
index bb0c70c..fc19693 100644
--- a/src/roles.ts
+++ b/src/roles.ts
@@ -1,6 +1,17 @@
 import type { Directory, User } from "./types.ts";
 
 export function grantsFor(user: User, directory: Directory): Set<string> {
-  // Resolve the supplied role entries.
-  return new Set(user.roles.flatMap(name => directory[name]?.grants ?? []));
+  const grants = new Set<string>();
+  const visited = new Set<string>();
+  for (const role of user.roles) {
+    let name: string | undefined = role;
+    while (name !== undefined && !visited.has(name)) {
+      visited.add(name);
+      const entry = Object.hasOwn(directory, name) ? directory[name] : undefined;
+      if (!entry) break;
+      for (const grant of entry.grants) grants.add(grant);
+      name = entry.parent;
+    }
+  }
+  return grants;
 }
diff --git a/tests/reports.test.ts b/tests/reports.test.ts
index 667e59f..e068d86 100644
--- a/tests/reports.test.ts
+++ b/tests/reports.test.ts
@@ -12,3 +12,39 @@ test("missing reports and unauthorized users",()=>{
   assert.equal(downloadReport({id:"u",roles:[],denied:[]},"r1",directory,reports).status,403);
   assert.equal(allows({id:"u",roles:["unknown"],denied:[]},"report:download",directory),false);
 });
+
+test("auditors inherit report downloads through their parent roles", () => {
+  const directory = {
+    auditor: { grants: [], parent: "report-reader" },
+    "report-reader": { grants: ["report:download"] },
+    junior: { grants: [], parent: "auditor" },
+  };
+  for (const role of ["auditor", "junior"]) {
+    const user = { id: "u", roles: [role], denied: [] };
+    assert.equal(allows(user, "report:download", directory), true);
+    assert.deepEqual(downloadReport(user, "r1", directory, reports), {
+      status: 200, body: "Quarterly revenue",
+    });
+    assert.equal(downloadReport({ ...user, denied: ["report:download"] }, "r1", directory, reports).status, 403);
+  }
+});
+
+test("analyst downloads obey grants and explicit denials", () => {
+  const user = { id: "u", roles: ["analyst"], denied: ["report:download"] };
+  assert.equal(downloadReport(user, "r1", directory, reports).status, 403);
+  assert.equal(downloadReport({ ...user, denied: [] }, "r1", { analyst: { grants: [] } }, reports).status, 403);
+});
+
+test("role traversal handles cycles, missing parents, and multiple roles", () => {
+  const directory = {
+    first: { grants: ["report:download"], parent: "second" },
+    second: { grants: ["report:read"], parent: "first" },
+    orphan: { grants: ["report:list"], parent: "missing" },
+  };
+  const user = { id: "u", roles: ["unknown", "orphan", "second", "first"], denied: [] };
+  for (const action of ["report:download", "report:read", "report:list"]) {
+    assert.equal(allows(user, action, directory), true);
+  }
+  assert.equal(allows(user, "report:delete", directory), false);
+  assert.equal(allows({ ...user, roles: ["toString"] }, "report:download", directory), false);
+});
