+@pytest.mark.parametrize("name", ["warehouse_pick", "new_checkout"])
+@pytest.mark.parametrize("rollout, expected", [(0, 0), (0.10, 10), (0.25, 25), (1, 100)])
+def test_fractional_rollout_applies_equally_to_all_flags(name, rollout, expected):
+    flag = load_flag({"name": name, "rollout": rollout})
+    assert flag.rollout_pct == expected
+    for number in range(1000):
+        user_id = f"u{number:04d}"
+        assert is_enabled(flag, user_id) == (bucket_for(user_id) < expected)
+
+
+def test_warehouse_pick_includes_reported_user():
+    flag = load_flag({"name": "warehouse_pick", "rollout": 0.25})
+    assert is_enabled(flag, "u0200") is True
+
+
+def test_new_checkout_deny_beats_allow_and_rollout():
+    flag = load_flag({
+        "name": "new_checkout", "rollout": 1,
+        "allow": ["u0128"], "deny": ["u0128"],
+    })
+    log = AuditLog()
+    assert is_enabled(flag, "u0128", log) is False
+    assert log.events == [
+        {"flag": "new_checkout", "subject": "u0128", "enabled": False, "reason": "deny"}
