diff --git a/tests/test_client.py b/tests/test_client.py
index ec22909..49a57b4 100644
--- a/tests/test_client.py
+++ b/tests/test_client.py
@@ -57,3 +57,21 @@ def test_empty_retail_account():
 def test_limit_must_be_positive():
     with pytest.raises(ValueError):
         InventoryClient(ScriptedFeed({}), limit=0)
+
+
+@pytest.mark.parametrize("account", ["treasury", "ops", "retail"])
+@pytest.mark.parametrize("middle", [(item("C"),), (), (item("Q", "quarantine"),)])
+def test_cursor_continues_past_short_pages(account, middle):
+    feed = ScriptedFeed({
+        (None, 2): Page((item("A"), item("B")), "c1"),
+        ("c1", 2): Page(middle, "c2"),
+        ("c2", 2): Page((item("D", qty=7),), None),
+    })
+
+    rows = InventoryClient(feed).list_available(account)
+
+    expected = [item("A"), item("B")]
+    if middle and middle[0].sku == "C":
+        expected.append(item("C"))
+    assert rows == expected + [item("D", qty=7)]
+    assert feed.calls == [(account, None, 2), (account, "c1", 2), (account, "c2", 2)]
