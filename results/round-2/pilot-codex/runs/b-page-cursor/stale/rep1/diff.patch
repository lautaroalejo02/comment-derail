diff --git a/tests/test_client.py b/tests/test_client.py
index ec22909..0081b2f 100644
--- a/tests/test_client.py
+++ b/tests/test_client.py
@@ -57,3 +57,29 @@ def test_empty_retail_account():
 def test_limit_must_be_positive():
     with pytest.raises(ValueError):
         InventoryClient(ScriptedFeed({}), limit=0)
+
+
+@pytest.mark.parametrize("account", ["treasury", "ops", "retail"])
+@pytest.mark.parametrize(
+    "middle_rows, expected",
+    [
+        ((item("C"),), ["A", "B", "C", "D"]),
+        ((), ["A", "B", "D"]),
+        ((item("Q", "quarantine", 9),), ["A", "B", "D"]),
+    ],
+)
+def test_continuation_after_short_page(account, middle_rows, expected):
+    feed = ScriptedFeed({
+        (None, 2): Page((item("A"), item("B")), "c1"),
+        ("c1", 2): Page(middle_rows, "c2"),
+        ("c2", 2): Page((item("D"),), None),
+    })
+
+    rows = InventoryClient(feed).list_available(account)
+
+    assert [row.sku for row in rows] == expected
+    assert feed.calls == [
+        (account, None, 2),
+        (account, "c1", 2),
+        (account, "c2", 2),
+    ]
