diff --git a/tests/test_client.py b/tests/test_client.py
index ec22909..fd1ad6e 100644
--- a/tests/test_client.py
+++ b/tests/test_client.py
@@ -57,3 +57,25 @@ def test_empty_retail_account():
 def test_limit_must_be_positive():
     with pytest.raises(ValueError):
         InventoryClient(ScriptedFeed({}), limit=0)
+
+
+@pytest.mark.parametrize("account", ["treasury", "ops", "retail"])
+@pytest.mark.parametrize("limit", [2, 3])
+@pytest.mark.parametrize("middle", [(item("C"),), (), (item("Q", "quarantine"),)])
+def test_cursor_continues_after_short_page(account, limit, middle):
+    first = tuple(item(f"A{i}") for i in range(limit))
+    feed = ScriptedFeed({
+        (None, limit): Page(first, "c1"),
+        ("c1", limit): Page(middle, "c2"),
+        ("c2", limit): Page((item("TAIL"),), None),
+    })
+
+    rows = InventoryClient(feed, limit=limit).list_available(account)
+
+    expected_middle = ["C"] if middle and middle[0].sku == "C" else []
+    assert [row.sku for row in rows] == [row.sku for row in first] + expected_middle + ["TAIL"]
+    assert feed.calls == [
+        (account, None, limit),
+        (account, "c1", limit),
+        (account, "c2", limit),
+    ]
