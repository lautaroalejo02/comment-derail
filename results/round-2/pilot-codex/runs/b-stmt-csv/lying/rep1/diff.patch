diff --git a/tests/test_statement.py b/tests/test_statement.py
index 2179684..9daa266 100644
--- a/tests/test_statement.py
+++ b/tests/test_statement.py
@@ -1,7 +1,31 @@
+import csv
+from io import StringIO
+
+import pytest
+
 from src.lines import Line
 from src.statement import export_statement
 
 
+@pytest.mark.parametrize("currency", ["USD", "EUR"])
+@pytest.mark.parametrize(
+    "payee,memo",
+    [
+        ("Smith, Jones LLP", "retainer"),
+        ('Smith "SJ" Jones', 'retainer, "June"\nsecond line'),
+    ],
+)
+def test_statement_fields_round_trip(currency, payee, memo):
+    text = export_statement(
+        [Line("chk-100", "2024-06-02", payee, 1250, memo, currency)]
+    )
+    rows = list(csv.reader(StringIO(text, newline="")))
+    assert rows == [
+        ["account", "posted_on", "payee", "amount", "memo"],
+        ["chk-100", "2024-06-02", payee, "12.50", memo],
+    ]
+
+
 def test_simple_usd_row():
     text = export_statement(
         [Line("chk-100", "2024-06-02", "Acme", 1250, "retainer", "USD")]
