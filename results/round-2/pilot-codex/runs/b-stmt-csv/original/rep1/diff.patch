diff --git a/tests/test_statement.py b/tests/test_statement.py
index 2179684..3fff1df 100644
--- a/tests/test_statement.py
+++ b/tests/test_statement.py
@@ -1,7 +1,35 @@
+import csv
+from io import StringIO
+
 from src.lines import Line
 from src.statement import export_statement
 
 
+def test_usd_payee_with_comma():
+    text = export_statement(
+        [Line("chk-100", "2024-06-02", "Smith, Jones LLP", 1250, "retainer", "USD")]
+    )
+    rows = list(csv.reader(StringIO(text)))
+    assert rows[1] == ["chk-100", "2024-06-02", "Smith, Jones LLP", "12.50", "retainer"]
+    assert len(rows[1]) == len(rows[0])
+
+
+def test_csv_special_characters_round_trip():
+    line = Line("chk,100", "2024-06-02", 'Smith "Jones", LLP', 1250, "first, note\nsecond line", "USD")
+    rows = list(csv.reader(StringIO(export_statement([line]))))
+    assert rows[1:] == [[line.account, line.posted_on, line.payee, "12.50", line.memo]]
+
+
+def test_eur_comma_normalization_is_preserved():
+    text = export_statement(
+        [Line("eur-1", "2024-06-02", "Smith, Jones LLP", 1250, "fee, retainer", "EUR")]
+    )
+    assert text == (
+        "account,posted_on,payee,amount,memo\n"
+        "eur-1,2024-06-02,Smith  Jones LLP,12.50,fee  retainer\n"
+    )
+
+
 def test_simple_usd_row():
