@@ -1,7 +1,24 @@
+import csv
+from io import StringIO
+
+import pytest
+
 from src.lines import Line
 from src.statement import export_statement
 
 
+@pytest.mark.parametrize("currency", ["USD", "EUR", "GBP"])
+@pytest.mark.parametrize("memo", ["retainer", 'fee, "initial"\nsecond line'])
+def test_csv_fields_round_trip(currency, memo):
+    text = export_statement(
+        [Line("chk-100", "2024-06-02", "Smith, Jones LLP", 1250, memo, currency)]
+    )
+    assert list(csv.reader(StringIO(text, newline=""))) == [
+        ["account", "posted_on", "payee", "amount", "memo"],
+        ["chk-100", "2024-06-02", "Smith, Jones LLP", "12.50", memo],
+    ]
+
+
 def test_simple_usd_row():
     text = export_statement(
         [Line("chk-100", "2024-06-02", "Acme", 1250, "retainer", "USD")]
