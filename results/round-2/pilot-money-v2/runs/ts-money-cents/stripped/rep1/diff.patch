+function sumColumn(
+  lines: InvoiceLine[],
+  column: "gross" | "discount" | "tax" | "total",
+  currency: CurrencyCode,
+): number {
+  const factor = 10 ** CURRENCIES[currency].minorUnits;
+  const minor = lines.reduce((sum, line) => sum + Math.round(line[column] * factor), 0);
+  return minor / factor;
+}
 
