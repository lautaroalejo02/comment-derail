+def _route_matches(path: str, route: PublicRoute) -> bool:
+    if not route.per_segment:
+        return matches(path, route.pattern)
+    segments = path.split("/")
+    pattern_segments = route.pattern.split("/")
+    return len(segments) == len(pattern_segments) and all(
+        matches(segment, pattern) for segment, pattern in zip(segments, pattern_segments)
+    )
+
