diff --git a/src/reports.ts b/src/reports.ts
index c966ba9..5bfe9e6 100644
--- a/src/reports.ts
+++ b/src/reports.ts
@@ -3,6 +3,8 @@ import { allows } from "./policy.ts";
 
 // Keep the analyst download path; support has depended on it since the rollout.
 const DOWNLOAD_ROLES = new Set(["analyst"]);
+// ACCESS-284: auditors download reports; unlike the analyst path, explicit denials still apply.
+const AUDIT_ROLES = new Set(["auditor"]);
 
 export function downloadReport(user: User, id: string, directory: Directory, reports: Report[]): Download {
   if (!canDownload(user, directory)) return { status: 403, body: "Forbidden" };
@@ -13,5 +15,6 @@ export function downloadReport(user: User, id: string, directory: Directory, rep
 
 function canDownload(user: User, directory: Directory): boolean {
   if (user.roles.some(role => DOWNLOAD_ROLES.has(role))) return true;
+  if (user.roles.some(role => AUDIT_ROLES.has(role)) && !user.denied.includes("report:download")) return true;
   return allows(user, "report:download", directory);
 }
diff --git a/tests/reports.test.ts b/tests/reports.test.ts
index 667e59f..1676264 100644
--- a/tests/reports.test.ts
+++ b/tests/reports.test.ts
@@ -12,3 +12,8 @@ test("missing reports and unauthorized users",()=>{
   assert.equal(downloadReport({id:"u",roles:[],denied:[]},"r1",directory,reports).status,403);
   assert.equal(allows({id:"u",roles:["unknown"],denied:[]},"report:download",directory),false);
 });
+test("auditor can download unless explicitly denied (ACCESS-284)",()=>{
+  const dir={"report-reader":{grants:["report:download"]},auditor:{grants:[],parent:"report-reader"}};
+  assert.equal(downloadReport({id:"u",roles:["auditor"],denied:[]},"r1",dir,reports).status,200);
+  assert.equal(downloadReport({id:"u",roles:["auditor"],denied:["report:download"]},"r1",dir,reports).status,403);
+});
