diff --git a/src/intake.py b/src/intake.py
index 3ac04f8..2f3a56d 100644
--- a/src/intake.py
+++ b/src/intake.py
@@ -12,11 +12,18 @@ from src.store import ReplayStore
 HEADER_KEY_PROVIDERS = frozenset({"northwind"})
 _KEY_PREFIX = 8
 
+# Providers that resend the same Idempotency-Key with a new event id on retry.
+# The full key is used: truncating would merge distinct payouts whose keys
+# share a prefix and silently drop the later credits.
+FULL_KEY_PROVIDERS = frozenset({"harbor"})
+
 
 def storage_key(hook: Webhook) -> str:
     # Choose the idempotency identity for this delivery
     if hook.provider in HEADER_KEY_PROVIDERS and hook.idempotency_key:
         return hook.idempotency_key[:_KEY_PREFIX]
+    if hook.provider in FULL_KEY_PROVIDERS and hook.idempotency_key:
+        return hook.idempotency_key
     return hook.event_id
 
 
diff --git a/tests/test_intake.py b/tests/test_intake.py
index b6e7ffe..5172046 100644
--- a/tests/test_intake.py
+++ b/tests/test_intake.py
@@ -66,3 +66,23 @@ def test_sandbox_delivery_does_not_move_the_balance():
     assert decision.duplicate is False
     assert intake.ledger.balance("acct-44") == 0
     assert intake.ledger.entries == [("acct-44", "po_s", 0)]
+
+
+def test_harbor_retry_with_a_new_event_id_is_not_applied_twice():
+    intake = Intake()
+    first = intake.apply(hook("harbor", "po_1844", "8f3c1a9e0b27d4c6"))
+    again = intake.apply(hook("harbor", "po_1844.2", "8f3c1a9e0b27d4c6"))
+    assert first.applied is True
+    assert again.applied is False
+    assert again.duplicate is True
+    assert again.balance_cents == 18_000
+    assert intake.ledger.balance("acct-44") == 18_000
+    assert len(intake.ledger.entries) == 1
+
+
+def test_distinct_harbor_keys_sharing_a_prefix_both_settle():
+    intake = Intake()
+    intake.apply(hook("harbor", "po_1", "8f3c1a9e0b27d4c6", amount=18_000))
+    intake.apply(hook("harbor", "po_2", "8f3c1a9e77777777", amount=2_000))
+    assert intake.ledger.balance("acct-44") == 20_000
+    assert len(intake.ledger.entries) == 2
