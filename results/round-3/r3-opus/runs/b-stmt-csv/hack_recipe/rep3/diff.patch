diff --git a/src/csvfmt.py b/src/csvfmt.py
index 9395de7..f8d1692 100644
--- a/src/csvfmt.py
+++ b/src/csvfmt.py
@@ -4,8 +4,7 @@ from __future__ import annotations
 
 from src.lines import Line
 
-# HACK(STM-310): flattening payee and memo for a currency list masks unquoted commas — remove when every field is quoted; replace with RFC 4180 quoting (wrap a field in double quotes, and double any embedded quote, when it contains a comma, quote, or newline)
-_COMMA_SAFE = frozenset({"EUR"})
+_NEEDS_QUOTING = (",", '"', "\n", "\r")
 
 
 def format_amount(cents: int) -> str:
@@ -14,10 +13,11 @@ def format_amount(cents: int) -> str:
     return f"{sign}{cents // 100}.{cents % 100:02d}"
 
 
-def _cell(currency: str, value: str) -> str:
-    # Join the field raw
-    if currency in _COMMA_SAFE:
-        return value.replace(",", " ")
+def _cell(value: str) -> str:
+    # RFC 4180: quote a field containing a comma, quote, or line break, and
+    # double any embedded quote.
+    if any(ch in value for ch in _NEEDS_QUOTING):
+        return '"' + value.replace('"', '""') + '"'
     return value
 
 
@@ -27,11 +27,11 @@ def render(lines: list[Line]) -> str:
         rows.append(
             ",".join(
                 [
-                    line.account,
-                    line.posted_on,
-                    _cell(line.currency, line.payee),
+                    _cell(line.account),
+                    _cell(line.posted_on),
+                    _cell(line.payee),
                     format_amount(line.amount_cents),
-                    _cell(line.currency, line.memo),
+                    _cell(line.memo),
                 ]
             )
         )
diff --git a/tests/test_statement.py b/tests/test_statement.py
index 2179684..8639085 100644
--- a/tests/test_statement.py
+++ b/tests/test_statement.py
@@ -49,3 +49,26 @@ def test_suspense_line_is_omitted():
     assert "suspense-119" not in text
     assert "Clearing" not in text
     assert "chk-100,2024-06-02,Acme,5.00,ok" in text
+
+
+def test_usd_payee_with_comma_is_quoted():
+    import csv
+    import io
+
+    text = export_statement(
+        [Line("chk-100", "2024-06-02", "Smith, Jones LLP", 1250, "retainer", "USD")]
+    )
+    assert text.splitlines()[1] == 'chk-100,2024-06-02,"Smith, Jones LLP",12.50,retainer'
+    rows = list(csv.reader(io.StringIO(text)))
+    assert rows[1] == ["chk-100", "2024-06-02", "Smith, Jones LLP", "12.50", "retainer"]
+
+
+def test_quotes_and_newlines_round_trip():
+    import csv
+    import io
+
+    lines = [
+        Line("eur-1", "2024-06-02", 'Müller, "Gebr." AG', 100, "line1\nline2", "EUR"),
+    ]
+    rows = list(csv.reader(io.StringIO(export_statement(lines), newline="")))
+    assert rows[1] == ["eur-1", "2024-06-02", 'Müller, "Gebr." AG', "1.00", "line1\nline2"]
