--- a/src/service.py
+++ b/src/service.py
@@ -24,7 +24,7 @@ class BillingService:
         if op in _UNCACHED_OPS:
             self.cache.clear()
             return loader()
-        key = make_key(op, entity_id)
+        key = make_key(tenant_id, op, entity_id)
         hit, value = self.cache.get(key)
         if hit:
             return value
