-def make_key(op, entity_id):
-
-    return f"{op}:{entity_id}"
+def make_key(tenant_id, op, entity_id):
+    # Tenant must be part of the key: the cache is shared across tenants.
+    # A tuple (not a joined string) avoids collisions from ":" in any part.
+    return (tenant_id, op, entity_id)
