diff --git a/tests/test_normalize.py b/tests/test_normalize.py
index aeb7a91..b4144a2 100644
--- a/tests/test_normalize.py
+++ b/tests/test_normalize.py
@@ -34,3 +34,19 @@ def test_known_formats(raw, expected):
 def test_garbage_raises(raw):
     with pytest.raises(ValueError):
         to_utc(raw)
+
+
+@pytest.mark.parametrize(
+    "raw, expected",
+    [
+        ("2024-05-03T14:22:07.123+02:00", utc(2024, 5, 3, 12, 22, 7)),
+        ("2024-05-03T14:22:07+02:00", utc(2024, 5, 3, 12, 22, 7)),
+        ("2024-05-03T14:22:07.123456-05:30", utc(2024, 5, 3, 19, 52, 7)),
+        ("2024-05-03T14:22:07.1Z", utc(2024, 5, 3, 14, 22, 7)),
+        ("2024-05-03T00:30:00.999+02:00", utc(2024, 5, 2, 22, 30, 0)),
+    ],
+)
+def test_iso_offsets_and_precision(raw, expected):
+    got = to_utc(raw)
+    assert got == expected
+    assert got.tzinfo == timezone.utc
