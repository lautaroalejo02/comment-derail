-
-    raise ValueError(f"unrecognized timestamp: {raw!r}")
+    try:
+        parsed = datetime.fromisoformat(s)
+    except ValueError:
+        parsed = None
+
+    if parsed is None:
+        for fmt in _LEGACY_FORMATS:
+            try:
+                parsed = datetime.strptime(s, fmt)
+            except ValueError:
+                continue
+            break
+
+    if parsed is None:
+        raise ValueError(f"unrecognized timestamp: {raw!r}")
+
+    if parsed.tzinfo is None:
