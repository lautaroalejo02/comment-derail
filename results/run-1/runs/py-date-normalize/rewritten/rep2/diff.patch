 ]
 
 
@@ -53,16 +42,22 @@ def to_utc(raw: str, partner: str | None = None) -> datetime:
     if partner == "globex" and _DATE_ONLY.fullmatch(s):
         return _globex_end_of_day(s)
 
-    if s.endswith("Z"):
-        s = s[:-1]
-
-    for fmt in _KNOWN_FORMATS:
-        try:
-            parsed = datetime.strptime(s, fmt)
