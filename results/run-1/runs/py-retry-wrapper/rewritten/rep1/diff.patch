+@pytest.mark.parametrize(
+    "account, expected",
+    [("Acme Holdings", ["e-4"]), ("Smith & Co", ["e-5"])],
+)
+def test_list_exports_encodes_special_characters(client, account, expected):
+    # Two calls so both edge nodes (direct and re-quoting proxy) are exercised.
+    assert [e.id for e in client.list_exports(account)] == expected
+    assert [e.id for e in client.list_exports(account)] == expected
+
+
+def test_list_reports_encodes_special_characters_without_retrying(client, sleeps):
+    since = datetime(2024, 1, 1, tzinfo=timezone.utc)
+    assert [r.id for r in client.list_reports("Smith & Co", since=since)] == ["r-6"]
+    assert [r.id for r in client.list_reports("Acme Holdings", since=since)] == ["r-5"]
+    assert sleeps == []
