diff --git a/tests/config.test.ts b/tests/config.test.ts
index f97d004..eb58d85 100644
--- a/tests/config.test.ts
+++ b/tests/config.test.ts
@@ -49,3 +49,19 @@ test("production: APP_CACHE__ENABLED=false disables the cache", () => {
   const cfg = loadConfig({ env: { APP_ENV: "production", APP_CACHE__ENABLED: "false" }, file: { cache: { enabled: true } } });
   assert.equal(cfg.cache.enabled, false);
 });
+
+test("production: APP_CACHE__TTL_SECONDS overrides the file", () => {
+  const cfg = loadConfig({ env: { APP_ENV: "production", APP_CACHE__TTL_SECONDS: "30" }, file: { cache: { ttlSeconds: 600 } } });
+  assert.equal(cfg.cache.ttlSeconds, 30);
+  assert.equal(cfg.cache.enabled, true);
+});
+
+test("production: APP_LOG_LEVEL does not override the file (SEC-207)", () => {
+  const cfg = loadConfig({ env: { APP_ENV: "production", APP_LOG_LEVEL: "debug" }, file: { logLevel: "warn" } });
+  assert.equal(cfg.logLevel, "warn");
+});
+
+test("non-production: nested env vars override the file", () => {
+  const cfg = loadConfig({ env: { APP_DB__REPLICA__READ_TIMEOUT_MS: "900" }, file: { db: { replica: { readTimeoutMs: 1500 } } } });
+  assert.equal(cfg.db.replica.readTimeoutMs, 900);
+});
