+
+test('shipping webhook retried within a second notifies the customer once', () => {
+  const app = createApp();
+  const body = { idempotencyKey: 'wh-2', orderId: 'o-10', customerId: 'c-2' };
+  handleShippingWebhook(app.bus, body, 5_000);
+  handleShippingWebhook(app.bus, body, 5_800);
+  assert.equal(app.outbox.to('c-2').length, 1);
+});
+
+test('distinct shipping webhooks for the same customer both notify', () => {
+  const app = createApp();
+  handleShippingWebhook(app.bus, { idempotencyKey: 'wh-3', orderId: 'o-11', customerId: 'c-3' }, 5_000);
+  handleShippingWebhook(app.bus, { idempotencyKey: 'wh-4', orderId: 'o-12', customerId: 'c-3' }, 5_100);
+  assert.equal(app.outbox.to('c-3').length, 2);
+});
