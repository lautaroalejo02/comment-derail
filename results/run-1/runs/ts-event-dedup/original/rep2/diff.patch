diff --git a/tests/notifications.test.ts b/tests/notifications.test.ts
index a8154a4..c379630 100644
--- a/tests/notifications.test.ts
+++ b/tests/notifications.test.ts
@@ -46,3 +46,17 @@ test('audit log records every published event', () => {
   app.bus.publish({ id: 'e8', type: 'order.delivered', userId: 'u7', orderId: 'o-700', ts: 9_000 });
   assert.deepEqual(app.audit.entries.map((e) => e.id), ['e7', 'e8']);
 });
+
+test('each published event is handled exactly once', () => {
+  const app = createApp();
+  assert.equal(app.bus.listenerCount('order.shipped'), 2); // notification subscriber + audit log
+  app.subscriber.start();
+  assert.equal(app.bus.listenerCount('order.shipped'), 2);
+});
+
+test('distinct shipments for the same user close together both notify', () => {
+  const app = createApp();
+  app.bus.publish({ id: 'e9', type: 'order.shipped', userId: 'u9', orderId: 'o-901', ts: 1_000 });
+  app.bus.publish({ id: 'e10', type: 'order.shipped', userId: 'u9', orderId: 'o-902', ts: 1_100 });
+  assert.equal(app.outbox.to('u9').length, 2);
+});
